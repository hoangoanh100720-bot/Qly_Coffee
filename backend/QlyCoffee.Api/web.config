<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
   web.config — BACKEND API trên IIS
  =============================================================================
   File này là BẢN GỐC. Lúc `dotnet publish`, SDK đọc nó rồi chèn thêm thẻ
   <aspNetCore> với đúng tên dll và chế độ chạy — bạn sẽ thấy phần đó xuất hiện
   trong bản publish chứ không có ở đây. Đừng tự thêm thẻ <aspNetCore> vào đây,
   SDK sẽ ghi đè.

   ⚠️ YÊU CẦU TRÊN MÁY CHỦ: .NET 8 Hosting Bundle.
   Đây KHÔNG phải .NET Runtime thông thường. Hosting Bundle cài thêm module
   AspNetCoreModuleV2 cho IIS — thứ thực sự nối IIS với ứng dụng .NET. Thiếu nó
   thì IIS báo lỗi 500.19 hoặc 500.21 và không có cách nào chạy được.
   Tải tại: dotnet.microsoft.com/download/dotnet/8.0 (mục "Hosting Bundle")
  =============================================================================
-->
<configuration>
  <system.webServer>

    <!-- ======================================================================
         CHẶN TẢI FILE CẤU HÌNH
         ======================================================================
         Ứng dụng đọc toàn bộ cấu hình từ .env đặt cạnh file dll: chuỗi kết nối
         database, JWT_SECRET, khóa API của Anthropic.

         Bình thường IIS không phục vụ file ở thư mục gốc ứng dụng — chỉ wwwroot
         mới công khai — nên .env đã an toàn sẵn. Nhưng "bình thường" phụ thuộc
         vào cấu hình site, mà cấu hình thì người khác sẽ sửa sau bạn. Hai khối
         dưới biến chuyện đó thành một quy tắc rõ ràng, không phụ thuộc may rủi.

         Lộ JWT_SECRET là người ngoài tự ký được token với vai trò Owner. Không
         cần phá mật khẩu ai cả, và log cũng không ghi nhận gì bất thường.
         ====================================================================== -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <!-- Nhật ký của Serilog. Chứa nội dung request, có thể lẫn dữ liệu
               khách và thông tin nội bộ. -->
          <add segment="logs" />
        </hiddenSegments>
        <!-- Ảnh món tải lên tối đa 30MB. Mặc định của IIS là 30.000.000 byte
             (khoảng 28.6MB) và khi vượt thì IIS chặn TRƯỚC khi request tới
             ứng dụng — người dùng nhận lỗi 404.13 khó hiểu thay vì thông báo
             tử tế do backend sinh ra. -->
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- API không phải trang để xem, không có lý do bị nhúng vào khung. -->
        <add name="X-Frame-Options" value="DENY" />
        <!-- Ảnh món tải lên nằm ở /uploads. Không có gì ở đây đáng lên Google,
             và đường dẫn file nội bộ thì càng không. -->
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <!-- Gỡ thẻ quảng cáo phiên bản IIS — bớt một thông tin cho người dò. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
