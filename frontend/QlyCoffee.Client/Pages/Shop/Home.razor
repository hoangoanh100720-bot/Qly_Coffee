@*
    =============================================================================
    TRANG CHỦ
    =============================================================================
    Archetype: TRANG THƯƠNG MẠI (theo phân loại trong design-system.css).
    Nghĩa là: chữ lớn được phép và được khuyến khích, nhịp dọc rộng, ảnh chiếm
    diện tích lớn, và MỖI MÀN HÌNH CHỈ CÓ MỘT lời kêu gọi hành động nổi bật nhất.

    THỨ TỰ CÁC KHỐI — sắp theo hành trình của khách, không phải theo ý thích:

      1. HERO             ảnh thật + câu chốt + hai nút. Trả lời "quán này bán gì".
      2. DẢI DANH MỤC     ảnh tròn cuộn ngang. Trả lời "có những nhóm món nào".
      3. BANNER KHUYẾN MÃI do AI đề xuất xả hàng cận hạn — đặt ngay sau dải
                          danh mục vì đây là chỗ mắt dừng lần thứ hai.
      4. MÓN NỔI BẬT      lưới sản phẩm. Trả lời "gọi gì bây giờ".
      5. CAM KẾT          ba lý do tin quán, mỗi lý do một ẢNH CHỤP THẬT.
      6. KHÔNG GIAN QUÁN  ảnh quán + địa chỉ. Trả lời "ngồi lại được không".
      7. DẢI CHỐT         nhắc lại nút đặt món cho người đã cuộn hết trang.

    TOÀN BỘ ẢNH LÀ ẢNH CHỤP THẬT, không còn hình vẽ vector. Đường dẫn ảnh nằm
    tập trung trong Services/DrinkPhoto.cs — đổi ảnh chỉ sửa một chỗ.
    =============================================================================
*@
@page "/"
@layout ShopLayout
@inject ApiClient Api

@* SEO: trang chủ là trang quan trọng nhất, mô tả phải chứa đúng cụm từ khách gõ *@
<SeoHead Path="/"
         Description="Cà phê pha phin, trà trái cây tươi và đá xay tại TP.HCM. Đặt món online, biết trước món còn hay hết, tới lấy là có. Mở cửa 07:00 – 22:00 mỗi ngày."
         Image="@DrinkPhoto.OgCover"
         ImageAlt="Ly cà phê sữa đá pha phin của Qly Coffee" />

@* ═══ 1. HERO ══════════════════════════════════════════════════════════════
     Hai cột: chữ bên trái, LƯỚI BA ẢNH THẲNG HÀNG bên phải.
     Lưới ảnh cố tình không xoay, không chồng lớp — xem lý do trong pages.css §1
     ở khối .hero-photos.                                                       *@
<section class="hero-band">
    <div class="container hero">

        <div class="hero-text">

            @* Chip trạng thái: chấm nhấp nháy + giờ mở cửa.
               Chấm có aria-hidden vì thông tin đã nằm trong chữ bên cạnh. *@
            <span class="pill-live">
                <span class="pulse-dot" aria-hidden="true"></span>
                Mở cửa 07:00 – 22:00 mỗi ngày
            </span>

            @*  h1 là tiêu đề DUY NHẤT cấp 1 của trang — quy tắc SEO cơ bản.
                Cụm "cực đã" tô gradient để mắt bám vào, phần còn lại giữ màu
                chữ gốc nên tương phản không bị hy sinh vì trang trí.            *@
            <h1 class="hero-title">
                Cà phê pha phin,<br />
                trà trái cây <span class="text-grad">cực đã</span>.
            </h1>

            <p class="lead hero-lead">
                Mỗi ly làm theo công thức định lượng chuẩn — đong bằng cân,
                không ước lượng bằng mắt. Đặt trước, tới lấy là có.
            </p>

            @* Hai nút: một chính (gradient), một phụ (viền). Không bao giờ để
               hai nút cùng nổi như nhau — khách sẽ không biết bấm cái nào. *@
            <div class="row row-3 row-wrap hero-actions">
                <a href="/menu" class="btn btn-hot btn-lg">Xem thực đơn</a>
                <a href="/tra-cuu-don" class="btn btn-secondary btn-lg">Tra cứu đơn</a>
            </div>

            @* Ba con số tạo lòng tin. Dùng .num để chữ số thẳng hàng. *@
            <dl class="hero-stats">
                <div>
                    <dt>Món trong thực đơn</dt>
                    <dd class="num">@(_totalProducts > 0 ? $"{_totalProducts}+" : "40+")</dd>
                </div>
                <div>
                    <dt>Phút chuẩn bị</dt>
                    <dd class="num">5–8</dd>
                </div>
                <div>
                    <dt>Giờ mở cửa</dt>
                    <dd class="num">15h/ngày</dd>
                </div>
            </dl>
        </div>

        @*  MỘT ẢNH DUY NHẤT.

            Bản trước đặt ba ảnh ở đây (lúc đầu xếp nghiêng chồng lớp, sau đó là
            lưới mosaic). Cả hai đều làm hero cao lên và chia sự chú ý ra ba chỗ.
            Hero chỉ có một việc: nói quán bán gì và mời bấm "Xem thực đơn".
            Một ảnh làm việc đó tốt hơn ba ảnh — hai ảnh kia đã xuất hiện ở dải
            danh mục và lưới món ngay bên dưới, để lại đây là thừa.

            fetchpriority="high" vì đây là phần tử LCP — chỉ số Google dùng để
            chấm tốc độ hiển thị. Không đặt loading="lazy": ảnh nằm ngay trong
            màn hình đầu tiên, hoãn tải nó chỉ làm trang chậm hơn.              *@
        <figure class="hero-photo">
            <img src="@DrinkPhoto.HeroCaPhe"
                 alt="Ly cà phê sữa đá pha phin tại Qly Coffee"
                 fetchpriority="high" decoding="async"
                 width="900" height="675" />
        </figure>
    </div>
</section>

<div class="container">

    @* ═══ 2. DẢI DANH MỤC ═══════════════════════════════════════════════════
         Ảnh tròn cuộn ngang — mượn đúng cách trình bày của Instagram Stories,
         thứ nhóm khách trẻ đã quen thao tác mà không cần hướng dẫn.
         Chỉ hiện khi API đã trả về danh mục; lúc đang tải thì bỏ qua khối này
         thay vì dựng khung xương, vì nó không phải nội dung chính của trang.  *@
    @if (_categories.Count > 0)
    {
        <nav class="cat-rail" aria-label="Nhóm món">
            @foreach (var c in _categories)
            {
                <a href="/menu/danh-muc/@c.Slug" class="cat-item" style="--cat: @c.ColorHex">
                    <img src="@DrinkPhoto.FallbackFor(c.Name, null)"
                         alt="Nhóm món @c.Name" loading="lazy" decoding="async"
                         width="600" height="600" />
                    <span class="cat-name">@c.Name</span>
                    <span class="cat-count">@c.ProductCount món</span>
                </a>
            }
        </nav>
    }

    @* ═══ 3. BANNER KHUYẾN MÃI DO AI ĐỀ XUẤT ════════════════════════════════
         Đây là đích đến cuối cùng của tính năng xả hàng cận hạn: đưa món cần
         đẩy ra trước mắt khách. Chỉ lấy tối đa 2 banner — nhiều hơn thì mất
         cảm giác "ưu đãi hiếm" và đẩy lưới món xuống quá sâu.                 *@
    @if (_promoProducts.Count > 0)
    {
        <section class="promo-stack" aria-label="Đang giảm giá">
            @foreach (var p in _promoProducts.Take(2))
            {
                <div class="promo-banner" style="--drink: @p.ColorPrimaryHex">
                    <img class="promo-photo"
                         src="@DrinkPhoto.PhotoFor(p.ImageUrl, p.CategoryName, p.Name)"
                         alt="@DrinkPhoto.AltFor(p.ImageUrl, p.Name)"
                         loading="lazy" decoding="async" width="176" height="176" />

                    <div class="stack stack-1 grow">
                        <span class="badge badge-solid">Giảm @p.DiscountPercent%</span>
                        <span class="promo-name">@p.Name</span>
                        <span class="small">
                            <span class="price-sale">@Money.Format(p.EffectivePrice)</span>
                            <span class="price-old">@Money.Format(p.BasePrice)</span>
                        </span>
                    </div>

                    <a href="/menu/@p.Slug" class="btn btn-primary">Đặt ngay</a>
                </div>
            }
        </section>
    }

    @* ═══ 4. MÓN NỔI BẬT ════════════════════════════════════════════════════ *@
    <section class="section" id="mon-noi-bat">
        <div class="row row-between section-head">
            <div class="stack stack-2">
                <span class="label">Khách gọi nhiều nhất</span>
                <h2>Món <span class="text-mark">bán chạy</span> tuần này</h2>
            </div>
            <a href="/menu" class="btn btn-ghost">
                Xem tất cả <ArrowIcon Size="14" />
            </a>
        </div>

        @if (_loading)
        {
            @* Khung xương thay vì vòng xoay: hình dạng kết quả đã biết trước,
               nên giữ đúng chỗ để trang không nhảy khi dữ liệu về. *@
            <div class="grid grid-cards" aria-busy="true" aria-label="Đang tải món">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="skeleton skeleton-card"></div>
                }
            </div>
        }
        else if (_featured.Count == 0)
        {
            @* Trạng thái rỗng — xảy ra khi quán chưa nhập món, hoặc API lỗi. *@
            <div class="card" style="text-align: center; align-items: center;">
                <p class="lead">Thực đơn đang được cập nhật.</p>
                <a href="/tra-cuu-don" class="btn btn-secondary">Tra cứu đơn đã đặt</a>
            </div>
        }
        else
        {
            <div class="grid grid-cards">
                @foreach (var p in _featured)
                {
                    <ProductCard Product="p" @key="p.Id" />
                }
            </div>
        }
    </section>

    @* ═══ 5. CAM KẾT ════════════════════════════════════════════════════════
         Ba lý do tin quán. Bản trước dùng biểu tượng nét mảnh; giờ mỗi thẻ có
         một ẢNH CHỤP THẬT ở trên — ảnh nói được điều mà icon không nói nổi:
         quán này pha thủ công, hạt rang thật, và có người ngồi lại uống.      *@
    <section class="section">
        <div class="stack stack-2 section-head">
            <span class="label">Vì sao chọn Qly</span>
            <h2>Không phải ly nào cũng giống nhau</h2>
        </div>

        <div class="grid grid-3">
            <article class="feature-card">
                <img src="@DrinkPhoto.PhaChe" alt="Nhân viên pha cà phê thủ công bằng phễu lọc"
                     loading="lazy" decoding="async" width="800" height="600" />
                <div class="feature-body">
                    <h3 class="card-title">Định lượng chuẩn</h3>
                    <p class="text-2">
                        Mỗi món có công thức cân đong cụ thể tới từng gram.
                        Ly hôm nay giống hệt ly hôm qua.
                    </p>
                </div>
            </article>

            <article class="feature-card">
                <img src="@DrinkPhoto.HatCaPhe" alt="Hạt cà phê rang mộc còn nguyên hạt"
                     loading="lazy" decoding="async" width="800" height="400" />
                <div class="feature-body">
                    <h3 class="card-title">Nguyên liệu tươi</h3>
                    <p class="text-2">
                        Hệ thống theo dõi hạn dùng từng lô hàng.
                        Nguyên liệu quá hạn không thể xuất ra quầy.
                    </p>
                </div>
            </article>

            <article class="feature-card">
                <img src="@DrinkPhoto.BanBe" alt="Nhóm bạn cụng ly cà phê tại quán"
                     loading="lazy" decoding="async" width="800" height="600" />
                <div class="feature-body">
                    <h3 class="card-title">Biết trước còn hay hết</h3>
                    <p class="text-2">
                        Thực đơn chỉ hiện món còn làm được — không để bạn đặt
                        rồi mới báo hết.
                    </p>
                </div>
            </article>
        </div>
    </section>

    @* ═══ 6. KHÔNG GIAN QUÁN ════════════════════════════════════════════════
         Bố cục hai cột: ảnh và chữ. Trên điện thoại ảnh xuống dưới chữ (xem
         media query trong pages.css) — vì trên màn hẹp, chữ đọc trước có ích
         hơn là phải cuộn qua một tấm ảnh cao mới tới nội dung.                *@
    <section class="section split-section">
        <figure class="split-photo">
            <img src="@DrinkPhoto.KhongGian"
                 alt="Không gian quán Qly Coffee với bàn gỗ và nhiều cây xanh"
                 loading="lazy" decoding="async" width="1000" height="700" />
        </figure>

        <div class="stack stack-5 split-text">
            <span class="label">Ghé quán</span>
            <h2>Chỗ ngồi mát, wifi khỏe, ổ cắm khắp bàn</h2>
            <p class="lead">
                Không gian đủ yên để học bài, đủ thoáng để tụ tập.
                Đặt trước trên web rồi tới lấy, khỏi phải xếp hàng.
            </p>

            <ul class="tick-list">
                <li>Mở cửa <span class="num">07:00 – 22:00</span> tất cả các ngày</li>
                <li>123 Nguyễn Huệ, Bến Nghé, Quận 1, TP.HCM</li>
                <li>Nhận đặt món online, chuẩn bị trong <span class="num">5–8</span> phút</li>
            </ul>

            <div class="row row-3 row-wrap">
                <a href="/menu" class="btn btn-primary">Đặt món ngay</a>
                <a href="tel:0901234567" class="btn btn-secondary">Gọi 0901 234 567</a>
            </div>
        </div>
    </section>
</div>

@* ═══ 7. DẢI CHỐT ═══════════════════════════════════════════════════════════
     Người cuộn tới đây là người quan tâm nhất. Cho họ đúng một việc để làm.  *@
<section class="cta-band">
    <div class="container stack stack-5" style="align-items: center; text-align: center;">
        <h2 class="cta-title">Khát chưa? Order đi.</h2>
        <p class="lead cta-lead">
            Chọn món, chọn size, chọn topping — xong xuôi rồi mới tới quán lấy.
        </p>
        <a href="/menu" class="btn btn-lg cta-btn">Mở thực đơn</a>
    </div>
</section>

@code {
    private List<ProductCardDto> _featured = new();
    private List<ProductCardDto> _promoProducts = new();
    private List<CategoryDto> _categories = new();
    private int _totalProducts;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.GetMenuAsync();

        if (res.Success && res.Data is not null)
        {
            // Chỉ lấy món còn bán được — trang chủ là nơi gây ấn tượng đầu tiên,
            // không phải chỗ trưng bày món hết hàng.
            var all = res.Data.Products.Where(p => p.IsAvailable).ToList();

            _totalProducts = res.Data.Products.Count;

            // Danh mục có món mới hiện lên dải — danh mục rỗng bấm vào chỉ thấy
            // trang trắng, tệ hơn là không hiện.
            _categories = res.Data.Categories.Where(c => c.ProductCount > 0).ToList();

            _featured = all.Where(p => p.Tags.Contains("best-seller")).Take(8).ToList();

            // Quán mới chưa gắn nhãn bán chạy thì lấy tạm 8 món đầu
            if (_featured.Count == 0) _featured = all.Take(8).ToList();

            // Món đang giảm giá — thường do kế hoạch AI đề xuất xả hàng cận hạn.
            // Giảm sâu nhất lên trước.
            _promoProducts = all
                .Where(p => p.DiscountPercent > 0)
                .OrderByDescending(p => p.DiscountPercent)
                .ToList();
        }

        _loading = false;
    }
}
