@code {
    // --- Vòm ảnh trượt ở hero --------------------------------------------------
    // Focus là object-position: ảnh hero gốc là ảnh ngang, ly nằm lệch trái (23%),
    // các ảnh món còn lại là ảnh vuông, ly nằm giữa.
    private sealed record HeroSlide(string Src, string Alt, string Name, string Note, string Focus);

    private static readonly HeroSlide[] HeroSlides =
    {
        new(DrinkPhoto.HeroCaPhe,  "Ly cà phê sữa đá pha phin tại Một Chút Coffee", "Cà phê sữa đá", "Rang mộc mỗi sáng",       "23% 52%"),
        new(DrinkPhoto.TraSua,     "Ly trà sữa trân châu",                          "Trà sữa trân châu", "Trân châu nấu mỗi ngày", "50% 50%"),
        new(DrinkPhoto.TraTraiCay, "Ly trà trái cây nhiều màu",                     "Trà trái cây",  "Trái cây tươi pha khi gọi",  "50% 50%"),
        new(DrinkPhoto.Matcha,     "Ly matcha latte xanh mát",                      "Matcha latte",  "Đánh tay từng ly",           "50% 50%"),
        new(DrinkPhoto.DaXay,      "Ly đá xay phủ kem",                             "Đá xay",        "Mát lạnh cả ngày",           "50% 50%"),
    };

    private List<ProductCardDto> _featured = new();
    private List<ProductCardDto> _promoProducts = new();
    private List<CategoryDto> _categories = new();
    private int _totalProducts;
    private bool _loading = true;

    // --- Trạng thái mở/đóng cửa ----------------------------------------------
    /// <summary>Quán có đang mở tại lần vẽ gần nhất không. Xem Services/StoreHours.cs.</summary>
    private bool _isOpen = StoreHours.IsOpenNow();

    /// <summary>
    /// Đồng hồ đếm mỗi phút để chip trạng thái tự lật màu.
    ///
    /// Không có nó thì một người mở trang lúc 21:58 rồi ngồi đọc thực đơn sẽ
    /// thấy chấm xanh "đang mở cửa" mãi cho tới khi bấm tải lại — đúng lúc
    /// thông tin sai gây thiệt hại nhất. Mỗi phút một lần là đủ nhuyễn cho một
    /// mốc giờ tròn, và rẻ đến mức không cần cân nhắc.
    /// </summary>
    private System.Threading.Timer? _clock;

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.GetMenuAsync();

        if (res.Success && res.Data is not null)
        {
            // Chỉ lấy món còn bán được — trang chủ là nơi gây ấn tượng đầu tiên,
            // không phải chỗ trưng bày món hết hàng.
            var all = res.Data.Products.Where(p => p.IsAvailable).ToList();

            _totalProducts = res.Data.Products.Count;

            // Danh mục có món mới hiện lên dải — danh mục rỗng bấm vào chỉ thấy
            // trang trắng, tệ hơn là không hiện.
            _categories = res.Data.Categories.Where(c => c.ProductCount > 0).ToList();

            _featured = all.Where(p => p.Tags.Contains("best-seller")).Take(8).ToList();

            // Quán mới chưa gắn nhãn bán chạy thì lấy tạm 8 món đầu
            if (_featured.Count == 0) _featured = all.Take(8).ToList();

            // Món đang giảm giá — thường do kế hoạch AI đề xuất xả hàng cận hạn.
            // Giảm sâu nhất lên trước.
            _promoProducts = all
                .Where(p => p.DiscountPercent > 0)
                .OrderByDescending(p => p.DiscountPercent)
                .ToList();
        }

        _loading = false;

        // Đặt sau khi tải xong dữ liệu: lúc này component chắc chắn đã gắn vào
        // cây, InvokeAsync mới có chỗ để đẩy việc vẽ lại về đúng luồng UI.
        _clock = new System.Threading.Timer(_ => InvokeAsync(RefreshOpenState), null,
                           TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    /// <summary>
    /// Đối chiếu lại giờ hiện tại và CHỈ vẽ lại khi trạng thái thật sự đổi.
    /// Gọi StateHasChanged mỗi phút cho một chuỗi chữ y hệt là bắt trình duyệt
    /// dựng lại cả trang chủ 1440 lần mỗi ngày mà không đổi lấy một điểm ảnh.
    /// </summary>
    private void RefreshOpenState()
    {
        var open = StoreHours.IsOpenNow();
        if (open == _isOpen) return;

        _isOpen = open;
        StateHasChanged();
    }

    /// <summary>Timer là tài nguyên hệ điều hành — rời trang thì phải trả lại.</summary>
    public void Dispose() => _clock?.Dispose();
}
