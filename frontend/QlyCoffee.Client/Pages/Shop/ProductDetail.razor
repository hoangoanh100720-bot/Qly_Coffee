@*
    =============================================================================
    TRANG CHI TIẾT MÓN — chọn size, topping, số lượng
    =============================================================================
    Ba điểm thiết kế:
    1. Giá cập nhật NGAY khi chọn size hoặc topping — không bắt bấm "tính giá".
    2. Tồn kho ràng buộc theo TỪNG SIZE (size L tốn nhiều nguyên liệu hơn nên
       số ly còn làm được ít hơn), và số lượng bị chặn ở trần đó.
    3. Nhóm bắt buộc chưa chọn thì nút thêm vào giỏ bị vô hiệu KÈM LÝ DO,
       không để nút xám im lặng.
    =============================================================================
*@
@page "/menu/{Slug}"
@layout ShopLayout
@inject ApiClient Api
@inject CartService Cart
@inject AlertService Alerts
@inject NavigationManager Nav

@*  SEO: đây là loại trang mang lại nhiều truy cập tự nhiên nhất — người ta gõ
    "trà sữa trân châu đường đen quận 1" chứ hiếm khi gõ tên quán.
    Mô tả ghép từ tên món + mô tả trong database + giá, nên mỗi món có một
    đoạn mô tả riêng thay vì dùng chung một câu (Google phạt nội dung trùng lặp).
    Chỉ dựng SeoHead khi đã có dữ liệu — trước đó dùng bộ thẻ mặc định của site. *@
@if (_product is not null)
{
    <SeoHead Title="@_product.Name"
             Description="@BuildSeoDescription()"
             Path="@($"/menu/{_product.Slug}")"
             Image="@DrinkPhoto.PhotoFor(_product.ImageUrl, _product.CategoryName, _product.Name)"
             ImageAlt="@DrinkPhoto.AltFor(_product.ImageUrl, _product.Name)"
             OgType="product" />
}
else
{
    <PageTitle>Món — Một Chút Coffee</PageTitle>
}

@if (_loading)
{
    <div class="container section-sm">
        <div class="product-detail">
            <div class="skeleton" style="aspect-ratio: 1; border-radius: var(--radius-lg);"></div>
            <div class="stack stack-4">
                <div class="skeleton skeleton-title"></div>
                <div class="skeleton skeleton-text"></div>
                <div class="skeleton" style="height: 120px;"></div>
            </div>
        </div>
    </div>
}
else if (_product is null)
{
    <div class="container section">
        <div class="empty">
            <CupIcon Size="52" CssClass="empty-icon" />
            <span class="empty-title">Không tìm thấy món này</span>
            <a href="/menu" class="btn btn-primary">Xem thực đơn</a>
        </div>
    </div>
}
else
{
    <div class="container section-sm">

        <nav class="breadcrumb" aria-label="Đường dẫn">
            <a href="/menu">Thực đơn</a>
            <span aria-hidden="true">›</span>
            <span>@_product.CategoryName</span>
        </nav>

        <div class="product-detail">

            @*  ── ẢNH MÓN ────────────────────────────────────────────────
                Ảnh chụp thật, luôn có (DrinkPhoto không bao giờ trả về rỗng).
                fetchpriority="high" vì đây là phần tử LCP của trang chi tiết —
                khách vào từ Google sẽ thấy ảnh trước cả khi đọc tên món.       *@
            <div class="detail-visual"
                 style="--drink: @_product.ColorPrimaryHex; --foam: @_product.ColorAccentHex;">
                <img src="@DrinkPhoto.PhotoFor(_product.ImageUrl, _product.CategoryName, _product.Name)"
                     alt="@DrinkPhoto.AltFor(_product.ImageUrl, _product.Name)"
                     fetchpriority="high" decoding="async"
                     width="900" height="900" />
            </div>

            @* ── THÔNG TIN & LỰA CHỌN ───────────────────────────────────── *@
            <div class="stack stack-6">

                <div class="stack stack-3">
                    <div class="row row-2 row-wrap">
                        @foreach (var tag in _product.Tags)
                        {
                            <span class="badge badge-neutral">@TagLabel(tag)</span>
                        }
                        @if (_product.DiscountPercent > 0)
                        {
                            <span class="badge badge-danger">Giảm @_product.DiscountPercent%</span>
                        }
                    </div>

                    <h1>@_product.Name</h1>

                    @if (!string.IsNullOrEmpty(_product.Description))
                    {
                        <p class="lead">@_product.Description</p>
                    }

                    <div class="row row-3">
                        <span class="price" style="font-size: var(--text-xl);">
                            @Money.Format(CurrentUnitPrice)
                        </span>
                        @if (_product.DiscountPercent > 0)
                        {
                            <span class="price-old">@Money.Format(OriginalUnitPrice)</span>
                        }
                    </div>
                </div>

                @* ── CẢNH BÁO TỒN KHO ───────────────────────────────────── *@
                @if (CurrentMaxServings == 0)
                {
                    <div class="alert alert-danger" role="status">
                        <WarnIcon Size="18" />
                        <span>
                            Món này tạm hết.
                            @if (!string.IsNullOrEmpty(_product.UnavailableReason))
                            {
                                <AuthorizeView Roles="Staff,Manager,Owner">
                                    <span class="muted">(@_product.UnavailableReason)</span>
                                </AuthorizeView>
                            }
                        </span>
                    </div>
                }
                else if (CurrentMaxServings <= 5)
                {
                    <div class="alert alert-warn" role="status">
                        <ClockIcon Size="18" />
                        <span>Chỉ còn <strong>@CurrentMaxServings phần</strong> với size đang chọn.</span>
                    </div>
                }

                @*  ── GỢI Ý THƯỞNG THỨC ──────────────────────────────────────
                    Đặt TRƯỚC phần chọn size chứ không nhét xuống cuối trang:
                    câu này thường khuyên uống nóng hay ăn kèm bánh nào, mà khách
                    chỉ đổi được lựa chọn khi chưa bấm thêm vào giỏ.
                    Món chưa có gợi ý thì bỏ hẳn khối, không hiện khung rỗng.   *@
                @if (!string.IsNullOrWhiteSpace(_product.PairingNote))
                {
                    <aside class="serving-tip">
                        <SparkIcon Size="18" CssClass="serving-tip-icon" />
                        <div>
                            <span class="serving-tip-label">Gợi ý thưởng thức</span>
                            <p>@_product.PairingNote</p>
                        </div>
                    </aside>
                }

                @* ── CHỌN SIZE ──────────────────────────────────────────── *@
                @if (_product.Variants.Count > 1)
                {
                    <fieldset class="field">
                        <legend class="field-label">Kích cỡ</legend>
                        <div class="choice-group">
                            @foreach (var v in _product.Variants)
                            {
                                <button type="button"
                                        class="choice @(_variantId == v.Id ? "is-selected" : "")"
                                        aria-pressed="@(_variantId == v.Id)"
                                        disabled="@(v.MaxServings == 0)"
                                        @onclick="() => SelectVariant(v)">
                                    @v.Name
                                    @if (v.PriceDelta != 0)
                                    {
                                        <span class="xs">@(v.PriceDelta > 0 ? "+" : "")@Money.FormatShort(v.PriceDelta)</span>
                                    }
                                </button>
                            }
                        </div>
                    </fieldset>
                }

                @*  ── NHÓM TÙY CHỌN ──────────────────────────────────────────
                    Nhóm "Mức đá" bị LỌC RA khi khách đang chọn dùng nóng — xem
                    IsVisible. Hỏi "bao nhiêu phần trăm đá" cho một ly cà phê
                    nóng vừa vô nghĩa vừa làm bếp pha sai.                      *@
                @foreach (var group in _product.ModifierGroups.Where(IsVisible))
                {
                    <fieldset class="field">
                        <legend class="field-label">
                            @group.Name
                            @if (group.IsRequired)
                            {
                                <span class="req" aria-hidden="true">*</span>
                            }
                            @if (group.MaxSelect > 1)
                            {
                                <span class="xs muted" style="font-weight: 400;">
                                    (chọn tối đa @group.MaxSelect)
                                </span>
                            }
                        </legend>

                        <div class="choice-group">
                            @foreach (var m in group.Modifiers)
                            {
                                var selected = _selectedModifiers.Contains(m.Id);
                                <button type="button"
                                        class="choice @(selected ? "is-selected" : "")"
                                        aria-pressed="@selected"
                                        @onclick="() => ToggleModifier(group, m)">
                                    @if (ShowSwatch(group, m))
                                    {
                                        <span class="swatch" style="--swatch-color: @m.ColorHex"></span>
                                    }
                                    @m.Name
                                    @if (m.PriceDelta > 0)
                                    {
                                        <span class="xs">+@Money.FormatShort(m.PriceDelta)</span>
                                    }
                                </button>
                            }
                        </div>
                    </fieldset>
                }

                @* ── GHI CHÚ ───────────────────────────────────────────── *@
                <div class="field">
                    <label class="field-label" for="note">Ghi chú cho quán</label>
                    <input id="note" type="text" class="input"
                           placeholder="VD: pha loãng giúp em, ít ngọt"
                           maxlength="200" @bind="_note" />
                </div>

                @* ── SỐ LƯỢNG & THÊM VÀO GIỎ ───────────────────────────── *@
                <div class="add-to-cart">
                    <div class="qty-stepper" role="group" aria-label="Số lượng">
                        <button class="qty-btn" @onclick="() => ChangeQty(-1)"
                                disabled="@(_quantity <= 1)" aria-label="Giảm số lượng">−</button>
                        <span class="qty-value num" aria-live="polite">@_quantity</span>
                        <button class="qty-btn" @onclick="() => ChangeQty(1)"
                                disabled="@(_quantity >= CurrentMaxServings)" aria-label="Tăng số lượng">+</button>
                    </div>

                    <button class="btn btn-primary btn-lg grow"
                            disabled="@(!CanAddToCart)"
                            @onclick="AddToCart">
                        <CartIcon Size="18" />
                        Thêm vào giỏ · @Money.Format(CurrentUnitPrice * _quantity)
                    </button>
                </div>

                @* Nút bị vô hiệu thì PHẢI nói rõ vì sao *@
                @if (!CanAddToCart && CurrentMaxServings > 0)
                {
                    <span class="xs text-warn">@BlockReason</span>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private ProductDetailDto? _product;
    private bool _loading = true;

    private Guid? _variantId;
    private readonly HashSet<Guid> _selectedModifiers = new();
    private int _quantity = 1;
    private string? _note;

    // ── Giá tính lại mỗi lần render, không cần gọi API ────────────────────

    private int OriginalUnitPrice
    {
        get
        {
            if (_product is null) return 0;
            var variantDelta = _product.Variants.FirstOrDefault(v => v.Id == _variantId)?.PriceDelta ?? 0;
            var modifierTotal = _product.ModifierGroups
                .SelectMany(g => g.Modifiers)
                .Where(m => _selectedModifiers.Contains(m.Id))
                .Sum(m => m.PriceDelta);
            return _product.BasePrice + variantDelta + modifierTotal;
        }
    }

    private int CurrentUnitPrice => _product is null || _product.DiscountPercent == 0
        ? OriginalUnitPrice
        : (int)Math.Round(OriginalUnitPrice * (100 - _product.DiscountPercent) / 100.0);

    /// <summary>Trần số lượng theo size đang chọn — size L tốn nhiều nguyên liệu hơn.</summary>
    private int CurrentMaxServings =>
        _product?.Variants.FirstOrDefault(v => v.Id == _variantId)?.MaxServings
        ?? _product?.MaxServings
        ?? 0;

    private bool CanAddToCart =>
        _product is not null && CurrentMaxServings > 0 && AllRequiredGroupsSelected;

    // Chỉ xét nhóm ĐANG HIỆN. Nhóm bị ẩn (mức đá của một ly uống nóng) mà vẫn
    // tính là bắt buộc thì nút thêm vào giỏ chết cứng kèm câu "Vui lòng chọn:
    // Mức đá" trong khi trên màn hình không có ô nào để bấm.
    private bool AllRequiredGroupsSelected =>
        _product?.ModifierGroups
            .Where(g => g.IsRequired && IsVisible(g))
            .All(g => g.Modifiers.Any(m => _selectedModifiers.Contains(m.Id)))
        ?? false;

    private string BlockReason
    {
        get
        {
            var missing = _product?.ModifierGroups
                .Where(g => g.IsRequired && IsVisible(g)
                         && !g.Modifiers.Any(m => _selectedModifiers.Contains(m.Id)))
                .Select(g => g.Name)
                .ToList();

            return missing is { Count: > 0 }
                ? $"Vui lòng chọn: {string.Join(", ", missing)}"
                : "";
        }
    }

    // ── Nóng hay đá ────────────────────────────────────────────────────────
    //
    //  Món pha được cả hai kiểu có thêm một nhóm "Dùng nóng hay đá". Chọn nóng
    //  thì nhóm mức đá biến mất, và mọi lựa chọn mức đá đang giữ bị bỏ theo —
    //  nếu không, đơn gửi xuống bếp là "cà phê kem trứng nóng, 100% đá".
    //
    //  Nhận diện nhóm bằng CỘT KIND chứ không bằng tên: quán đổi tên nhóm thành
    //  "Đá nhiều hay ít" thì mọi thứ vẫn chạy đúng.

    private ModifierGroupDto? TemperatureGroup =>
        _product?.ModifierGroups.FirstOrDefault(g => g.Kind == ModifierGroupKinds.Temperature);

    /// <summary>Khách đang chọn dùng nóng. Món không có nhóm nóng/đá thì luôn false.</summary>
    private bool ServedHot =>
        TemperatureGroup is { } temp
        && temp.Modifiers.Any(m => _selectedModifiers.Contains(m.Id)
                                && ModifierGroupKinds.IsHotChoice(m.Name));

    /// <summary>Đã chọn nóng hay đá chưa. Món chỉ có một kiểu phục vụ thì coi như rồi.</summary>
    private bool TemperatureChosen =>
        TemperatureGroup is not { } temp
        || temp.Modifiers.Any(m => _selectedModifiers.Contains(m.Id));

    /// <summary>
    /// Mức đá chỉ hiện khi đã biết ly này là ly đá. Chưa chọn nóng hay đá thì
    /// cũng chưa hiện: hỏi "bao nhiêu phần trăm đá" trước câu "có đá không" là
    /// hỏi ngược thứ tự.
    /// </summary>
    private bool IsVisible(ModifierGroupDto group) =>
        group.Kind != ModifierGroupKinds.Ice
        || (TemperatureChosen && !ServedHot);

    /// <summary>
    /// Chấm màu chỉ có nghĩa với thứ CÓ MÀU THẬT — topping. Mức đường, mức đá,
    /// nóng/đá thì màu là quy ước chứ không phải màu của đồ ăn nên không vẽ chấm.
    /// </summary>
    private static bool ShowSwatch(ModifierGroupDto group, ModifierDto modifier)
        => group.Kind is not (ModifierGroupKinds.Sugar
                              or ModifierGroupKinds.Ice
                              or ModifierGroupKinds.Temperature)
           // Nhóm sinh ra trước khi có cột Kind thì kind rỗng — vẫn phải lọc
           // được, nên giữ lại phép so màu quy ước cũ làm lưới đỡ.
           && modifier.ColorHex != "#D9B368" && modifier.ColorHex != "#DCEAF2";

    /// <summary>
    /// Giữ mức đá khớp với lựa chọn nóng/đá: đang ẩn thì bỏ hết lựa chọn cũ,
    /// vừa hiện ra thì chọn sẵn mức đầu tiên vì đây là nhóm bắt buộc.
    /// </summary>
    private void SyncIceWithTemperature()
    {
        var iceGroup = _product?.ModifierGroups
            .FirstOrDefault(g => g.Kind == ModifierGroupKinds.Ice);
        if (iceGroup is null) return;

        if (!IsVisible(iceGroup))
        {
            foreach (var m in iceGroup.Modifiers) _selectedModifiers.Remove(m.Id);
        }
        else if (!iceGroup.Modifiers.Any(m => _selectedModifiers.Contains(m.Id)))
        {
            var first = iceGroup.Modifiers.FirstOrDefault();
            if (first is not null) _selectedModifiers.Add(first.Id);
        }
    }

    // ── Nạp dữ liệu ────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _selectedModifiers.Clear();
        _quantity = 1;

        var res = await Api.GetProductAsync(Slug);
        _product = res.Success ? res.Data : null;

        if (_product is not null)
        {
            // Chọn sẵn size mặc định
            _variantId = _product.Variants.FirstOrDefault(v => v.IsDefault)?.Id
                      ?? _product.Variants.FirstOrDefault()?.Id;

            //  Chọn sẵn lựa chọn đầu tiên của mỗi nhóm bắt buộc, để khách
            //  không phải bấm thêm nếu đồng ý mặc định.
            //
            //  TRỪ NHÓM NÓNG/ĐÁ — nhóm này CỐ Ý để trống.
            //  Mức đường mặc định 100% mà khách không để ý thì cùng lắm ngọt hơn
            //  ý muốn; còn nhận nhầm ly nóng khi đang muốn uống đá là đổi hẳn
            //  món. Mà không có mặc định nào đúng cho cả menu: bạc xỉu thì gần
            //  như ai cũng gọi đá, cà phê kem trứng thì phải nóng mới đúng vị.
            //  Nên bắt chọn tay — nút thêm vào giỏ đã tự khóa kèm lý do sẵn.
            foreach (var g in _product.ModifierGroups
                         .Where(g => g.IsRequired && g.Kind != ModifierGroupKinds.Temperature))
            {
                var first = g.Modifiers.FirstOrDefault();
                if (first is not null) _selectedModifiers.Add(first.Id);
            }

            // Món có hỏi nóng/đá thì mức đá chưa được hiện ra, nên bỏ luôn mức
            // đá vừa chọn sẵn ở vòng lặp trên.
            SyncIceWithTemperature();
        }

        _loading = false;
    }

    // ── Tương tác ──────────────────────────────────────────────────────────

    private void SelectVariant(VariantDto v)
    {
        _variantId = v.Id;
        // Đổi sang size ít hàng hơn thì phải hạ số lượng cho khớp
        if (_quantity > v.MaxServings) _quantity = Math.Max(1, v.MaxServings);
    }

    private void ToggleModifier(ModifierGroupDto group, ModifierDto modifier)
    {
        var isSelected = _selectedModifiers.Contains(modifier.Id);

        if (group.MaxSelect == 1)
        {
            // Nhóm chọn một: bỏ hết lựa chọn cũ trong nhóm rồi chọn cái mới
            foreach (var m in group.Modifiers) _selectedModifiers.Remove(m.Id);
            if (!isSelected) _selectedModifiers.Add(modifier.Id);
            // Nhóm bắt buộc thì không cho bỏ trống
            else if (group.IsRequired) _selectedModifiers.Add(modifier.Id);
        }
        else
        {
            if (isSelected)
            {
                _selectedModifiers.Remove(modifier.Id);
            }
            else
            {
                var countInGroup = group.Modifiers.Count(m => _selectedModifiers.Contains(m.Id));
                if (countInGroup >= group.MaxSelect)
                {
                    Alerts.Warning($"{group.Name} chỉ được chọn tối đa {group.MaxSelect} lựa chọn.");
                    return;
                }
                _selectedModifiers.Add(modifier.Id);
            }
        }

        // Vừa đổi nóng ↔ đá thì mức đá phải theo cho khớp, nếu không đơn xuống
        // bếp mang theo mức đá của lựa chọn cũ.
        if (group.Kind == ModifierGroupKinds.Temperature) SyncIceWithTemperature();
    }

    private void ChangeQty(int delta)
        => _quantity = Math.Clamp(_quantity + delta, 1, Math.Max(CurrentMaxServings, 1));

    private async Task AddToCart()
    {
        if (_product is null || !CanAddToCart) return;

        var variant = _product.Variants.FirstOrDefault(v => v.Id == _variantId);
        var modifiers = _product.ModifierGroups
            .SelectMany(g => g.Modifiers)
            .Where(m => _selectedModifiers.Contains(m.Id))
            .Select(m => new CartModifier
            {
                ModifierId = m.Id, Name = m.Name,
                PriceDelta = m.PriceDelta, ColorHex = m.ColorHex
            })
            .ToList();

        await Cart.AddAsync(new CartItem
        {
            ProductId         = _product.Id,
            ProductName       = _product.Name,
            ImageUrl          = _product.ImageUrl,
            ColorPrimaryHex   = _product.ColorPrimaryHex,
            ColorAccentHex    = _product.ColorAccentHex,
            VariantId         = variant?.Id,
            VariantName       = variant?.Name,
            Modifiers         = modifiers,
            Quantity          = _quantity,
            UnitPrice         = CurrentUnitPrice,
            OriginalUnitPrice = OriginalUnitPrice,
            Note              = _note,
            MaxServings       = CurrentMaxServings
        });

        Alerts.Success($"Đã thêm {_quantity} {_product.Name} vào giỏ.");
        _quantity = 1;
        _note = null;
    }

    /// <summary>
    /// Dựng đoạn mô tả cho thẻ meta description của riêng món này.
    ///
    /// Ba yêu cầu phải cân đối cùng lúc:
    ///   - Dài 120–160 ký tự. Ngắn quá Google tự viết lại, dài quá bị cắt.
    ///   - Chứa tên món và tên danh mục — đó là cụm từ khách gõ vào ô tìm kiếm.
    ///   - Có giá, vì đoạn mô tả kèm giá được bấm nhiều hơn hẳn.
    ///
    /// Mô tả trong database được ưu tiên; nếu quán chưa nhập thì ghép câu mặc định.
    /// </summary>
    private string BuildSeoDescription()
    {
        var p = _product!;
        var gia = Money.Format(p.EffectivePrice);

        var than = string.IsNullOrWhiteSpace(p.Description)
            ? $"{p.Name} thuộc nhóm {p.CategoryName}, pha theo công thức định lượng chuẩn"
            : p.Description.Trim().TrimEnd('.');

        return $"{than}. Giá từ {gia}. Đặt online tại Một Chút Coffee, tới lấy là có.";
    }

    private static string TagLabel(string tag) => tag switch
    {
        "best-seller" => "Bán chạy",
        "new" or "mới" => "Mới",
        "signature" => "Đặc trưng",
        _ => tag
    };
}
