@*
    =============================================================================
    TRANG GHI NHẬN HAO HỤT
    =============================================================================
    Ghi lại nguyên liệu bị đổ bỏ: pha hỏng, rơi vãi, quá hạn phải tiêu hủy.

    LÝ DO LÀ BẮT BUỘC — không cho phép giảm tồn kho mà không giải trình.
    Đây không phải để làm khó nhân viên: khi cuối tháng kiểm kê thấy lệch,
    bảng lý do này là thứ duy nhất giải thích được tiền đi đâu.

    Lý do chọn từ danh sách có sẵn để dữ liệu thống kê được, kèm ô ghi chú
    tự do cho trường hợp đặc biệt.
    =============================================================================
*@
@page "/admin/hao-hut"
@layout AdminLayout
@attribute [Authorize(Roles = "Staff,Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts

<PageTitle>Hao hụt — Một Chút Coffee</PageTitle>

<div class="stack stack-6">

    <div class="stack stack-1">
        <h2>Ghi nhận hao hụt</h2>
        <span class="xs muted">
            Mọi lần giảm tồn kho ngoài bán hàng đều phải có lý do — đây là bằng chứng đối soát
        </span>
    </div>

    @if (_loading)
    {
        <div class="skeleton" style="height: 360px; border-radius: var(--radius-lg);"></div>
    }
    else
    {
        <div class="waste-layout">

            @* ══ CỘT TRÁI — FORM ═══════════════════════════════════════════ *@
            <section class="card">
                <h3 class="card-title">Nguyên liệu bị hao hụt</h3>

                <div class="stack stack-5">

                    <div class="field">
                        <label class="field-label" for="ingredient">
                            Nguyên liệu <span class="req" aria-hidden="true">*</span>
                        </label>
                        <select id="ingredient" class="select" @bind="_ingredientId">
                            <option value="">— Chọn nguyên liệu —</option>
                            @foreach (var g in _ingredients.Where(i => i.TotalStock > 0)
                                                           .GroupBy(i => i.CategoryLabel))
                            {
                                <optgroup label="@g.Key">
                                    @foreach (var i in g.OrderBy(x => x.Name))
                                    {
                                        <option value="@i.Id">
                                            @i.Name (còn @Qty.Format(i.TotalStock) @i.UnitLabel)
                                        </option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    @if (Selected is not null)
                    {
                        <div class="field">
                            <label class="field-label" for="quantity">
                                Số lượng hao hụt <span class="req" aria-hidden="true">*</span>
                            </label>
                            <div class="input-group" style="max-width: 220px;">
                                <input id="quantity" type="number" class="input input-num"
                                       min="0" step="0.1" placeholder="0"
                                       max="@Selected.TotalStock"
                                       aria-invalid="@(_touched && !IsQuantityValid)"
                                       @bind="_quantity" @bind:event="oninput" />
                                <span class="input-suffix">@Selected.UnitLabel</span>
                            </div>

                            @if (_touched && _quantity <= 0)
                            {
                                <span class="field-error">
                                    <WarnIcon Size="12" /> Số lượng phải lớn hơn 0.
                                </span>
                            }
                            else if (_touched && _quantity > Selected.TotalStock)
                            {
                                <span class="field-error">
                                    <WarnIcon Size="12" />
                                    Chỉ còn @Qty.Format(Selected.TotalStock) @Selected.UnitLabel trong kho.
                                </span>
                            }
                        </div>

                        @* ── Lý do: chọn từ danh sách để thống kê được ─────── *@
                        <fieldset class="field">
                            <legend class="field-label">
                                Lý do <span class="req" aria-hidden="true">*</span>
                            </legend>
                            <div class="choice-group">
                                @foreach (var reason in Reasons)
                                {
                                    <button type="button"
                                            class="choice @(_reasonKey == reason ? "is-selected" : "")"
                                            aria-pressed="@(_reasonKey == reason)"
                                            @onclick="() => _reasonKey = reason">
                                        @reason
                                    </button>
                                }
                            </div>
                            @if (_touched && string.IsNullOrEmpty(_reasonKey))
                            {
                                <span class="field-error">
                                    <WarnIcon Size="12" /> Vui lòng chọn lý do.
                                </span>
                            }
                        </fieldset>

                        <div class="field">
                            <label class="field-label" for="detail">Mô tả thêm</label>
                            <input id="detail" type="text" class="input" maxlength="200"
                                   placeholder="VD: đổ ly khi bưng ra bàn 4"
                                   @bind="_detail" />
                            <span class="field-hint">
                                Không bắt buộc, nhưng giúp ích khi rà soát cuối tháng.
                            </span>
                        </div>
                    }
                </div>

                <div class="card-footer">
                    <button class="btn btn-danger btn-lg btn-block"
                            disabled="@(!CanSubmit)"
                            @onclick="SubmitAsync">
                        @if (_submitting)
                        {
                            <SpinnerIcon Size="18" />
                            <span>Đang ghi…</span>
                        }
                        else
                        {
                            <TrashIcon Size="18" />
                            <span>Ghi nhận hao hụt</span>
                        }
                    </button>

                    @if (!CanSubmit && _touched && !_submitting)
                    {
                        <span class="xs text-warn" style="display: block; text-align: center; margin-top: var(--space-2);">
                            @BlockReason
                        </span>
                    }
                </div>
            </section>

            @* ══ CỘT PHẢI — TÁC ĐỘNG ═══════════════════════════════════════ *@
            <aside class="stack stack-4">

                @if (Selected is null)
                {
                    <div class="card">
                        <div class="empty" style="padding: var(--space-8) var(--space-4);">
                            <TrashIcon Size="40" CssClass="empty-icon" />
                            <span class="empty-text">
                                Chọn nguyên liệu để xem tác động lên tồn kho và chi phí.
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="row row-3">
                            <div class="ingredient-icon" style="--ing-color: @Selected.ColorHex; width: 44px; height: 44px;">
                                <IngredientIcon IconKey="@Selected.IconKey"
                                                ColorHex="@Selected.ColorHex"
                                                Size="26" AriaLabel="@Selected.Name" />
                            </div>
                            <div class="stack stack-1 grow">
                                <span style="font-weight: 700;">@Selected.Name</span>
                                <span class="ingredient-sku">@Selected.Sku</span>
                            </div>
                        </div>

                        @if (_quantity > 0)
                        {
                            <div class="pl-table" style="margin-top: var(--space-3);">
                                <div class="pl-row">
                                    <span class="pl-label">Tồn hiện tại</span>
                                    <span class="pl-value num">
                                        @Qty.Format(Selected.TotalStock) @Selected.UnitLabel
                                    </span>
                                </div>
                                <div class="pl-row">
                                    <span class="pl-label">Hao hụt</span>
                                    <span class="pl-value pl-negative num">
                                        −@Qty.Format(_quantity) @Selected.UnitLabel
                                    </span>
                                </div>
                                <div class="pl-row pl-total">
                                    <span class="pl-label">Còn lại</span>
                                    <span class="pl-value num">
                                        @Qty.Format(Math.Max(0, Selected.TotalStock - _quantity)) @Selected.UnitLabel
                                    </span>
                                </div>
                            </div>

                            <div class="alert alert-danger">
                                <WarnIcon Size="18" />
                                <div class="stack stack-1">
                                    <span class="alert-title">
                                        Thiệt hại khoảng @Money.Format(EstimatedLoss)
                                    </span>
                                    <span class="xs">
                                        Tính theo giá vốn trung bình @Money.Format(Selected.AverageUnitCost)/@Selected.UnitLabel.
                                        Số liệu này vào báo cáo hao hụt cuối ngày.
                                    </span>
                                </div>
                            </div>

                            @* Cảnh báo khi hao hụt đẩy tồn xuống dưới ngưỡng *@
                            @if (Selected.MinStockLevel > 0
                                 && Selected.TotalStock - _quantity < Selected.MinStockLevel)
                            {
                                <div class="alert alert-warn">
                                    <InfoIcon Size="18" />
                                    <span class="xs">
                                        Sau khi ghi, tồn kho sẽ xuống dưới ngưỡng tối thiểu
                                        (@Qty.Format(Selected.MinStockLevel) @Selected.UnitLabel).
                                        Một số món có thể chuyển sang trạng thái tạm hết.
                                    </span>
                                </div>
                            }
                        }
                    </div>

                    <div class="alert alert-info">
                        <InfoIcon Size="18" />
                        <span class="xs">
                            Hệ thống trừ theo FEFO — lô hết hạn sớm nhất bị trừ trước,
                            đúng như khi bán hàng.
                        </span>
                    </div>
                }
            </aside>
        </div>
    }
</div>

@code {
    private List<IngredientStockDto> _ingredients = new();
    private bool _loading = true;
    private bool _submitting;
    private bool _touched;

    private string _ingredientId = "";
    private double _quantity;
    private string _reasonKey = "";
    private string _detail = "";

    /// <summary>
    /// Lý do chọn từ danh sách cố định để thống kê được theo nhóm.
    /// Thêm lý do mới thì chỉ cần sửa mảng này.
    /// </summary>
    private static readonly string[] Reasons =
    {
        "Pha hỏng",
        "Rơi vãi",
        "Quá hạn",
        "Khách trả lại",
        "Hỏng do bảo quản",
        "Nếm thử / đào tạo",
        "Khác"
    };

    private IngredientStockDto? Selected =>
        Guid.TryParse(_ingredientId, out var id)
            ? _ingredients.FirstOrDefault(i => i.Id == id)
            : null;

    private bool IsQuantityValid =>
        Selected is not null && _quantity > 0 && _quantity <= Selected.TotalStock;

    private int EstimatedLoss => Selected is null
        ? 0
        : (int)Math.Round(_quantity * Selected.AverageUnitCost);

    private bool CanSubmit =>
        !_submitting && IsQuantityValid && !string.IsNullOrEmpty(_reasonKey);

    private string BlockReason =>
        Selected is null ? "Chưa chọn nguyên liệu."
        : _quantity <= 0 ? "Số lượng phải lớn hơn 0."
        : _quantity > Selected.TotalStock ? "Số lượng vượt quá tồn kho."
        : string.IsNullOrEmpty(_reasonKey) ? "Chưa chọn lý do."
        : "";

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.GetIngredientsAsync();
        _ingredients = res.Success && res.Data is not null ? res.Data : new();
        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _touched = true;
        if (!CanSubmit) return;

        _submitting = true;

        // Ghép lý do đã chọn với mô tả thêm thành một chuỗi duy nhất để lưu
        var reason = string.IsNullOrWhiteSpace(_detail)
            ? _reasonKey
            : $"{_reasonKey}: {_detail.Trim()}";

        var res = await Api.RecordWasteAsync(new RecordWasteRequest
        {
            IngredientId = Selected!.Id,
            Quantity     = _quantity,
            Reason       = reason
        });

        _submitting = false;

        if (res.Success)
        {
            Alerts.Success(
                $"Đã ghi hao hụt {Qty.Format(_quantity)} {Selected.UnitLabel} {Selected.Name} " +
                $"({Money.Format(EstimatedLoss)}).");

            _quantity = 0;
            _reasonKey = "";
            _detail = "";
            _touched = false;

            var reload = await Api.GetIngredientsAsync();
            if (reload.Success && reload.Data is not null) _ingredients = reload.Data;
        }
        else
        {
            Alerts.Error(res.Error?.Message ?? "Không ghi được hao hụt.");
        }
    }
}
