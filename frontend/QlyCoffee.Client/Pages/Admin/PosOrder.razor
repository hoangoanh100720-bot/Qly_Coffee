@*
    =============================================================================
    BÁN HÀNG TẠI QUẦY
    =============================================================================
    Archetype: màn hình thao tác nhanh, dùng liên tục cả ngày.

    Đây là trang nhân viên chạm vào nhiều nhất, nên nguyên tắc khác hẳn các trang
    quản lý còn lại:

      · Nút to, bấm được bằng ngón cái trên máy tính bảng dựng ở quầy
      · KHÔNG hộp thoại xác nhận ở đường chính — mỗi lần hỏi lại là một lần
        bắt khách đứng chờ. Bấm nhầm thì sửa ở giỏ, còn nhanh hơn bấm xác nhận.
      · Thời gian chờ tính lại NGAY mỗi khi giỏ đổi, để nhân viên nói được với
        khách trước lúc chốt đơn chứ không phải sau.
      · Món hết vẫn HIỆN nhưng mờ và không bấm được — nhân viên cần thấy để
        giải thích, thay vì món tự nhiên biến mất.
    =============================================================================
*@
@page "/admin/ban-hang"
@layout AdminLayout
@attribute [Authorize(Roles = "Staff,Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts
@implements IDisposable

<PageTitle>Bán hàng tại quầy — Một Chút Coffee</PageTitle>

<div class="pos-layout">

    @* ══════════════════════════════════════════════════════════════════════
       CỘT TRÁI — LƯỚI MÓN
       ══════════════════════════════════════════════════════════════════════ *@
    <div class="pos-menu">

        <div class="pos-filters">
            <button class="chip @(_activeCat is null ? "is-active" : "")"
                    @onclick="() => _activeCat = null">
                Tất cả <span class="xs muted num">@_products.Count</span>
            </button>
            @foreach (var c in _categories)
            {
                var n = _products.Count(p => p.CategoryId == c.Id);
                <button class="chip @(_activeCat == c.Id ? "is-active" : "")"
                        style="--chip-color: @c.ColorHex;"
                        @onclick="() => _activeCat = c.Id">
                    @c.Name <span class="xs muted num">@n</span>
                </button>
            }

            <div class="grow"></div>

            <div class="search-box">
                <SearchIcon Size="15" />
                <input type="search" class="input search-input" placeholder="Tìm món…"
                       @bind="_search" @bind:event="oninput" aria-label="Tìm món" />
            </div>
        </div>

        @if (_loading)
        {
            <div class="pos-grid" aria-busy="true">
                @for (int i = 0; i < 12; i++)
                {
                    <div class="skeleton" style="aspect-ratio: 1; border-radius: var(--radius-lg);"></div>
                }
            </div>
        }
        else if (Filtered.Count == 0)
        {
            <div class="empty">
                <CupIcon Size="44" CssClass="empty-icon" />
                <span class="empty-title">Không có món nào khớp</span>
                <span class="empty-text">Thử xóa từ khóa hoặc chọn nhóm khác.</span>
            </div>
        }
        else
        {
            <div class="pos-grid">
                @foreach (var p in Filtered)
                {
                    <button class="pos-tile @(p.IsAvailable ? "" : "is-out")"
                            style="--drink: @p.ColorPrimaryHex; --foam: @p.ColorAccentHex;"
                            disabled="@(!p.IsAvailable)"
                            @onclick="() => AddToCart(p)"
                            @key="p.Id">

                        @*  Luôn là ẢNH CHỤP: ảnh riêng của món nếu quán đã tải lên,
                            không thì ảnh mẫu theo nhóm. Nhân viên quầy nhận ra món
                            bằng ảnh nhanh hơn bằng chữ, mà 56 ô hình ly vẽ cùng một
                            dáng chỉ khác màu thì nhìn lướt không phân biệt nổi.
                            alt="" vì tên món nằm ngay dưới ô ảnh.                  *@
                        <div class="pos-tile-visual">
                            <img src="@DrinkPhoto.PhotoFor(p.ImageUrl, null, p.Name)"
                                 alt="" loading="lazy" decoding="async" />

                            @* Số ly đã có trong giỏ — nhìn là biết đã bấm mấy lần *@
                            @if (CartQty(p.Id) > 0)
                            {
                                <span class="pos-tile-count num">@CartQty(p.Id)</span>
                            }
                        </div>

                        <span class="pos-tile-name">@p.Name</span>
                        <span class="pos-tile-price num">@Money.Format(p.BasePrice)</span>

                        @if (!p.IsAvailable)
                        {
                            <span class="pos-tile-flag">Hết</span>
                        }
                        else if (p.MaxServings < 9999 && p.MaxServings <= 5)
                        {
                            <span class="pos-tile-flag warn">Còn @p.MaxServings</span>
                        }
                    </button>
                }
            </div>
        }
    </div>

    @* ══════════════════════════════════════════════════════════════════════
       CỘT PHẢI — GIỎ & CHỐT ĐƠN
       ══════════════════════════════════════════════════════════════════════ *@
    <aside class="pos-cart">

        <div class="pos-cart-head">
            <div class="stack stack-1">
                <h3>Đơn đang bấm</h3>
                <span class="xs muted">@_cart.Sum(l => l.Quantity) phần · @_cart.Count dòng</span>
            </div>
            @if (_cart.Count > 0)
            {
                <button class="btn btn-ghost btn-sm text-danger" @onclick="ClearCart">
                    Xóa hết
                </button>
            }
        </div>

        @if (_cart.Count == 0)
        {
            <div class="pos-cart-empty">
                <CartIcon Size="40" CssClass="empty-icon" />
                <span class="empty-text">Bấm vào món bên trái để thêm vào đơn.</span>
            </div>
        }
        else
        {
            <div class="pos-cart-lines">
                @foreach (var line in _cart)
                {
                    @*  @key dùng LineId chứ KHÔNG dùng "mã món:size" — xem chú
                        thích ở lớp CartLine để biết vì sao khóa phải cố định. *@
                    <div class="pos-line-wrap @(line.NoteOpen ? "is-editing" : "")"
                         @key="line.LineId" style="--drink: @line.ColorPrimaryHex;">

                        <div class="pos-line">

                            <div class="stack stack-1 grow" style="min-width: 0;">
                                <span class="pos-line-name">@line.Name</span>
                                @if (!string.IsNullOrEmpty(line.VariantName))
                                {
                                    <span class="xs muted">@line.VariantName</span>
                                }

                                @*  Ghi chú hiện ngay dưới tên món, kể cả khi khay
                                    đã đóng: nhân viên phải đọc lại được cả đơn
                                    trước lúc bấm chốt mà không cần mở lại từng
                                    dòng. In nghiêng trong ngoặc kép để mắt tách
                                    ngay khỏi tên món và size.                   *@
                                @if (line.HasNote)
                                {
                                    <span class="pos-line-note-text">“@line.Note”</span>
                                }
                            </div>

                            <div class="qty-stepper qty-sm" role="group"
                                 aria-label="Số lượng @line.Name">
                                <button class="qty-btn" @onclick="() => Bump(line, -1)"
                                        aria-label="Bớt">−</button>
                                <span class="qty-value num">@line.Quantity</span>
                                <button class="qty-btn" @onclick="() => Bump(line, 1)"
                                        disabled="@(CartQty(line.ProductId) >= line.MaxServings)"
                                        aria-label="Thêm">+</button>
                            </div>

                            <span class="pos-line-total num">@Money.Format(line.LineTotal)</span>

                            @*  Nút mở khay ghi chú. Sáng lên khi dòng đã có ghi
                                chú — liếc qua giỏ là thấy ngay dòng nào đặc biệt. *@
                            <button class="btn btn-ghost btn-icon btn-sm pos-note-btn @(line.HasNote ? "has-note" : "")"
                                    @onclick="() => ToggleNote(line)"
                                    aria-expanded="@line.NoteOpen"
                                    aria-label="Ghi chú cho @line.Name"
                                    title="Ghi chú (ít đá, giảm ngọt…)">
                                <EditIcon Size="14" />
                            </button>

                            <button class="btn btn-ghost btn-icon btn-sm"
                                    @onclick="() => Remove(line)"
                                    aria-label="Bỏ @line.Name khỏi đơn">
                                <TrashIcon Size="14" />
                            </button>
                        </div>

                        @*  ── KHAY GHI CHÚ ────────────────────────────────────
                            Chỉ dựng khi mở. Không dùng cách ẩn bằng CSS: khay
                            đóng vẫn nằm trong DOM thì ô input vẫn bắt được Tab,
                            và nhân viên dùng bàn phím sẽ lạc vào những ô vô hình. *@
                        @if (line.NoteOpen)
                        {
                            <div class="pos-note-tray">
                                <div class="choice-group">
                                    @foreach (var (label, group) in QuickNotes)
                                    {
                                        var on = line.Tags.Contains(label);
                                        <button type="button"
                                                class="choice choice-sm @(on ? "is-selected" : "")"
                                                aria-pressed="@on"
                                                @onclick="() => ToggleTag(line, label, group)">
                                            @label
                                        </button>
                                    }
                                </div>

                                <div class="row row-2">
                                    @*  @bind:event="oninput" để ghi chú hiện ra
                                        ngay lúc gõ, không phải đợi rời ô — nhân
                                        viên thường bấm thẳng sang nút khác.     *@
                                    <input type="text" class="input input-sm grow"
                                           maxlength="80"
                                           placeholder="Ghi chú khác cho người pha…"
                                           @bind="line.FreeNote" @bind:event="oninput" />

                                    @if (line.HasNote)
                                    {
                                        <button class="btn btn-ghost btn-sm text-danger"
                                                @onclick="() => ClearNote(line)">
                                            Xóa
                                        </button>
                                    }
                                    <button class="btn btn-secondary btn-sm"
                                            @onclick="() => line.NoteOpen = false">
                                        Xong
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── THỜI GIAN CHỜ ─────────────────────────────────────────────
               Đặt ngay trên nút chốt đơn vì đây là câu nhân viên phải nói ra
               miệng ngay trước khi bấm. *@
            <div class="pos-eta @(_eta is not null && _eta.Minutes > 10 ? "is-long" : "")">
                <ClockIcon Size="18" />
                @if (_etaLoading)
                {
                    <span class="small muted">Đang tính…</span>
                }
                else if (_eta is not null)
                {
                    <div class="stack stack-1 grow">
                        <span class="pos-eta-main">
                            Khoảng <strong class="num">@_eta.Minutes phút</strong>
                        </span>
                        <span class="xs muted">
                            @if (_eta.QueuedItemsAhead > 0)
                            {
                                <span>@_eta.QueuedItemsAhead phần đang chờ trước · </span>
                            }
                            <span>@_eta.Stations người pha</span>
                        </span>
                    </div>
                }
            </div>

            @* ── THÔNG TIN KHÁCH ─────────────────────────────────────────── *@
            <div class="pos-customer">
                <input type="text" class="input" maxlength="50"
                       placeholder="Tên khách (để gọi khi xong)"
                       @bind="_customerName" @bind:event="oninput" />

                <div class="choice-group">
                    <button type="button" class="choice @(_orderType == 0 ? "is-selected" : "")"
                            @onclick="() => _orderType = 0">Tại quán</button>
                    <button type="button" class="choice @(_orderType == 1 ? "is-selected" : "")"
                            @onclick="() => _orderType = 1">Mang đi</button>
                </div>

                <div class="choice-group">
                    <button type="button" class="choice @(_payment == 0 ? "is-selected" : "")"
                            @onclick="() => SetPayment(0)">Tiền mặt</button>
                    <button type="button" class="choice @(_payment == 1 ? "is-selected" : "")"
                            @onclick="() => SetPayment(1)">Chuyển khoản</button>
                </div>

                @*  ── MÃ QR CHUYỂN KHOẢN ──────────────────────────────────────
                    Hiện NGAY khi chọn "Chuyển khoản", trước lúc chốt đơn, vì đó
                    đúng là thứ tự việc ở quầy: khách quét và trả tiền trong lúc
                    nhân viên còn đang bấm nốt đơn, rồi mới bấm "Nhận đơn".
                    Bắt khách đợi chốt đơn xong mới hiện QR là thêm một khoảng
                    chết ngay giữa lúc đông khách.

                    Số tiền nhúng sẵn trong mã nên khách không gõ tay — cũng có
                    nghĩa là mã tự đổi theo giỏ, thêm bớt một ly là QR mới.      *@
                @if (_payment == 1)
                {
                    <div class="pos-qr">
                        @if (BankQr.IsConfigured)
                        {
                            <img class="pos-qr-img"
                                 src="@BankQr.ImageUrl(CartTotal, _payRef)"
                                 alt="Mã QR chuyển khoản @Money.Format(CartTotal)"
                                 width="360" height="360" />

                            <div class="stack stack-1 grow">
                                <span class="pos-qr-amount num">@Money.Format(CartTotal)</span>
                                <span class="xs muted">
                                    @BankQr.BankCode · <span class="num">@BankQr.AccountNumber</span>
                                </span>
                                @if (!string.IsNullOrWhiteSpace(BankQr.AccountName))
                                {
                                    <span class="xs muted">@BankQr.AccountName</span>
                                }

                                @*  Mã tham chiếu: hai khách liên tiếp cùng trả
                                    45.000đ thì thông báo ngân hàng giống hệt
                                    nhau. Có mã này thì đối chiếu được ngay.    *@
                                <span class="pos-qr-ref mono">@_payRef</span>
                            </div>
                        }
                        else
                        {
                            <div class="stack stack-1">
                                <span class="small" style="font-weight: 700;">Chưa cài số tài khoản</span>
                                <span class="xs muted">
                                    Điền <span class="mono">BANK_CODE</span> và
                                    <span class="mono">BANK_ACCOUNT_NUMBER</span> trong
                                    <span class="mono">.env</span>, chạy lại
                                    <span class="mono">scripts/gen-client-config.ps1</span>.
                                    Vẫn nhận đơn bình thường, chỉ là khách phải chuyển khoản thủ công.
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── CHỐT ĐƠN ────────────────────────────────────────────────── *@
            <div class="pos-checkout">
                <div class="row row-between">
                    <span style="font-weight: 700;">Tổng cộng</span>
                    <span class="price num" style="font-size: var(--text-xl);">
                        @Money.Format(CartTotal)
                    </span>
                </div>

                <button class="btn btn-primary btn-lg" style="width: 100%;"
                        @onclick="PlaceOrder" disabled="@_placing">
                    @if (_placing)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>Đang gửi…</span>
                    }
                    else
                    {
                        <CheckIcon Size="18" />
                        <span>Nhận đơn &amp; đưa vào pha</span>
                    }
                </button>
            </div>
        }

        @* ── ĐƠN VỪA NHẬN ────────────────────────────────────────────────
           Giữ lại trên màn hình sau khi chốt để nhân viên còn đọc mã đơn và
           thời gian cho khách nghe. Tự biến mất sau 20 giây. *@
        @if (_justPlaced is not null)
        {
            <div class="pos-receipt fade-in" role="status">
                <div class="row row-between">
                    <span class="mono" style="font-weight: 700;">@_justPlaced.Code</span>
                    <button class="btn btn-ghost btn-icon btn-sm" @onclick="() => _justPlaced = null"
                            aria-label="Đóng">×</button>
                </div>
                <span class="small">
                    @_justPlaced.TotalCups phần · @Money.Format(_justPlaced.GrandTotal)
                </span>
                <span class="pos-receipt-eta">
                    Báo khách: khoảng <strong class="num">@_justPlaced.EtaMinutes phút</strong>
                </span>

                @* Đơn trả bằng chuyển khoản: nhắc lại mã để đối chiếu với thông
                   báo ngân hàng, vốn hay về chậm hơn lúc chốt đơn vài giây. *@
                @if (_justPlacedRef is not null)
                {
                    <span class="xs muted">
                        Chuyển khoản · <span class="mono">@_justPlacedRef</span>
                    </span>
                }
                <a href="/admin/pha-che" class="btn btn-secondary btn-sm">
                    Xem hàng pha
                </a>
            </div>
        }
    </aside>
</div>

@code {
    private List<PosCategoryDto> _categories = new();
    private List<PosProductDto> _products = new();
    private readonly List<CartLine> _cart = new();

    private Guid? _activeCat;
    private string _search = "";
    private bool _loading = true;
    private bool _placing;

    private string _customerName = "";
    private int _orderType = 0;   // 0 = tại quán, 1 = mang đi
    private int _payment = 0;     // 0 = tiền mặt, 1 = chuyển khoản

    /// <summary>
    /// Mã tham chiếu in trong nội dung chuyển khoản của đơn đang bấm.
    ///
    /// Sinh MỘT LẦN cho mỗi đơn, không sinh lại mỗi lần vẽ: khách vừa quét xong
    /// mà nhân viên bấm thêm một ly, nếu mã đổi luôn thì tiền về mang mã cũ,
    /// đối chiếu hỏng. Số tiền trong QR thì được phép đổi theo giỏ — đó là điều
    /// khách nhìn thấy trước khi bấm xác nhận trên app ngân hàng.
    /// </summary>
    private string _payRef = BankQr.NewReference();

    private EtaDto? _eta;
    private bool _etaLoading;
    private PosOrderResultDto? _justPlaced;

    /// <summary>Mã tham chiếu của đơn vừa chốt, chỉ có khi đơn đó trả bằng chuyển khoản.</summary>
    private string? _justPlacedRef;

    private Timer? _receiptTimer;
    private CancellationTokenSource? _etaDebounce;

    /// <summary>
    /// Một dòng trong giỏ. Gộp theo món + size + GHI CHÚ.
    ///
    /// Ghi chú phải nằm trong khóa gộp: hai ly trà đào, một ly ít đá một ly bình
    /// thường, là hai dòng khác nhau — gộp lại thì người pha không biết ly nào
    /// theo ý nào. Ngược lại, bấm thêm một ly y hệt (chưa ghi chú gì) thì vẫn
    /// phải rơi vào đúng dòng chưa ghi chú đang có, chứ không đẻ ra dòng mới.
    /// Xem AddToCart để thấy quy tắc đó được áp dụng thế nào.
    /// </summary>
    private class CartLine
    {
        /// <summary>
        /// Định danh CỐ ĐỊNH suốt đời dòng giỏ, chỉ dùng cho @@key của Blazor.
        ///
        /// Trước đây @@key dùng "mã món:size". Từ khi ghi chú sửa được ngay trên
        /// dòng, khóa đó đổi giá trị giữa chừng lúc nhân viên đang gõ — Blazor
        /// coi đó là phần tử khác, dựng lại thẻ input và ô nhập MẤT CON TRỎ ngay
        /// sau ký tự đầu tiên. Khóa ổn định thì không bao giờ gặp chuyện đó.
        /// </summary>
        public Guid LineId { get; } = Guid.NewGuid();

        public Guid ProductId { get; set; }
        public Guid? VariantId { get; set; }
        public string Name { get; set; } = "";
        public string? VariantName { get; set; }
        public string ColorPrimaryHex { get; set; } = "#8B5E3C";
        public int UnitPrice { get; set; }
        public int Quantity { get; set; }
        public int MaxServings { get; set; } = 9999;
        public int LineTotal => UnitPrice * Quantity;

        // --- Ghi chú ---------------------------------------------------------
        /// <summary>Các ý chọn nhanh bằng nút bấm ("Ít đá", "Không ngọt"…).</summary>
        public List<string> Tags { get; } = new();

        /// <summary>Phần nhân viên tự gõ, cho những yêu cầu không có nút sẵn.</summary>
        public string FreeNote { get; set; } = "";

        /// <summary>Đang mở khay ghi chú hay không. Chỉ là trạng thái giao diện.</summary>
        public bool NoteOpen { get; set; }

        /// <summary>Ghi chú hoàn chỉnh gửi xuống backend và in ra màn hình pha chế.</summary>
        public string Note => string.Join(", ",
            Tags.Append(FreeNote.Trim()).Where(s => !string.IsNullOrWhiteSpace(s)));

        public bool HasNote => Tags.Count > 0 || !string.IsNullOrWhiteSpace(FreeNote);
    }

    // ── GHI CHÚ CHỌN NHANH ──────────────────────────────────────────────────
    //
    //  Bàn phím ảo trên máy tính bảng là kẻ thù của tốc độ ở quầy: mở lên đã
    //  che mất nửa màn hình, gõ "ít đá" mất vài giây trong lúc khách đứng chờ.
    //  Sáu ý dưới đây phủ gần hết yêu cầu thực tế của một quán cà phê — một
    //  chạm là xong. Ô gõ tay vẫn còn đó cho những trường hợp còn lại.
    //
    //  Group dùng để loại trừ nhau: chọn "Không đá" thì "Ít đá" và "Đá riêng"
    //  tự bỏ chọn, vì một ly không thể vừa không đá vừa ít đá. "Ít sữa" đứng
    //  riêng nên chọn kèm với bất kỳ ý nào cũng được.
    private static readonly (string Label, string Group)[] QuickNotes =
    {
        ("Ít đá",      "da"),
        ("Không đá",   "da"),
        ("Đá riêng",   "da"),
        ("Ít ngọt",    "ngot"),
        ("Không ngọt", "ngot"),
        ("Ít sữa",     "sua"),
    };

    private List<PosProductDto> Filtered
    {
        get
        {
            IEnumerable<PosProductDto> q = _products;

            if (_activeCat is Guid c) q = q.Where(p => p.CategoryId == c);

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(p => p.Name.Contains(s, StringComparison.OrdinalIgnoreCase));
            }

            // Món hết dồn xuống cuối — vẫn thấy được nhưng không chắn đường
            return q.OrderByDescending(p => p.IsAvailable).ToList();
        }
    }

    private int CartQty(Guid productId) => _cart.Where(l => l.ProductId == productId).Sum(l => l.Quantity);

    /// <summary>Tổng tiền đơn đang bấm — dùng cho cả dòng tổng cộng lẫn số tiền trong QR.</summary>
    private int CartTotal => _cart.Sum(l => l.LineTotal);

    /// <summary>
    /// Đổi hình thức thanh toán.
    ///
    /// Chuyển sang "Chuyển khoản" thì cấp mã tham chiếu mới, phòng trường hợp
    /// nhân viên bấm nhầm sang "Tiền mặt" rồi quay lại — lúc đó khách trước có
    /// thể đã quét mã cũ, dùng lại mã đó cho đơn mới là hai đơn chung một mã.
    /// </summary>
    private void SetPayment(int method)
    {
        if (method == 1 && _payment != 1) _payRef = BankQr.NewReference();
        _payment = method;
    }

    protected override async Task OnInitializedAsync() => await LoadMenuAsync();

    private async Task LoadMenuAsync()
    {
        _loading = true;
        var res = await Api.GetPosMenuAsync();
        if (res.Success && res.Data is not null)
        {
            _categories = res.Data.Categories;
            _products = res.Data.Products;
        }
        _loading = false;
    }

    // ── GIỎ HÀNG ────────────────────────────────────────────────────────────

    private void AddToCart(PosProductDto p)
    {
        // Size mặc định nếu món có nhiều size. Nhân viên đổi size ở giỏ nếu cần —
        // bắt chọn size ngay lúc bấm sẽ chậm hơn cho 80% trường hợp dùng size M.
        var variant = p.Variants.FirstOrDefault(v => v.IsDefault) ?? p.Variants.FirstOrDefault();

        // Số ly còn làm được tính trên TOÀN BỘ các dòng của món này, không phải
        // trên một dòng. Từ khi ghi chú tách dòng, ba ly cùng món có thể nằm ở ba
        // dòng riêng — kiểm tra từng dòng thì nhận đơn vượt quá nguyên liệu thật.
        if (CartQty(p.Id) >= p.MaxServings)
        {
            Alerts.Warning($"{p.Name} chỉ còn {p.MaxServings} ly.");
            return;
        }

        // Chỉ dồn vào dòng CHƯA có ghi chú. Dòng đã ghi "ít đá" là một yêu cầu
        // riêng của khách trước đó — cộng thêm ly mới vào đó là làm sai đơn.
        var line = _cart.FirstOrDefault(l => l.ProductId == p.Id
                                          && l.VariantId == variant?.Id
                                          && !l.HasNote);
        if (line is not null)
        {
            line.Quantity++;
        }
        else
        {
            _cart.Add(new CartLine
            {
                ProductId       = p.Id,
                VariantId       = variant?.Id,
                Name            = p.Name,
                VariantName     = variant?.Name,
                ColorPrimaryHex = p.ColorPrimaryHex,
                UnitPrice       = p.BasePrice + (variant?.PriceDelta ?? 0),
                Quantity        = 1,
                MaxServings     = p.MaxServings
            });
        }

        _ = RefreshEtaAsync();
    }

    private void Bump(CartLine line, int delta)
    {
        line.Quantity += delta;
        if (line.Quantity <= 0) _cart.Remove(line);
        _ = RefreshEtaAsync();
    }

    private void Remove(CartLine line)
    {
        _cart.Remove(line);
        _ = RefreshEtaAsync();
    }

    /// <summary>
    /// Dọn sạch để bắt đầu đơn của khách tiếp theo.
    ///
    /// Trả hình thức thanh toán về tiền mặt và cấp mã tham chiếu mới: mỗi khách
    /// một mã, dùng lại mã của khách trước là hai giao dịch không tách được ra.
    /// </summary>
    private void ClearCart()
    {
        _cart.Clear();
        _eta = null;
        _payment = 0;
        _payRef = BankQr.NewReference();
    }

    // ── GHI CHÚ TỪNG MÓN ────────────────────────────────────────────────────

    /// <summary>
    /// Mở/đóng khay ghi chú của một dòng. Mỗi lúc chỉ mở MỘT khay: giỏ hàng nằm
    /// trong cột hẹp và tự cuộn, mở cùng lúc ba khay thì đẩy nút chốt đơn ra
    /// khỏi tầm mắt — đúng thứ nhân viên cần bấm tiếp theo.
    /// </summary>
    private void ToggleNote(CartLine line)
    {
        var opening = !line.NoteOpen;
        foreach (var l in _cart) l.NoteOpen = false;
        line.NoteOpen = opening;
    }

    /// <summary>
    /// Bật/tắt một ý chọn nhanh. Chọn ý mới trong cùng nhóm thì ý cũ tự nhường
    /// chỗ — nhân viên không phải bỏ chọn thủ công trước khi chọn cái khác.
    /// </summary>
    private void ToggleTag(CartLine line, string label, string group)
    {
        if (line.Tags.Remove(label)) return;

        // Dọn các ý cùng nhóm rồi mới thêm — "Không đá" và "Ít đá" không thể
        // cùng đúng, để cả hai thì người pha phải đoán.
        var sameGroup = QuickNotes.Where(q => q.Group == group).Select(q => q.Label);
        line.Tags.RemoveAll(t => sameGroup.Contains(t));

        line.Tags.Add(label);
    }

    /// <summary>Xóa sạch ghi chú của một dòng và đóng khay lại.</summary>
    private void ClearNote(CartLine line)
    {
        line.Tags.Clear();
        line.FreeNote = "";
        line.NoteOpen = false;
    }

    // ── THỜI GIAN CHỜ ───────────────────────────────────────────────────────

    /// <summary>
    /// Hỏi lại backend mỗi khi giỏ đổi, nhưng chờ 250ms trước đã.
    /// Nhân viên bấm liên tiếp 5 ly thì chỉ cần một lần gọi, không phải năm.
    /// </summary>
    private async Task RefreshEtaAsync()
    {
        _etaDebounce?.Cancel();
        _etaDebounce = new CancellationTokenSource();
        var token = _etaDebounce.Token;

        if (_cart.Count == 0)
        {
            _eta = null;
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(250, token);

            _etaLoading = true;
            StateHasChanged();

            var items = _cart
                .GroupBy(l => l.ProductId)
                .Select(g => new EstimateItem(g.Key, g.Sum(x => x.Quantity)))
                .ToList();

            var res = await Api.EstimateEtaAsync(items);
            if (!token.IsCancellationRequested && res.Success)
                _eta = res.Data;
        }
        catch (TaskCanceledException)
        {
            // Giỏ đổi tiếp trước khi hết 250ms — lần gọi sau sẽ lo
        }
        finally
        {
            _etaLoading = false;
            StateHasChanged();
        }
    }

    // ── CHỐT ĐƠN ────────────────────────────────────────────────────────────

    private async Task PlaceOrder()
    {
        if (_cart.Count == 0) return;

        _placing = true;
        try
        {
            var req = new CreateOrderRequest
            {
                CustomerName = string.IsNullOrWhiteSpace(_customerName)
                    ? "Khách tại quầy"
                    : _customerName.Trim(),

                // Đơn tại quầy không cần số điện thoại — khách đứng ngay đó và
                // được gọi tên khi xong. Vẫn phải điền vì backend bắt buộc.
                CustomerPhone = "0000000000",
                OrderType     = _orderType,
                PaymentMethod = _payment,

                // Mã tham chiếu phải đi kèm đơn, đây chính là khóa để webhook
                // SePay tìm ngược ra đơn khi tiền về. Gửi đúng mã đã in trên QR
                // khách vừa quét — backend kiểm định dạng rồi lưu nguyên.
                PaymentRef    = _payment == 1 ? _payRef : null,

                Note          = null,
                Items         = _cart.Select(l => new CreateOrderItem
                {
                    ProductId   = l.ProductId,
                    VariantId   = l.VariantId,
                    Quantity    = l.Quantity,
                    ModifierIds = new List<Guid>(),

                    // null chứ không phải chuỗi rỗng: màn hình pha chế kiểm tra
                    // bằng IsNullOrEmpty rồi mới vẽ khung ghi chú, gửi "" xuống
                    // thì mỗi ly đều mọc một khung trống.
                    Note        = l.HasNote ? l.Note : null
                }).ToList()
            };

            var res = await Api.CreatePosOrderAsync(req);

            if (res.Success && res.Data is not null)
            {
                _justPlaced = res.Data;

                // Giữ lại mã tham chiếu TRƯỚC khi ClearCart cấp mã mới. Tiền có
                // thể về sau lúc chốt đơn vài giây, nhân viên vẫn cần đối chiếu
                // được thông báo ngân hàng với đúng đơn vừa nhận.
                _justPlacedRef = _payment == 1 ? _payRef : null;

                Alerts.Success($"Đơn {res.Data.Code} đã vào hàng pha — báo khách {res.Data.EtaMinutes} phút.");

                ClearCart();
                _customerName = "";

                // Nạp lại lưới: số ly còn làm được vừa giảm vì đơn mới đã chiếm chỗ
                await LoadMenuAsync();

                // Biên lai tự ẩn sau 20 giây để không chắn màn hình khách tiếp theo
                _receiptTimer?.Dispose();
                _receiptTimer = new Timer(_ =>
                {
                    _justPlaced = null;
                    InvokeAsync(StateHasChanged);
                }, null, 20_000, Timeout.Infinite);
            }
            else
            {
                Alerts.Error(res.Error?.Message ?? "Không nhận được đơn.");
            }
        }
        finally
        {
            _placing = false;
        }
    }

    public void Dispose()
    {
        _receiptTimer?.Dispose();
        _etaDebounce?.Cancel();
        _etaDebounce?.Dispose();
    }
}
