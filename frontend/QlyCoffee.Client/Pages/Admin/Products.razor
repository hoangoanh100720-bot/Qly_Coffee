@*
    =============================================================================
    TRANG DANH SÁCH MÓN
    =============================================================================
    Archetype: bảng dữ liệu dày.

    Cột quan trọng nhất là BIÊN LỢI NHUẬN — nó là số dẫn xuất từ công thức
    định lượng, và là thứ chủ quán cần nhìn để biết món nào đang gánh, món nào
    đang lỗ. Món chưa có công thức được đánh dấu riêng vì chúng không trừ được
    kho và không tính được giá vốn.
    =============================================================================
*@
@page "/admin/mon"
@layout AdminLayout
@attribute [Authorize(Roles = "Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts

<PageTitle>Món &amp; công thức — Một Chút Coffee</PageTitle>

<div class="stack stack-6">

    @* ── HÀNG TIÊU ĐỀ ────────────────────────────────────────────────────── *@
    <div class="row row-between row-wrap" style="gap: var(--space-4);">
        <div class="stack stack-1">
            <h2>Món &amp; công thức</h2>
            <span class="xs muted">
                Giá vốn là số tính từ công thức, không nhập tay — sửa công thức là giá vốn đổi theo
            </span>
        </div>
        <a href="/menu" target="_blank" class="btn btn-secondary btn-sm">
            <ExternalIcon Size="14" /> Xem trang bán hàng
        </a>
    </div>

    @* ── THẺ TỔNG QUAN ───────────────────────────────────────────────────── *@
    <div class="grid grid-stats">
        <div class="stat">
            <span class="stat-label">Tổng số món</span>
            <span class="stat-value">@_items.Count</span>
            <span class="stat-meta">@_items.Count(p => p.IsActive) đang bán</span>
        </div>
        <div class="stat @(_unavailable > 0 ? "stat-warn" : "stat-ok")">
            <span class="stat-label">Tạm hết</span>
            <span class="stat-value">@_unavailable</span>
            <span class="stat-meta">do thiếu nguyên liệu</span>
        </div>
        <div class="stat @(_noRecipe > 0 ? "stat-critical" : "")">
            <span class="stat-label">Chưa có công thức</span>
            <span class="stat-value">@_noRecipe</span>
            <span class="stat-meta">không trừ được kho</span>
        </div>
        <div class="stat">
            <span class="stat-label">Biên lợi nhuận TB</span>
            <span class="stat-value">@_avgMargin%</span>
            @* Hai mốc khác nhau vì hai nhóm định giá khác hẳn nhau: bánh nhập về
               nguyên cái nên biên thấp hơn đồ uống là bình thường, không phải lỗi. *@
            <span class="stat-meta">đồ uống 60–75% · đồ ăn 45–55%</span>
        </div>
    </div>

    @* ── LỌC & TÌM KIẾM ──────────────────────────────────────────────────── *@
    <div class="filter-bar" role="group" aria-label="Lọc món">
        @foreach (var f in Filters)
        {
            <button class="chip @(_activeFilter == f.Key ? "is-active" : "")"
                    @onclick="() => _activeFilter = f.Key"
                    aria-pressed="@(_activeFilter == f.Key)">
                @f.Label
                <span class="xs muted num">@CountFor(f.Key)</span>
            </button>
        }

        <div class="grow"></div>

        <div class="search-box">
            <SearchIcon Size="15" />
            <input type="search" class="input search-input"
                   placeholder="Tìm món…"
                   @bind="_search" @bind:event="oninput"
                   aria-label="Tìm món" />
        </div>
    </div>

    @* ── BẢNG ────────────────────────────────────────────────────────────── *@
    @if (_loading)
    {
        <div class="table-wrap">
            <div class="stack stack-3" style="padding: var(--space-4);" aria-busy="true">
                @for (int i = 0; i < 10; i++)
                {
                    <div class="skeleton skeleton-text" style="height: 40px;"></div>
                }
            </div>
        </div>
    }
    else if (Filtered.Count == 0)
    {
        <div class="empty">
            <CupIcon Size="48" CssClass="empty-icon" />
            <span class="empty-title">Không có món nào khớp</span>
            <span class="empty-text">Thử đổi bộ lọc hoặc xóa từ khóa tìm kiếm.</span>
        </div>
    }
    else
    {
        <p class="sr-only" aria-live="polite">Hiển thị @Filtered.Count món.</p>

        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Món</th>
                        <th>Danh mục</th>
                        <th class="num">Giá bán</th>
                        <th class="num">Giá vốn</th>
                        <th style="width: 160px;">Biên lợi nhuận</th>
                        <th class="num">Còn làm được</th>
                        <th style="width: 1%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Filtered)
                    {
                        <tr class="@RowClass(p)" @key="p.Id">

                            @*  Luôn là ảnh chụp: ảnh riêng của món nếu đã có, không thì
                                ảnh mẫu theo nhóm. Viền đứt và nhãn "Đang dùng ảnh mẫu"
                                bên cạnh mới là thứ phân biệt hai trường hợp — trước đây
                                dùng hình ly vẽ để phân biệt, nhưng vậy thì trang quản lý
                                lại hiện thứ khác hẳn thứ khách đang nhìn thấy. *@
                            <td>
                                <div class="ingredient-cell">
                                    <button class="photo-slot @(Media.HasPhoto(p.ImageUrl) ? "has-photo" : "no-photo")"
                                            @onclick="() => OpenPhoto(p)"
                                            title="@(Media.HasPhoto(p.ImageUrl) ? "Đổi ảnh" : "Thêm ảnh chụp riêng của quán")"
                                            aria-label="@($"Quản lý ảnh cho {p.Name}")">
                                        <img src="@DrinkPhoto.PhotoFor(p.ImageUrl, p.CategoryName, p.Name)"
                                             alt="" loading="lazy" decoding="async" />
                                        <span class="photo-slot-hint"><CameraIcon Size="13" /></span>
                                    </button>
                                    <div class="ingredient-meta">
                                        <span class="ingredient-name">@p.Name</span>
                                        <div class="row row-2">
                                            @if (!p.IsActive)
                                            {
                                                <span class="badge badge-neutral">Ngừng bán</span>
                                            }
                                            @if (!Media.HasPhoto(p.ImageUrl))
                                            {
                                                <span class="badge badge-neutral">Đang dùng ảnh mẫu</span>
                                            }
                                            @if (p.RecipeItemCount == 0)
                                            {
                                                <span class="badge badge-danger">Chưa có công thức</span>
                                            }
                                            else
                                            {
                                                <span class="xs muted">
                                                    @p.RecipeItemCount nguyên liệu
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td class="small muted">@p.CategoryName</td>

                            @*  Ô giá là ô DUY NHẤT trong bảng bấm được để sửa.
                                Đổi giá là việc làm hàng tuần — theo giá nguyên liệu,
                                theo mùa, theo đối thủ — nên không bắt đi vòng qua
                                màn hình soạn công thức, nơi dễ sửa nhầm định lượng. *@
                            <td class="num">
                                <button class="price-edit" @onclick="() => OpenPrice(p)"
                                        title="Điều chỉnh giá bán"
                                        aria-label="@($"Điều chỉnh giá bán của {p.Name}, hiện tại {Money.Format(p.BasePrice)}")">
                                    <span class="price-edit-value">@Money.Format(p.BasePrice)</span>
                                    <EditIcon Size="12" />
                                </button>
                                @if (p.RecipeItemCount > 0 && p.PriceVerdict <= 0)
                                {
                                    <div class="xs @(p.PriceVerdict < 0 ? "text-danger" : "text-warn")"
                                         style="margin-top: 2px;">
                                        @(p.PriceVerdict < 0 ? "đang bán lỗ" : "biên mỏng")
                                    </div>
                                }
                            </td>

                            <td class="num muted">
                                @if (p.RecipeItemCount == 0)
                                {
                                    <span class="xs">chưa tính được</span>
                                }
                                else
                                {
                                    @Money.Format(p.ComputedCost)
                                    <div class="xs muted" style="margin-top: 2px;">
                                        đề nghị @Money.Format(p.SuggestedPrice)
                                    </div>
                                }
                            </td>

                            @* Thanh biên lợi nhuận — mã hóa bằng cả màu, độ dài và số *@
                            <td>
                                @if (p.RecipeItemCount == 0)
                                {
                                    <span class="xs muted">—</span>
                                }
                                else
                                {
                                    <div class="stack stack-1">
                                        <div class="row row-between">
                                            <div class="meter grow">
                                                <div class="meter-fill"
                                                     style="width: @Math.Clamp(p.MarginPercent, 0, 100)%;
                                                            --meter-color: @MarginColor(p.MarginPercent);"
                                                     role="img"
                                                     aria-label="@($"Biên lợi nhuận {p.MarginPercent} phần trăm")"></div>
                                            </div>
                                            <span class="xs num @MarginTextClass(p.MarginPercent)"
                                                  style="min-width: 34px; text-align: right; font-weight: 700;">
                                                @p.MarginPercent%
                                            </span>
                                        </div>
                                    </div>
                                }
                            </td>

                            <td class="num">
                                @if (!p.IsAvailable)
                                {
                                    <div class="stack stack-1" style="align-items: flex-end;">
                                        <span class="badge badge-danger">Tạm hết</span>
                                        @if (!string.IsNullOrEmpty(p.UnavailableReason))
                                        {
                                            <span class="xs muted truncate" style="max-width: 140px;">
                                                @p.UnavailableReason
                                            </span>
                                        }
                                    </div>
                                }
                                else if (p.MaxServings <= 5)
                                {
                                    <span class="text-warn" style="font-weight: 600;">
                                        @p.MaxServings phần
                                    </span>
                                }
                                else if (p.MaxServings >= 9999)
                                {
                                    <span class="xs muted">không giới hạn</span>
                                }
                                else
                                {
                                    <span class="muted">@p.MaxServings phần</span>
                                }
                            </td>

                            <td>
                                <a href="/admin/mon/@p.Id/cong-thuc"
                                   class="btn @(p.RecipeItemCount == 0 ? "btn-primary" : "btn-ghost") btn-sm"
                                   title="Soạn công thức định lượng">
                                    @if (p.RecipeItemCount == 0)
                                    {
                                        <span>Soạn công thức</span>
                                    }
                                    else
                                    {
                                        <EditIcon Size="14" />
                                    }
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ══════════════════════════════════════════════════════════════════════════
   HỘP THOẠI ĐIỀU CHỈNH GIÁ BÁN

   Ba việc, đúng thứ tự người dùng cần:
     1. Cho biết giá vốn thật là bao nhiêu
     2. Gợi ý một mức giá, kèm lý do vì sao là mức đó
     3. Để người dùng gõ con số của MÌNH — hệ thống không quyết thay

   Hệ thống KHÔNG chặn giá thấp hơn giá vốn: quán có quyền bán lỗ một món để
   kéo khách hoặc xả nguyên liệu cận hạn. Nó chỉ nói ra hậu quả trước khi lưu.
   ══════════════════════════════════════════════════════════════════════════ *@
@if (_priceTarget is not null)
{
    <div class="modal-backdrop" @onclick="ClosePrice"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="price-title">

        <div class="stack stack-1">
            <h3 id="price-title">Điều chỉnh giá bán</h3>
            <span class="small muted">
                @_priceTarget.Name
                @if (_priceTarget.IsFood)
                {
                    <span class="badge badge-neutral" style="margin-left: var(--space-2);">Đồ ăn</span>
                }
            </span>
        </div>

        @if (_priceTarget.RecipeItemCount == 0)
        {
            <div class="alert alert-warn" role="alert">
                <WarnIcon Size="16" />
                <span class="small">
                    Món chưa có công thức nên chưa tính được giá vốn — không có cơ sở
                    để gợi ý giá. Soạn công thức trước rồi hãy định giá.
                </span>
            </div>
        }

        @* ── Ô nhập giá ────────────────────────────────────────────────── *@
        <div class="field">
            <label class="field-label" for="new-price">Giá bán (đồng)</label>
            <input id="new-price" type="number" class="input input-num"
                   min="1000" step="1000" inputmode="numeric"
                   @bind="_priceInput" @bind:event="oninput"
                   disabled="@_priceBusy" />
            <span class="field-hint">Giá của size mặc định. Size L cộng thêm theo biến thể.</span>
        </div>

        @if (_priceTarget.RecipeItemCount > 0)
        {
            @* ── Bảng lãi lỗ cập nhật theo từng phím gõ ─────────────────── *@
            <div class="pl-table">
                <div class="pl-row">
                    <span class="pl-label">Giá vốn nguyên liệu</span>
                    <span class="pl-value num">@Money.Format(_priceTarget.ComputedCost)</span>
                </div>
                <div class="pl-row">
                    <span class="pl-label">Lãi gộp một phần</span>
                    <span class="pl-value num @(PreviewProfit < 0 ? "pl-negative" : "pl-positive")">
                        @Money.FormatSigned(PreviewProfit)
                    </span>
                </div>
                <div class="pl-row">
                    <span class="pl-label">
                        Tỷ lệ giá vốn
                        <span class="xs muted">
                            (chuẩn nhóm @_priceTarget.TargetCostRatioPercent%)
                        </span>
                    </span>
                    <span class="pl-value num @PreviewRatioClass">@PreviewRatio%</span>
                </div>
                <div class="pl-row pl-total">
                    <span class="pl-label">Biên lợi nhuận</span>
                    <span class="pl-value num">@PreviewMargin%</span>
                </div>
            </div>

            <p class="small @PreviewRatioClass" role="status">@PreviewVerdictText</p>

            @* ── Giá đề nghị ────────────────────────────────────────────── *@
            <div class="row row-between row-wrap" style="gap: var(--space-3);">
                <div class="stack stack-1">
                    <span class="xs muted">Giá đề nghị</span>
                    <span class="num" style="font-weight: 700; font-size: var(--text-lg);">
                        @Money.Format(_priceTarget.SuggestedPrice)
                    </span>
                </div>
                <button class="btn btn-secondary btn-sm"
                        @onclick="() => _priceInput = _priceTarget.SuggestedPrice"
                        disabled="@_priceBusy">
                    Dùng giá đề nghị
                </button>
            </div>

            <p class="xs muted">
                Tính bằng giá vốn chia cho tỷ lệ @_priceTarget.TargetCostRatioPercent%, làm tròn lên
                bội số 1.000đ. Phần chênh KHÔNG phải lãi — nó gánh mặt bằng, điện nước,
                lương pha chế và hao hụt.
                @if (_priceTarget.IsFood)
                {
                    <text>
                        Đồ ăn để mức 45% chứ không phải 30% như đồ uống, vì bánh nhập về
                        nguyên cái — quán không tạo thêm giá trị bằng tay nghề pha chế.
                    </text>
                }
            </p>
        }

        @if (!string.IsNullOrEmpty(_priceError))
        {
            <div class="alert alert-danger" role="alert">
                <WarnIcon Size="16" />
                <span class="small">@_priceError</span>
            </div>
        }

        <div class="row row-between" style="padding-top: var(--space-2); border-top: 1px solid var(--border);">
            <button class="btn btn-ghost" @onclick="ClosePrice" disabled="@_priceBusy">Hủy</button>
            <button class="btn btn-primary" @onclick="SavePriceAsync"
                    disabled="@(_priceBusy || _priceInput <= 0 || _priceInput == _priceTarget.BasePrice)">
                @if (_priceBusy)
                {
                    <SpinnerIcon Size="16" /> <span>Đang lưu…</span>
                }
                else
                {
                    <span>Lưu giá mới</span>
                }
            </button>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════════════════════
   HỘP THOẠI ẢNH MÓN

   Hai đường vào ảnh, vì hai tình huống khác nhau:
     · Tải file  — ảnh chụp bằng điện thoại tại quán (đường dùng chính)
     · Dán link  — ảnh đã nằm trên CDN hoặc kho ảnh, không cần tải lại
   ══════════════════════════════════════════════════════════════════════════ *@
@if (_photoTarget is not null)
{
    <div class="modal-backdrop" @onclick="ClosePhoto"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="photo-title">

        <div class="stack stack-1">
            <h3 id="photo-title">Ảnh món</h3>
            <span class="small muted">@_photoTarget.Name</span>
        </div>

        @* ── Xem trước ─────────────────────────────────────────────────── *@
        <div class="photo-preview">
            @if (!string.IsNullOrEmpty(_photoPreviewUrl))
            {
                <img src="@_photoPreviewUrl" alt="Xem trước ảnh @_photoTarget.Name" />
            }
            else
            {
                @*  Chưa có ảnh riêng thì xem trước ĐÚNG tấm ảnh mẫu mà khách đang
                    nhìn thấy trên thực đơn, kèm câu nói rõ đó là ảnh dùng chung cho
                    cả nhóm. Trước đây chỗ này hiện hình ly vẽ — một thứ không còn
                    xuất hiện ở đâu trên trang bán hàng nữa. *@
                <img src="@DrinkPhoto.FallbackFor(_photoTarget.CategoryName, _photoTarget.Name)"
                     alt="Ảnh mẫu đang dùng cho @_photoTarget.Name" />
            }
        </div>

        @if (_photoBusy)
        {
            <div class="row row-2" aria-live="polite">
                <span class="spinner" aria-hidden="true"></span>
                <span class="small muted">Đang tải ảnh lên…</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_photoError))
        {
            <div class="alert alert-danger" role="alert">
                <WarnIcon Size="16" />
                <span class="small">@_photoError</span>
            </div>
        }

        @* ── Cách 1: tải file ──────────────────────────────────────────── *@
        <div class="field">
            <label class="field-label" for="photo-file">Tải ảnh từ máy</label>
            <InputFile id="photo-file" class="input" OnChange="OnPhotoSelected"
                       accept="image/jpeg,image/png,image/webp" disabled="@_photoBusy" />
            <span class="field-hint">
                JPG, PNG hoặc WebP, tối đa @MaxUploadMb MB.
                Chụp thẳng từ trên xuống hoặc ngang tầm mắt, nền sáng đều.
            </span>
        </div>

        @* ── Cách 2: dán đường dẫn ─────────────────────────────────────── *@
        <div class="field">
            <label class="field-label" for="photo-url">Hoặc dán đường dẫn ảnh</label>
            <div class="row row-2">
                <input id="photo-url" type="url" class="input grow"
                       placeholder="https://..." @bind="_photoUrlInput"
                       disabled="@_photoBusy" />
                <button class="btn btn-secondary" @onclick="ApplyPhotoUrl"
                        disabled="@(_photoBusy || string.IsNullOrWhiteSpace(_photoUrlInput))">
                    Áp dụng
                </button>
            </div>
        </div>

        @* ── Hành động ─────────────────────────────────────────────────── *@
        <div class="row row-between" style="padding-top: var(--space-2); border-top: 1px solid var(--border);">
            @if (Media.HasPhoto(_photoTarget.ImageUrl))
            {
                <button class="btn btn-ghost btn-sm text-danger" @onclick="RemovePhoto" disabled="@_photoBusy">
                    <TrashIcon Size="14" /> Gỡ ảnh, dùng ảnh mẫu
                </button>
            }
            else
            {
                <span></span>
            }
            <button class="btn btn-secondary" @onclick="ClosePhoto" disabled="@_photoBusy">Đóng</button>
        </div>
    </div>
}

@code {
    private List<ProductAdminDto> _items = new();
    private bool _loading = true;
    private string _activeFilter = "all";
    private string _search = "";

    // ── Trạng thái hộp thoại giá ──────────────────────────────────────────
    private ProductAdminDto? _priceTarget;
    private int _priceInput;
    private string? _priceError;
    private bool _priceBusy;

    private void OpenPrice(ProductAdminDto p)
    {
        _priceTarget = p;
        _priceInput  = p.BasePrice;
        _priceError  = null;
    }

    private void ClosePrice()
    {
        _priceTarget = null;
        _priceError  = null;
    }

    // Ba số xem trước, tính lại theo TỪNG PHÍM GÕ. Dùng chính hàm mà backend
    // dùng (QlyCoffee.Shared.Pricing) nên số xem trước và số sau khi lưu bằng nhau.
    private int PreviewProfit => _priceTarget is null ? 0 : _priceInput - _priceTarget.ComputedCost;
    private int PreviewMargin => _priceTarget is null ? 0 : Pricing.MarginPercent(_priceInput, _priceTarget.ComputedCost);
    private int PreviewRatio  => _priceTarget is null ? 0 : Pricing.CostRatioPercent(_priceInput, _priceTarget.ComputedCost);

    private int PreviewVerdict => _priceTarget is null
        ? 0
        : Pricing.Verdict(_priceInput, _priceTarget.ComputedCost, _priceTarget.TargetCostRatioPercent);

    private string PreviewRatioClass => PreviewVerdict switch
    {
        -1 => "text-danger",
        0  => "text-warn",
        _  => "muted"
    };

    private string PreviewVerdictText => PreviewVerdict switch
    {
        -1 => "Giá này thấp hơn giá vốn — mỗi phần bán ra là một phần lỗ. "
            + "Chỉ nên dùng khi cố ý xả nguyên liệu cận hạn.",
        0  => $"Biên mỏng hơn chuẩn nhóm ({_priceTarget?.TargetCostRatioPercent}% giá vốn). "
            + "Đủ trả nguyên liệu nhưng còn ít cho mặt bằng và nhân công.",
        2  => "Cao hơn mặt bằng ngành. Lãi tốt, nhưng kiểm tra xem giá có còn cạnh tranh "
            + "với quán xung quanh không.",
        _  => "Mức giá lành mạnh: đủ gánh chi phí vận hành và vẫn cạnh tranh."
    };

    /// <summary>
    /// Lưu giá mới. Backend trả về bản DTO đã cập nhật nên bảng vẽ lại đúng
    /// biên lợi nhuận mới mà không phải nạp lại toàn bộ danh sách.
    /// </summary>
    private async Task SavePriceAsync()
    {
        if (_priceTarget is null) return;

        _priceBusy = true;
        _priceError = null;
        try
        {
            var res = await Api.UpdateProductPriceAsync(_priceTarget.Id, _priceInput);

            if (res.Success && res.Data is not null)
            {
                var idx = _items.FindIndex(x => x.Id == res.Data.Id);
                if (idx >= 0) _items[idx] = res.Data;

                RecomputeStats();
                Alerts.Success($"Đã đổi giá {res.Data.Name} thành {Money.Format(res.Data.BasePrice)}.");
                ClosePrice();
            }
            else
            {
                _priceError = res.Error?.Message ?? "Không lưu được giá mới.";
            }
        }
        finally { _priceBusy = false; }
    }

    // ── Trạng thái hộp thoại ảnh ──────────────────────────────────────────
    private ProductAdminDto? _photoTarget;
    private string? _photoPreviewUrl;
    private string _photoUrlInput = "";
    private string? _photoError;
    private bool _photoBusy;

    private const int MaxUploadMb = 5;

    private void OpenPhoto(ProductAdminDto p)
    {
        _photoTarget     = p;
        _photoPreviewUrl = Media.Resolve(p.ImageUrl);
        _photoUrlInput   = p.ImageUrl?.StartsWith("http") == true ? p.ImageUrl : "";
        _photoError      = null;
    }

    private void ClosePhoto()
    {
        _photoTarget     = null;
        _photoPreviewUrl = null;
        _photoUrlInput   = "";
        _photoError      = null;
    }

    /// <summary>
    /// Kiểm tra ngay ở trình duyệt trước khi tải lên. Backend vẫn kiểm lại đầy
    /// đủ — kiểm ở đây chỉ để người dùng biết ngay, không phải chờ đi về mạng.
    /// </summary>
    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (_photoTarget is null) return;

        var file = e.File;
        _photoError = null;

        if (file.Size > MaxUploadMb * 1024L * 1024L)
        {
            _photoError = $"Ảnh {file.Size / 1024 / 1024}MB, vượt giới hạn {MaxUploadMb}MB. " +
                          "Chụp lại ở chế độ chất lượng thấp hơn hoặc nén bớt.";
            return;
        }

        if (file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
        {
            _photoError = "Chỉ nhận ảnh JPG, PNG hoặc WebP.";
            return;
        }

        _photoBusy = true;
        try
        {
            // OpenReadStream mặc định chỉ cho 512KB nên phải nâng hạn mức lên
            await using var stream = file.OpenReadStream(MaxUploadMb * 1024L * 1024L);

            var res = await Api.UploadProductImageAsync(
                _photoTarget.Id, stream, file.Name, file.ContentType);

            if (res.Success && res.Data is not null)
            {
                ApplyNewImage(res.Data.Url);
                Alerts.Success($"Đã cập nhật ảnh cho {_photoTarget.Name} ({res.Data.SizeKb} KB).");
            }
            else
            {
                _photoError = res.Error?.Message ?? "Không tải được ảnh lên.";
            }
        }
        finally
        {
            _photoBusy = false;
        }
    }

    private async Task ApplyPhotoUrl()
    {
        if (_photoTarget is null || string.IsNullOrWhiteSpace(_photoUrlInput)) return;

        _photoBusy = true;
        _photoError = null;
        try
        {
            var res = await Api.SetProductImageUrlAsync(_photoTarget.Id, _photoUrlInput.Trim());
            if (res.Success && res.Data is not null)
            {
                ApplyNewImage(res.Data.Url);
                Alerts.Success($"Đã gán ảnh cho {_photoTarget.Name}.");
            }
            else
            {
                _photoError = res.Error?.Message ?? "Không gán được đường dẫn ảnh.";
            }
        }
        finally { _photoBusy = false; }
    }

    private async Task RemovePhoto()
    {
        if (_photoTarget is null) return;

        _photoBusy = true;
        _photoError = null;
        try
        {
            var res = await Api.RemoveProductImageAsync(_photoTarget.Id);
            if (res.Success)
            {
                ApplyNewImage(null);
                Alerts.Info($"{_photoTarget.Name} quay về dùng ảnh mẫu theo nhóm.");
            }
            else
            {
                _photoError = res.Error?.Message ?? "Không gỡ được ảnh.";
            }
        }
        finally { _photoBusy = false; }
    }

    /// <summary>
    /// Cập nhật ảnh mới vào cả bảng lẫn hộp thoại mà không phải nạp lại toàn
    /// bộ danh sách — record là kiểu bất biến nên phải thay bằng bản sao.
    /// </summary>
    private void ApplyNewImage(string? newUrl)
    {
        if (_photoTarget is null) return;

        var updated = _photoTarget with { ImageUrl = newUrl };
        var idx = _items.FindIndex(x => x.Id == updated.Id);
        if (idx >= 0) _items[idx] = updated;

        _photoTarget     = updated;
        _photoPreviewUrl = Media.Resolve(newUrl);
    }

    private int _unavailable, _noRecipe, _avgMargin;

    private record FilterDef(string Key, string Label);

    private static readonly FilterDef[] Filters =
    {
        new("all",        "Tất cả"),
        new("drink",      "Đồ uống"),
        // Đồ ăn tách riêng vì cách định giá KHÁC HẲN đồ uống: bánh nhập về nguyên
        // cái nên tỷ lệ giá vốn mục tiêu là 45% chứ không phải 30%. Lọc chung một
        // rổ thì mọi món bánh đều bị bảng "biên thấp" tô đỏ oan.
        new("food",       "Đồ ăn"),
        new("unavailable","Tạm hết"),
        new("no-recipe",  "Chưa có công thức"),
        new("no-photo",   "Chưa có ảnh"),
        new("low-margin", "Biên thấp"),
        new("inactive",   "Ngừng bán")
    };

    private List<ProductAdminDto> Filtered
    {
        get
        {
            IEnumerable<ProductAdminDto> q = _items;

            q = _activeFilter switch
            {
                "drink"       => q.Where(p => !p.IsFood),
                "food"        => q.Where(p => p.IsFood),
                "unavailable" => q.Where(p => !p.IsAvailable && p.IsActive),
                "no-recipe"   => q.Where(p => p.RecipeItemCount == 0),
                "no-photo"    => q.Where(p => !Media.HasPhoto(p.ImageUrl)),
                // "Biên thấp" so với chuẩn CỦA NHÓM ĐÓ, không phải một ngưỡng chung:
                // biên 55% của một chiếc croissant là lành mạnh, của một ly cà phê thì không.
                "low-margin"  => q.Where(p => p.RecipeItemCount > 0 && p.PriceVerdict <= 0),
                "inactive"    => q.Where(p => !p.IsActive),
                _             => q
            };

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim().ToLowerInvariant();
                q = q.Where(p => p.Name.ToLowerInvariant().Contains(s)
                              || p.CategoryName.ToLowerInvariant().Contains(s));
            }

            // Món có vấn đề lên đầu để chủ quán thấy ngay
            return q.OrderByDescending(p => p.RecipeItemCount == 0)
                    .ThenByDescending(p => !p.IsAvailable)
                    .ThenBy(p => p.CategoryName)
                    .ThenBy(p => p.Name)
                    .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.GetAdminProductsAsync();
        _items = res.Success && res.Data is not null ? res.Data : new();

        RecomputeStats();
        _loading = false;
    }

    /// <summary>
    /// Tính lại ba thẻ tổng quan. Gọi cả sau khi đổi giá, vì đổi giá làm biên
    /// lợi nhuận trung bình thay đổi ngay lập tức.
    /// </summary>
    private void RecomputeStats()
    {
        _unavailable = _items.Count(p => !p.IsAvailable && p.IsActive);
        _noRecipe    = _items.Count(p => p.RecipeItemCount == 0);

        // Chỉ tính trung bình trên món ĐÃ có công thức — món chưa có
        // thì giá vốn bằng 0 và sẽ kéo biên lên 100%, làm sai số liệu.
        var withRecipe = _items.Where(p => p.RecipeItemCount > 0).ToList();
        _avgMargin = withRecipe.Count > 0
            ? (int)Math.Round(withRecipe.Average(p => p.MarginPercent))
            : 0;
    }

    private int CountFor(string key) => key switch
    {
        "drink"       => _items.Count(p => !p.IsFood),
        "food"        => _items.Count(p => p.IsFood),
        "unavailable" => _unavailable,
        "no-recipe"   => _noRecipe,
        "no-photo"    => _items.Count(p => !Media.HasPhoto(p.ImageUrl)),
        "low-margin"  => _items.Count(p => p.RecipeItemCount > 0 && p.PriceVerdict <= 0),
        "inactive"    => _items.Count(p => !p.IsActive),
        _             => _items.Count
    };

    private static string RowClass(ProductAdminDto p)
        => p.RecipeItemCount == 0 ? "row-critical"
         : !p.IsAvailable ? "row-warn"
         : "";

    private static string MarginColor(int margin)
        => margin < 0  ? "var(--danger)"
         : margin < 40 ? "var(--warn)"
         : margin < 60 ? "hsl(45 80% 45%)"
         : "var(--ok)";

    private static string MarginTextClass(int margin)
        => margin < 0  ? "text-danger"
         : margin < 40 ? "text-warn"
         : "muted";
}
