@*
    =============================================================================
    TRANG DANH SÁCH MÓN
    =============================================================================
    Archetype: bảng dữ liệu dày.

    Cột quan trọng nhất là BIÊN LỢI NHUẬN — nó là số dẫn xuất từ công thức
    định lượng, và là thứ chủ quán cần nhìn để biết món nào đang gánh, món nào
    đang lỗ. Món chưa có công thức được đánh dấu riêng vì chúng không trừ được
    kho và không tính được giá vốn.
    =============================================================================
*@
@page "/admin/mon"
@layout AdminLayout
@attribute [Authorize(Roles = "Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts

<PageTitle>Món &amp; công thức — Qly Coffee</PageTitle>

<div class="stack stack-6">

    @* ── HÀNG TIÊU ĐỀ ────────────────────────────────────────────────────── *@
    <div class="row row-between row-wrap" style="gap: var(--space-4);">
        <div class="stack stack-1">
            <h2>Món &amp; công thức</h2>
            <span class="xs muted">
                Giá vốn là số tính từ công thức, không nhập tay — sửa công thức là giá vốn đổi theo
            </span>
        </div>
        <a href="/menu" target="_blank" class="btn btn-secondary btn-sm">
            <ExternalIcon Size="14" /> Xem trang bán hàng
        </a>
    </div>

    @* ── THẺ TỔNG QUAN ───────────────────────────────────────────────────── *@
    <div class="grid grid-stats">
        <div class="stat">
            <span class="stat-label">Tổng số món</span>
            <span class="stat-value">@_items.Count</span>
            <span class="stat-meta">@_items.Count(p => p.IsActive) đang bán</span>
        </div>
        <div class="stat @(_unavailable > 0 ? "stat-warn" : "stat-ok")">
            <span class="stat-label">Tạm hết</span>
            <span class="stat-value">@_unavailable</span>
            <span class="stat-meta">do thiếu nguyên liệu</span>
        </div>
        <div class="stat @(_noRecipe > 0 ? "stat-critical" : "")">
            <span class="stat-label">Chưa có công thức</span>
            <span class="stat-value">@_noRecipe</span>
            <span class="stat-meta">không trừ được kho</span>
        </div>
        <div class="stat">
            <span class="stat-label">Biên lợi nhuận TB</span>
            <span class="stat-value">@_avgMargin%</span>
            <span class="stat-meta">mặt bằng ngành 60–75%</span>
        </div>
    </div>

    @* ── LỌC & TÌM KIẾM ──────────────────────────────────────────────────── *@
    <div class="filter-bar" role="group" aria-label="Lọc món">
        @foreach (var f in Filters)
        {
            <button class="chip @(_activeFilter == f.Key ? "is-active" : "")"
                    @onclick="() => _activeFilter = f.Key"
                    aria-pressed="@(_activeFilter == f.Key)">
                @f.Label
                <span class="xs muted num">@CountFor(f.Key)</span>
            </button>
        }

        <div class="grow"></div>

        <div class="search-box">
            <SearchIcon Size="15" />
            <input type="search" class="input search-input"
                   placeholder="Tìm món…"
                   @bind="_search" @bind:event="oninput"
                   aria-label="Tìm món" />
        </div>
    </div>

    @* ── BẢNG ────────────────────────────────────────────────────────────── *@
    @if (_loading)
    {
        <div class="table-wrap">
            <div class="stack stack-3" style="padding: var(--space-4);" aria-busy="true">
                @for (int i = 0; i < 10; i++)
                {
                    <div class="skeleton skeleton-text" style="height: 40px;"></div>
                }
            </div>
        </div>
    }
    else if (Filtered.Count == 0)
    {
        <div class="empty">
            <CupIcon Size="48" CssClass="empty-icon" />
            <span class="empty-title">Không có món nào khớp</span>
            <span class="empty-text">Thử đổi bộ lọc hoặc xóa từ khóa tìm kiếm.</span>
        </div>
    }
    else
    {
        <p class="sr-only" aria-live="polite">Hiển thị @Filtered.Count món.</p>

        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Món</th>
                        <th>Danh mục</th>
                        <th class="num">Giá bán</th>
                        <th class="num">Giá vốn</th>
                        <th style="width: 160px;">Biên lợi nhuận</th>
                        <th class="num">Còn làm được</th>
                        <th style="width: 1%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Filtered)
                    {
                        <tr class="@RowClass(p)" @key="p.Id">

                            @* Ảnh chụp thật nếu có; chưa có thì dùng ly vẽ tô đúng màu món.
                               Viền đứt nhắc rằng đây là hình tạm, chưa phải ảnh thật. *@
                            <td>
                                <div class="ingredient-cell">
                                    <button class="photo-slot @(Media.HasPhoto(p.ImageUrl) ? "has-photo" : "no-photo")"
                                            @onclick="() => OpenPhoto(p)"
                                            title="@(Media.HasPhoto(p.ImageUrl) ? "Đổi ảnh" : "Thêm ảnh chụp thật")"
                                            aria-label="@($"Quản lý ảnh cho {p.Name}")">
                                        @if (Media.HasPhoto(p.ImageUrl))
                                        {
                                            <img src="@Media.Resolve(p.ImageUrl)" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <DrinkGlass DrinkColor="@p.ColorPrimaryHex"
                                                        FoamColor="@p.ColorAccentHex"
                                                        Size="30" AriaLabel="" />
                                        }
                                        <span class="photo-slot-hint"><CameraIcon Size="13" /></span>
                                    </button>
                                    <div class="ingredient-meta">
                                        <span class="ingredient-name">@p.Name</span>
                                        <div class="row row-2">
                                            @if (!p.IsActive)
                                            {
                                                <span class="badge badge-neutral">Ngừng bán</span>
                                            }
                                            @if (!Media.HasPhoto(p.ImageUrl))
                                            {
                                                <span class="badge badge-neutral">Chưa có ảnh</span>
                                            }
                                            @if (p.RecipeItemCount == 0)
                                            {
                                                <span class="badge badge-danger">Chưa có công thức</span>
                                            }
                                            else
                                            {
                                                <span class="xs muted">
                                                    @p.RecipeItemCount nguyên liệu
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td class="small muted">@p.CategoryName</td>

                            <td class="num" style="font-weight: 600;">@Money.Format(p.BasePrice)</td>

                            <td class="num muted">
                                @if (p.RecipeItemCount == 0)
                                {
                                    <span class="xs">chưa tính được</span>
                                }
                                else
                                {
                                    @Money.Format(p.ComputedCost)
                                }
                            </td>

                            @* Thanh biên lợi nhuận — mã hóa bằng cả màu, độ dài và số *@
                            <td>
                                @if (p.RecipeItemCount == 0)
                                {
                                    <span class="xs muted">—</span>
                                }
                                else
                                {
                                    <div class="stack stack-1">
                                        <div class="row row-between">
                                            <div class="meter grow">
                                                <div class="meter-fill"
                                                     style="width: @Math.Clamp(p.MarginPercent, 0, 100)%;
                                                            --meter-color: @MarginColor(p.MarginPercent);"
                                                     role="img"
                                                     aria-label="@($"Biên lợi nhuận {p.MarginPercent} phần trăm")"></div>
                                            </div>
                                            <span class="xs num @MarginTextClass(p.MarginPercent)"
                                                  style="min-width: 34px; text-align: right; font-weight: 700;">
                                                @p.MarginPercent%
                                            </span>
                                        </div>
                                    </div>
                                }
                            </td>

                            <td class="num">
                                @if (!p.IsAvailable)
                                {
                                    <div class="stack stack-1" style="align-items: flex-end;">
                                        <span class="badge badge-danger">Tạm hết</span>
                                        @if (!string.IsNullOrEmpty(p.UnavailableReason))
                                        {
                                            <span class="xs muted truncate" style="max-width: 140px;">
                                                @p.UnavailableReason
                                            </span>
                                        }
                                    </div>
                                }
                                else if (p.MaxServings <= 5)
                                {
                                    <span class="text-warn" style="font-weight: 600;">
                                        @p.MaxServings ly
                                    </span>
                                }
                                else if (p.MaxServings >= 9999)
                                {
                                    <span class="xs muted">không giới hạn</span>
                                }
                                else
                                {
                                    <span class="muted">@p.MaxServings ly</span>
                                }
                            </td>

                            <td>
                                <a href="/admin/mon/@p.Id/cong-thuc"
                                   class="btn @(p.RecipeItemCount == 0 ? "btn-primary" : "btn-ghost") btn-sm"
                                   title="Soạn công thức định lượng">
                                    @if (p.RecipeItemCount == 0)
                                    {
                                        <span>Soạn công thức</span>
                                    }
                                    else
                                    {
                                        <EditIcon Size="14" />
                                    }
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ══════════════════════════════════════════════════════════════════════════
   HỘP THOẠI ẢNH MÓN

   Hai đường vào ảnh, vì hai tình huống khác nhau:
     · Tải file  — ảnh chụp bằng điện thoại tại quán (đường dùng chính)
     · Dán link  — ảnh đã nằm trên CDN hoặc kho ảnh, không cần tải lại
   ══════════════════════════════════════════════════════════════════════════ *@
@if (_photoTarget is not null)
{
    <div class="modal-backdrop" @onclick="ClosePhoto"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="photo-title">

        <div class="stack stack-1">
            <h3 id="photo-title">Ảnh món</h3>
            <span class="small muted">@_photoTarget.Name</span>
        </div>

        @* ── Xem trước ─────────────────────────────────────────────────── *@
        <div class="photo-preview">
            @if (!string.IsNullOrEmpty(_photoPreviewUrl))
            {
                <img src="@_photoPreviewUrl" alt="Xem trước ảnh @_photoTarget.Name" />
            }
            else
            {
                <div class="photo-preview-empty"
                     style="--drink: @_photoTarget.ColorPrimaryHex;">
                    <DrinkGlass DrinkColor="@_photoTarget.ColorPrimaryHex"
                                FoamColor="@_photoTarget.ColorAccentHex"
                                Size="84" AriaLabel="" />
                    <span class="xs muted">Đang dùng hình vẽ</span>
                </div>
            }
        </div>

        @if (_photoBusy)
        {
            <div class="row row-2" aria-live="polite">
                <span class="spinner" aria-hidden="true"></span>
                <span class="small muted">Đang tải ảnh lên…</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_photoError))
        {
            <div class="alert alert-danger" role="alert">
                <WarnIcon Size="16" />
                <span class="small">@_photoError</span>
            </div>
        }

        @* ── Cách 1: tải file ──────────────────────────────────────────── *@
        <div class="field">
            <label class="field-label" for="photo-file">Tải ảnh từ máy</label>
            <InputFile id="photo-file" class="input" OnChange="OnPhotoSelected"
                       accept="image/jpeg,image/png,image/webp" disabled="@_photoBusy" />
            <span class="field-hint">
                JPG, PNG hoặc WebP, tối đa @MaxUploadMb MB.
                Chụp thẳng từ trên xuống hoặc ngang tầm mắt, nền sáng đều.
            </span>
        </div>

        @* ── Cách 2: dán đường dẫn ─────────────────────────────────────── *@
        <div class="field">
            <label class="field-label" for="photo-url">Hoặc dán đường dẫn ảnh</label>
            <div class="row row-2">
                <input id="photo-url" type="url" class="input grow"
                       placeholder="https://..." @bind="_photoUrlInput"
                       disabled="@_photoBusy" />
                <button class="btn btn-secondary" @onclick="ApplyPhotoUrl"
                        disabled="@(_photoBusy || string.IsNullOrWhiteSpace(_photoUrlInput))">
                    Áp dụng
                </button>
            </div>
        </div>

        @* ── Hành động ─────────────────────────────────────────────────── *@
        <div class="row row-between" style="padding-top: var(--space-2); border-top: 1px solid var(--border);">
            @if (Media.HasPhoto(_photoTarget.ImageUrl))
            {
                <button class="btn btn-ghost btn-sm text-danger" @onclick="RemovePhoto" disabled="@_photoBusy">
                    <TrashIcon Size="14" /> Gỡ ảnh, dùng hình vẽ
                </button>
            }
            else
            {
                <span></span>
            }
            <button class="btn btn-secondary" @onclick="ClosePhoto" disabled="@_photoBusy">Đóng</button>
        </div>
    </div>
}

@code {
    private List<ProductAdminDto> _items = new();
    private bool _loading = true;
    private string _activeFilter = "all";
    private string _search = "";

    // ── Trạng thái hộp thoại ảnh ──────────────────────────────────────────
    private ProductAdminDto? _photoTarget;
    private string? _photoPreviewUrl;
    private string _photoUrlInput = "";
    private string? _photoError;
    private bool _photoBusy;

    private const int MaxUploadMb = 5;

    private void OpenPhoto(ProductAdminDto p)
    {
        _photoTarget     = p;
        _photoPreviewUrl = Media.Resolve(p.ImageUrl);
        _photoUrlInput   = p.ImageUrl?.StartsWith("http") == true ? p.ImageUrl : "";
        _photoError      = null;
    }

    private void ClosePhoto()
    {
        _photoTarget     = null;
        _photoPreviewUrl = null;
        _photoUrlInput   = "";
        _photoError      = null;
    }

    /// <summary>
    /// Kiểm tra ngay ở trình duyệt trước khi tải lên. Backend vẫn kiểm lại đầy
    /// đủ — kiểm ở đây chỉ để người dùng biết ngay, không phải chờ đi về mạng.
    /// </summary>
    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (_photoTarget is null) return;

        var file = e.File;
        _photoError = null;

        if (file.Size > MaxUploadMb * 1024L * 1024L)
        {
            _photoError = $"Ảnh {file.Size / 1024 / 1024}MB, vượt giới hạn {MaxUploadMb}MB. " +
                          "Chụp lại ở chế độ chất lượng thấp hơn hoặc nén bớt.";
            return;
        }

        if (file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
        {
            _photoError = "Chỉ nhận ảnh JPG, PNG hoặc WebP.";
            return;
        }

        _photoBusy = true;
        try
        {
            // OpenReadStream mặc định chỉ cho 512KB nên phải nâng hạn mức lên
            await using var stream = file.OpenReadStream(MaxUploadMb * 1024L * 1024L);

            var res = await Api.UploadProductImageAsync(
                _photoTarget.Id, stream, file.Name, file.ContentType);

            if (res.Success && res.Data is not null)
            {
                ApplyNewImage(res.Data.Url);
                Alerts.Success($"Đã cập nhật ảnh cho {_photoTarget.Name} ({res.Data.SizeKb} KB).");
            }
            else
            {
                _photoError = res.Error?.Message ?? "Không tải được ảnh lên.";
            }
        }
        finally
        {
            _photoBusy = false;
        }
    }

    private async Task ApplyPhotoUrl()
    {
        if (_photoTarget is null || string.IsNullOrWhiteSpace(_photoUrlInput)) return;

        _photoBusy = true;
        _photoError = null;
        try
        {
            var res = await Api.SetProductImageUrlAsync(_photoTarget.Id, _photoUrlInput.Trim());
            if (res.Success && res.Data is not null)
            {
                ApplyNewImage(res.Data.Url);
                Alerts.Success($"Đã gán ảnh cho {_photoTarget.Name}.");
            }
            else
            {
                _photoError = res.Error?.Message ?? "Không gán được đường dẫn ảnh.";
            }
        }
        finally { _photoBusy = false; }
    }

    private async Task RemovePhoto()
    {
        if (_photoTarget is null) return;

        _photoBusy = true;
        _photoError = null;
        try
        {
            var res = await Api.RemoveProductImageAsync(_photoTarget.Id);
            if (res.Success)
            {
                ApplyNewImage(null);
                Alerts.Info($"{_photoTarget.Name} quay về dùng hình vẽ.");
            }
            else
            {
                _photoError = res.Error?.Message ?? "Không gỡ được ảnh.";
            }
        }
        finally { _photoBusy = false; }
    }

    /// <summary>
    /// Cập nhật ảnh mới vào cả bảng lẫn hộp thoại mà không phải nạp lại toàn
    /// bộ danh sách — record là kiểu bất biến nên phải thay bằng bản sao.
    /// </summary>
    private void ApplyNewImage(string? newUrl)
    {
        if (_photoTarget is null) return;

        var updated = _photoTarget with { ImageUrl = newUrl };
        var idx = _items.FindIndex(x => x.Id == updated.Id);
        if (idx >= 0) _items[idx] = updated;

        _photoTarget     = updated;
        _photoPreviewUrl = Media.Resolve(newUrl);
    }

    private int _unavailable, _noRecipe, _avgMargin;

    private record FilterDef(string Key, string Label);

    private static readonly FilterDef[] Filters =
    {
        new("all",        "Tất cả"),
        new("unavailable","Tạm hết"),
        new("no-recipe",  "Chưa có công thức"),
        new("no-photo",   "Chưa có ảnh"),
        new("low-margin", "Biên thấp"),
        new("inactive",   "Ngừng bán")
    };

    private List<ProductAdminDto> Filtered
    {
        get
        {
            IEnumerable<ProductAdminDto> q = _items;

            q = _activeFilter switch
            {
                "unavailable" => q.Where(p => !p.IsAvailable && p.IsActive),
                "no-recipe"   => q.Where(p => p.RecipeItemCount == 0),
                "no-photo"    => q.Where(p => !Media.HasPhoto(p.ImageUrl)),
                "low-margin"  => q.Where(p => p.RecipeItemCount > 0 && p.MarginPercent < 50),
                "inactive"    => q.Where(p => !p.IsActive),
                _             => q
            };

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim().ToLowerInvariant();
                q = q.Where(p => p.Name.ToLowerInvariant().Contains(s)
                              || p.CategoryName.ToLowerInvariant().Contains(s));
            }

            // Món có vấn đề lên đầu để chủ quán thấy ngay
            return q.OrderByDescending(p => p.RecipeItemCount == 0)
                    .ThenByDescending(p => !p.IsAvailable)
                    .ThenBy(p => p.CategoryName)
                    .ThenBy(p => p.Name)
                    .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.GetAdminProductsAsync();
        _items = res.Success && res.Data is not null ? res.Data : new();

        _unavailable = _items.Count(p => !p.IsAvailable && p.IsActive);
        _noRecipe    = _items.Count(p => p.RecipeItemCount == 0);

        // Chỉ tính trung bình trên món ĐÃ có công thức — món chưa có
        // thì giá vốn bằng 0 và sẽ kéo biên lên 100%, làm sai số liệu.
        var withRecipe = _items.Where(p => p.RecipeItemCount > 0).ToList();
        _avgMargin = withRecipe.Count > 0
            ? (int)Math.Round(withRecipe.Average(p => p.MarginPercent))
            : 0;

        _loading = false;
    }

    private int CountFor(string key) => key switch
    {
        "unavailable" => _unavailable,
        "no-recipe"   => _noRecipe,
        "no-photo"    => _items.Count(p => !Media.HasPhoto(p.ImageUrl)),
        "low-margin"  => _items.Count(p => p.RecipeItemCount > 0 && p.MarginPercent < 50),
        "inactive"    => _items.Count(p => !p.IsActive),
        _             => _items.Count
    };

    private static string RowClass(ProductAdminDto p)
        => p.RecipeItemCount == 0 ? "row-critical"
         : !p.IsAvailable ? "row-warn"
         : "";

    private static string MarginColor(int margin)
        => margin < 0  ? "var(--danger)"
         : margin < 40 ? "var(--warn)"
         : margin < 60 ? "hsl(45 80% 45%)"
         : "var(--ok)";

    private static string MarginTextClass(int margin)
        => margin < 0  ? "text-danger"
         : margin < 40 ? "text-warn"
         : "muted";
}
