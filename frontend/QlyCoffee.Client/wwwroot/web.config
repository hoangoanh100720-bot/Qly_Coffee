<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
   web.config — TRANG BÁN HÀNG trên IIS
  =============================================================================
   File này phải nằm CÙNG CẤP với index.html trong thư mục gốc của site trên
   IIS. Đúng theo hướng dẫn deploy: bạn upload NỘI DUNG của thư mục wwwroot
   (không phải bản thân thư mục wwwroot) vào thư mục site.

   ⚠️ YÊU CẦU: IIS phải có module URL Rewrite. Nó KHÔNG đi kèm IIS, phải cài
   riêng từ iis.net/downloads/microsoft/url-rewrite. Thiếu module này thì IIS
   báo lỗi 500.19 và cả site không mở được — xem mục xử lý sự cố trong
   docs/08-deploy-iis-winscp.md.
  =============================================================================
-->
<configuration>
  <system.webServer>

    <!-- ======================================================================
         KIỂU NỘI DUNG
         ======================================================================
         IIS trả 404 cho MỌI đuôi file nó không biết — không phải 415, không
         phải lỗi nào dễ đoán, mà đúng 404 như thể file không tồn tại. Đây là
         nguyên nhân số một khiến Blazor chạy tốt ở máy dev nhưng trắng trang
         trên IIS.

         <remove> trước <mimeMap> là bắt buộc: IIS ném lỗi trùng khai báo nếu
         đuôi đó đã được khai ở applicationHost.config cấp máy chủ.
         ====================================================================== -->
    <staticContent>
      <remove fileExtension=".blat" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".webcil" />
      <remove fileExtension=".json" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".webmanifest" />
      <remove fileExtension=".webp" />
      <remove fileExtension=".svg" />

      <mimeMap fileExtension=".blat"        mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat"         mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dll"         mimeType="application/octet-stream" />
      <mimeMap fileExtension=".webcil"      mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json"        mimeType="application/json" />
      <mimeMap fileExtension=".wasm"        mimeType="application/wasm" />
      <mimeMap fileExtension=".woff"        mimeType="font/woff" />
      <mimeMap fileExtension=".woff2"       mimeType="font/woff2" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Ảnh món đều là .webp. IIS bản cũ chưa biết đuôi này — thiếu dòng
           dưới là toàn bộ ảnh trong thực đơn biến mất. -->
      <mimeMap fileExtension=".webp"        mimeType="image/webp" />
      <mimeMap fileExtension=".svg"         mimeType="image/svg+xml" />
    </staticContent>

    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/octet-stream" enabled="true" />
        <add mimeType="application/wasm" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <!-- ======================================================================
         HEADER BẢO MẬT
         ====================================================================== -->
    <httpProtocol>
      <customHeaders>
        <!-- Không để trình duyệt tự đoán kiểu file. Đoán sai một file người
             dùng tải lên thành HTML là mở đường cho XSS. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- Không cho nhúng site vào iframe của người khác (chống clickjacking) -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <!-- Sang site khác thì chỉ gửi tên miền, không gửi đường dẫn đầy đủ -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- ======================================================================
         ĐỊNH TUYẾN MỘT TRANG (SPA)
         ======================================================================
         /menu/ca-phe-sua-da không phải một file trên đĩa — nó là route do
         Blazor xử lý. Quy tắc dưới nói với IIS: đường dẫn nào không trỏ tới
         file hay thư mục có thật thì trả về index.html, để Blazor tự đọc địa
         chỉ và dựng đúng trang.

         Không có quy tắc này thì trang chủ vẫn chạy, nhưng khách bấm F5 ở bất
         kỳ trang nào khác sẽ nhận 404 — và Google cũng vậy khi nó vào thẳng
         một đường dẫn trong sitemap. Đây là lỗi deploy SPA kinh điển.
         ====================================================================== -->
    <rewrite>
      <rules>
        <rule name="Blazor SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- ========================================================================
       BỘ NHỚ ĐỆM — PHẦN DỄ SAI NHẤT KHI CẬP NHẬT
       ========================================================================
       Ở đây CỐ Ý không đặt hạn đệm dài cho /_framework/ và /_content/, dù đó
       là mẹo tối ưu hay gặp trong các bài hướng dẫn. Lý do:

       Mẹo đó chỉ đúng khi tên file mang mã băm nội dung, kiểu app.8f3a2c.js —
       nội dung đổi thì tên đổi, bản cũ trong đệm không bao giờ bị dùng nhầm.
       Blazor .NET 8 KHÔNG đặt tên như vậy: file vẫn là QlyCoffee.Client.wasm
       và design-system.css qua mọi phiên bản. Mã băm nằm trong blazor.boot.json
       chứ không nằm trong tên.

       Hệ quả nếu đặt đệm một năm: bạn upload bản mới, blazor.boot.json mới liệt
       kê mã băm mới, nhưng trình duyệt lấy file .wasm CŨ trong đệm ra dùng. Mã
       băm không khớp, app chết ngay lúc khởi động, và chỉ chết trên máy của
       những người đã từng vào — máy bạn vừa cài lại thì vẫn chạy tốt. Không có
       kiểu lỗi nào tốn thời gian hơn thế.

       Nên: để IIS dùng cơ chế mặc định (trình duyệt hỏi lại máy chủ, file không
       đổi thì nhận 304 rất nhẹ), và chỉ ép no-cache cho hai file mà đệm sai một
       lần là hỏng hẳn.

       Muốn đệm dài thật sự an toàn thì phải nâng lên .NET 9 — bản đó có cơ chế
       đặt vân tay vào tên file (fingerprinting) làm đúng việc này.
       ======================================================================== -->

  <!-- index.html: tên không bao giờ đổi, mà nó lại là file quyết định mọi thứ
       khác tải về. Đệm nó là đóng băng cả ứng dụng ở bản cũ. -->
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- appsettings.json: chứa địa chỉ API. Đổi máy chủ backend mà máy khách còn
       giữ bản cũ thì app gọi vào hư không, và triệu chứng trông y hệt lỗi mạng. -->
  <location path="appsettings.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>
