<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
   sitemap.xml — Danh sách trang gửi cho Google
  =============================================================================
   ⚠️ Đổi https://motchutcoffee.vn thành tên miền thật khi deploy.

   File này liệt kê các trang TĨNH — những đường dẫn không đổi theo dữ liệu.
   Trang chi tiết từng món (/menu/{slug}) KHÔNG có ở đây vì danh sách món thay
   đổi liên tục theo database. Chúng cần một sitemap sinh động do backend trả về.

   BƯỚC TIẾP THEO ĐỂ SEO ĐẦY ĐỦ
   Thêm một endpoint ở backend, ví dụ GET /sitemap-mon.xml, đọc bảng products
   rồi trả về XML cùng định dạng này, và khai báo thêm một dòng Sitemap trong
   robots.txt trỏ tới nó. Không làm được từ phía frontend tĩnh.

   changefreq và priority là GỢI Ý, Google có thể bỏ qua. Giá trị đặt theo
   mức độ thật sự thay đổi: thực đơn đổi hằng ngày (giá, món hết), trang chủ
   đổi hằng tuần, trang tra cứu gần như không đổi.
  =============================================================================
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">

  <url>
    <loc>https://motchutcoffee.vn/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    <image:image>
      <image:loc>https://motchutcoffee.vn/img/og-cover.jpg</image:loc>
      <image:title>Cà phê sữa đá pha phin tại Một Chút Coffee</image:title>
    </image:image>
  </url>

  <url>
    <loc>https://motchutcoffee.vn/menu</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://motchutcoffee.vn/tra-cuu-don</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

</urlset>
