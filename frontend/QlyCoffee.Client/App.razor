@*
    =============================================================================
    APP — Gốc định tuyến của ứng dụng
    =============================================================================
    CascadingAuthenticationState bọc toàn bộ để mọi trang dùng được <AuthorizeView>
    và thuộc tính [Authorize] mà không phải truyền trạng thái thủ công.
    =============================================================================
*@
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">

        @* --- Đường dẫn khớp --- *@
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(ShopLayout)">

                @* Chưa đăng nhập hoặc không đủ quyền *@
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="container section">
                            <div class="empty">
                                <WarnIcon Size="52" CssClass="empty-icon" />
                                <span class="empty-title">Bạn không có quyền vào trang này</span>
                                <span class="empty-text">
                                    Trang này dành cho quản lý. Nếu bạn cần truy cập,
                                    hãy liên hệ chủ quán để được cấp quyền.
                                </span>
                                <a href="/" class="btn btn-secondary">Về trang chủ</a>
                            </div>
                        </div>
                    }
                </NotAuthorized>

                @* Đang xác định quyền — hiện khung xương thay vì nhấp nháy *@
                <Authorizing>
                    <div class="container section">
                        <div class="stack stack-4">
                            <div class="skeleton skeleton-title"></div>
                            <div class="skeleton" style="height: 200px; border-radius: var(--radius-lg);"></div>
                        </div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>

            <FocusOnNavigate RouteData="@routeData" Selector="h1, h2" />
        </Found>

        @* --- Không tìm thấy đường dẫn --- *@
        <NotFound>
            <PageTitle>Không tìm thấy trang — Qly Coffee</PageTitle>
            <LayoutView Layout="@typeof(ShopLayout)">
                <div class="container section">
                    <div class="empty">
                        <CupIcon Size="56" CssClass="empty-icon" />
                        <span class="empty-title">Không tìm thấy trang này</span>
                        <span class="empty-text">
                            Đường dẫn có thể đã thay đổi hoặc bạn gõ nhầm địa chỉ.
                        </span>
                        <div class="row row-2">
                            <a href="/" class="btn btn-primary">Về trang chủ</a>
                            <a href="/menu" class="btn btn-secondary">Xem thực đơn</a>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
