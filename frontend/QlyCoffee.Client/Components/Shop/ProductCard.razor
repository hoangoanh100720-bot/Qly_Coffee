@*
    =============================================================================
    PRODUCT CARD — Thẻ món trên lưới thực đơn
    =============================================================================

    Điểm thiết kế đáng chú ý:

    1. LUÔN LÀ ẢNH CHỤP THẬT
       Bản trước dựng hình ly nước bằng SVG khi món chưa có ảnh. Giờ thì không:
       DrinkPhoto.PhotoFor() ưu tiên ảnh quán tự chụp, thiếu thì lấy ảnh mẫu
       theo danh mục trong wwwroot/img/. Ảnh thật bán được hàng, hình vẽ thì không.

    2. NỀN Ô ẢNH VẪN PHA TỪ MÀU MÓN TRONG DATABASE
       Hai biến --drink và --foam truyền qua style inline. Trong khoảnh khắc ảnh
       chưa tải xong, ô ảnh đã mang đúng sắc của món thay vì một mảng xám —
       trang không bị "nhấp nháy xám" khi cuộn nhanh qua lưới menu.

    3. BA TRẠNG THÁI TỒN KHO ĐỀU ĐƯỢC XỬ LÝ
       còn nhiều → bình thường
       còn ít    → nhãn "Chỉ còn N ly" màu cảnh báo
       hết       → làm mờ ảnh, chip "Tạm hết", nút bị vô hiệu và có lý do

    4. KHÔNG DÙNG MÀU ĐƠN THUẦN ĐỂ TRUYỀN TIN
       Hết hàng vừa đổi màu, vừa có chữ, vừa vô hiệu nút — người mù màu
       hoặc dùng trình đọc màn hình vẫn nhận được thông tin.

    5. KÍCH THƯỚC ẢNH KHAI BÁO SẴN (width/height)
       Trình duyệt giữ chỗ đúng bằng ô ảnh trước khi ảnh về, nên lưới không
       giật khi ảnh tải xong. Đây là chỉ số CLS mà Google dùng để xếp hạng.
    =============================================================================
*@

<article class="product-card @(Product.IsAvailable ? "" : "is-unavailable")"
         style="--drink: @Product.ColorPrimaryHex; --foam: @Product.ColorAccentHex;">

    <a href="/menu/@Product.Slug" class="product-link"
       aria-label="Xem chi tiết @Product.Name">

        <div class="product-visual">

            @* Nhãn góc: đang giảm giá, bán chạy, món mới.
               Dùng badge nền đặc vì nhãn nằm đè lên ảnh — nhãn nền nhạt sẽ chìm. *@
            <div class="product-tags">
                @if (Product.DiscountPercent > 0)
                {
                    <span class="badge badge-solid">−@Product.DiscountPercent%</span>
                }
                @foreach (var tag in Product.Tags.Take(1))
                {
                    <span class="badge badge-dark">@TagLabel(tag)</span>
                }
            </div>

            @*  loading="lazy"  — thẻ nằm ngoài màn hình đầu tiên thì hoãn tải.
                decoding="async" — không chặn luồng dựng trang khi giải mã ảnh.  *@
            <img src="@PhotoUrl" alt="@PhotoAlt"
                 loading="lazy" decoding="async"
                 width="900" height="900" />

            @if (!Product.IsAvailable)
            {
                <span class="unavailable-tag">Tạm hết</span>
            }
        </div>
    </a>

    <div class="product-body">
        <h3 class="product-name">
            <a href="/menu/@Product.Slug" class="plain-link">@Product.Name</a>
        </h3>

        @if (!string.IsNullOrEmpty(Product.Description))
        {
            <p class="product-desc">@Product.Description</p>
        }

        @* Cảnh báo tồn kho — chỉ hiện khi thực sự sắp hết, không làm nhiễu lúc bình thường *@
        @if (Product.IsAvailable && Product.MaxServings <= LowStockThreshold)
        {
            <span class="low-stock">
                <WarnIcon Size="13" />
                Chỉ còn @Product.MaxServings phần
            </span>
        }

        @* Bản cũ có thêm một nhánh hiện LÝ DO hết hàng cho nhân viên đăng nhập.
           Nhánh đó đã bỏ: trang bán hàng không còn đăng nhập, nên với mọi khách
           vào đây nó là mã chết. Nhân viên xem lý do thiếu nguyên liệu ở app
           quản lý, màn hình Nguyên liệu. *@

        <div class="product-footer">
            <div class="row row-2">
                @if (Product.DiscountPercent > 0)
                {
                    <span class="price price-sale">@Money.Format(Product.EffectivePrice)</span>
                    <span class="xs price-old">@Money.Format(Product.BasePrice)</span>
                }
                else
                {
                    <span class="price">@Money.Format(Product.BasePrice)</span>
                }
            </div>

            @if (Product.IsAvailable)
            {
                <a href="/menu/@Product.Slug" class="btn btn-primary btn-sm">
                    Chọn
                </a>
            }
            else
            {
                <button class="btn btn-secondary btn-sm" disabled
                        title="@(Product.UnavailableReason ?? "Món này tạm hết nguyên liệu")">
                    Tạm hết
                </button>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ProductCardDto Product { get; set; } = default!;

    /// <summary>Dưới mức này thì hiện cảnh báo "chỉ còn N ly".</summary>
    private const int LowStockThreshold = 5;

    /// <summary>
    /// Đường dẫn ảnh và câu mô tả — tính một lần cho mỗi lần dựng thẻ thay vì
    /// gọi lại trong markup, vì lưới menu có thể dựng hàng chục thẻ cùng lúc.
    /// </summary>
    private string PhotoUrl => DrinkPhoto.PhotoFor(
        Product.ImageUrl, Product.CategoryName, Product.Name);

    private string PhotoAlt => DrinkPhoto.AltFor(Product.ImageUrl, Product.Name);

    /// <summary>Đổi mã nhãn trong database sang chữ tiếng Việt hiển thị cho khách.</summary>
    private static string TagLabel(string tag) => tag switch
    {
        "best-seller" => "Bán chạy",
        "new" or "mới" => "Mới",
        "signature" => "Đặc trưng",
        _ => tag
    };
}
