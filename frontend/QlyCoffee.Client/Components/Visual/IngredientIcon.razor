@*
    =============================================================================
    INGREDIENT ICON — Minh họa nguyên liệu bằng SVG nội tuyến
    =============================================================================

    VÌ SAO DÙNG SVG THAY VÌ FILE ẢNH:
      1. Màu lấy trực tiếp từ cột `color_hex` trong database — mỗi nguyên liệu
         hiện đúng màu thật của nó, không phải màu do designer đoán.
      2. Không phụ thuộc mạng, không có ảnh vỡ, không tốn băng thông.
      3. Sắc nét ở mọi kích thước và mọi độ phân giải màn hình.
      4. Tự động hòa hợp với chế độ sáng/tối vì dùng currentColor cho nét viền.

    CÁCH DÙNG:
        <IngredientIcon IconKey="milk" ColorHex="#F5EDE0" Size="34" />

    Danh sách IconKey hợp lệ nằm ở cuối file (hằng ValidKeys).
    Nếu truyền key không tồn tại thì tự động dùng hình "generic".
    =============================================================================
*@

<svg width="@Size" height="@Size" viewBox="0 0 48 48" fill="none"
     role="img" aria-label="@AriaLabel" class="@CssClass"
     xmlns="http://www.w3.org/2000/svg">

    @switch (IconKey?.ToLowerInvariant())
    {
        // ── CÀ PHÊ ──────────────────────────────────────────────────────────
        case "coffee-beans":
            // Hai hạt cà phê nghiêng, có rãnh giữa đặc trưng
            <ellipse cx="18" cy="20" rx="9" ry="12" transform="rotate(-28 18 20)"
                     fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <path d="M13 14c3 4 4 9 2 12" stroke="@Stroke" stroke-width="1.5" stroke-linecap="round" />
            <ellipse cx="30" cy="29" rx="9" ry="12" transform="rotate(-28 30 29)"
                     fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <path d="M25 23c3 4 4 9 2 12" stroke="@Stroke" stroke-width="1.5" stroke-linecap="round" />
            break;

        // ── SỮA & CHẾ PHẨM TỪ SỮA ───────────────────────────────────────────
        case "milk":
            // Hộp sữa giấy có nắp gấp
            <path d="M14 18h20v22a2 2 0 0 1-2 2H16a2 2 0 0 1-2-2V18Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <path d="M14 18l5-10h10l5 10" fill="@FillSoft" stroke="@Stroke" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M19 8h10" stroke="@Stroke" stroke-width="1.5" stroke-linecap="round" />
            <rect x="18" y="24" width="12" height="8" rx="1" fill="@FillSoft" opacity="0.7" />
            break;

        case "condensed-milk":
            // Lon sữa đặc
            <rect x="14" y="12" width="20" height="28" rx="2" fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <ellipse cx="24" cy="12" rx="10" ry="3" fill="@FillSoft" stroke="@Stroke" stroke-width="1.5" />
            <path d="M14 22h20M14 30h20" stroke="@Stroke" stroke-width="1.2" opacity="0.5" />
            break;

        case "cream":
            // Ly kem đánh bông với chóp xoáy
            <path d="M16 24h16v14a3 3 0 0 1-3 3H19a3 3 0 0 1-3-3V24Z"
                  fill="@FillSoft" stroke="@Stroke" stroke-width="1.5" />
            <path d="M16 24c0-5 3-8 8-8s8 3 8 8" fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <path d="M20 16c1-3 2-5 4-5s3 2 4 5" fill="@Fill" stroke="@Stroke" stroke-width="1.5" stroke-linejoin="round" />
            break;

        case "cheese-foam":
            // Lớp kem cheese phủ mặt ly, có gợn sóng
            <path d="M10 26c0-6 6-11 14-11s14 5 14 11-6 10-14 10-14-4-14-10Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <path d="M13 24c2-2 4 1 6-1s4 2 6 0 4 1 6-1 3 1 4 0"
                  stroke="@Stroke" stroke-width="1.4" stroke-linecap="round" fill="none" />
            <ellipse cx="24" cy="34" rx="12" ry="4" fill="@FillSoft" opacity="0.6" />
            break;

        // ── TRÀ ─────────────────────────────────────────────────────────────
        case "tea-leaf":
            // Lá trà có gân giữa
            <path d="M38 10C22 10 10 20 10 34c0 2 1 4 2 4 14 0 26-10 26-24 0-2 0-4 0-4Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M36 12C28 20 20 28 13 37" stroke="@Stroke" stroke-width="1.5" stroke-linecap="round" />
            <path d="M30 14c-1 4-1 7 0 10M22 20c-1 4-1 7 0 10" stroke="@Stroke" stroke-width="1.2" opacity="0.6" />
            break;

        // ── BỘT ─────────────────────────────────────────────────────────────
        case "matcha":
        case "powder":
            // Bát bột với đống bột hình nón và cây đánh
            <path d="M10 26h28c0 8-6 14-14 14s-14-6-14-14Z" fill="@FillSoft" stroke="@Stroke" stroke-width="1.5" />
            <path d="M17 26c2-6 4-9 7-9s5 3 7 9" fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <circle cx="21" cy="22" r="1" fill="@Stroke" opacity="0.5" />
            <circle cx="27" cy="24" r="1" fill="@Stroke" opacity="0.5" />
            <path d="M32 20l6-10" stroke="@Stroke" stroke-width="1.5" stroke-linecap="round" />
            break;

        case "cacao":
            // Quả cacao bổ đôi
            <ellipse cx="24" cy="24" rx="11" ry="15" fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <path d="M24 9v30" stroke="@Stroke" stroke-width="1.4" opacity="0.6" />
            <path d="M18 15c-1 6-1 12 0 18M30 15c1 6 1 12 0 18" stroke="@Stroke" stroke-width="1.2" opacity="0.45" />
            break;

        // ── TOPPING ─────────────────────────────────────────────────────────
        case "boba":
            // Các viên trân châu xếp chồng
            <circle cx="18" cy="30" r="6" fill="@Fill" stroke="@Stroke" stroke-width="1.4" />
            <circle cx="30" cy="30" r="6" fill="@Fill" stroke="@Stroke" stroke-width="1.4" />
            <circle cx="24" cy="19" r="6" fill="@Fill" stroke="@Stroke" stroke-width="1.4" />
            <circle cx="22" cy="17" r="1.6" fill="@FillSoft" opacity="0.85" />
            <circle cx="16" cy="28" r="1.4" fill="@FillSoft" opacity="0.7" />
            <circle cx="28" cy="28" r="1.4" fill="@FillSoft" opacity="0.7" />
            break;

        case "jelly":
            // Khối thạch vuông trong suốt
            <rect x="12" y="16" width="14" height="14" rx="2" fill="@Fill" stroke="@Stroke" stroke-width="1.4" opacity="0.85" />
            <rect x="22" y="24" width="14" height="14" rx="2" fill="@Fill" stroke="@Stroke" stroke-width="1.4" opacity="0.85" />
            <path d="M15 19h4M25 27h4" stroke="@FillSoft" stroke-width="2" stroke-linecap="round" opacity="0.8" />
            break;

        case "pudding":
            // Bánh pudding hình thang có sốt chảy
            <path d="M14 20h20l-3 18a2 2 0 0 1-2 2H19a2 2 0 0 1-2-2l-3-18Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" stroke-linejoin="round" />
            <ellipse cx="24" cy="20" rx="10" ry="3.5" fill="@FillSoft" stroke="@Stroke" stroke-width="1.5" />
            <path d="M18 22c2 3 4 3 6 0s4-3 6 0" stroke="@Stroke" stroke-width="1.3" fill="none" opacity="0.6" />
            break;

        // ── TRÁI CÂY ────────────────────────────────────────────────────────
        case "peach":
            // Quả đào có rãnh giữa và lá
            <path d="M24 14c-7 0-12 5-12 12s5 12 12 12 12-5 12-12-5-12-12-12Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <path d="M24 15c-2 6-2 15 0 22" stroke="@Stroke" stroke-width="1.3" opacity="0.5" />
            <path d="M25 14c2-4 5-6 9-6-1 4-4 6-9 6Z" fill="@FillSoft" stroke="@Stroke" stroke-width="1.4" stroke-linejoin="round" />
            break;

        case "mango":
            // Quả xoài nghiêng
            <path d="M32 11c6 3 8 12 4 20s-13 12-19 8-5-13 1-20 10-11 14-8Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <path d="M31 12c-2 3-2 6 0 8" stroke="@Stroke" stroke-width="1.3" opacity="0.5" />
            <path d="M33 10c1-3 3-4 5-4-0 3-2 4-5 4Z" fill="@FillSoft" stroke="@Stroke" stroke-width="1.3" />
            break;

        case "lemon":
            // Lát chanh cắt ngang, có múi
            <circle cx="24" cy="24" r="14" fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <circle cx="24" cy="24" r="10" fill="@FillSoft" opacity="0.55" />
            <path d="M24 14v20M14 24h20M17 17l14 14M31 17L17 31"
                  stroke="@Stroke" stroke-width="1.2" opacity="0.65" />
            break;

        case "lemongrass":
            // Ba cây sả bó lại
            <path d="M20 42V20c0-6 1-11 3-14M24 42V22c0-6 1-12 3-15M28 42V24c0-5 1-10 3-13"
                  stroke="@Stroke" stroke-width="1.6" stroke-linecap="round" fill="none" />
            <path d="M17 42h14v-6H17z" fill="@Fill" stroke="@Stroke" stroke-width="1.4" />
            <path d="M23 6c2 3 3 6 3 9M27 9c1 3 2 5 2 8" stroke="@Fill" stroke-width="2.4" stroke-linecap="round" />
            break;

        // ── SIRO & ĐƯỜNG ────────────────────────────────────────────────────
        case "syrup":
            // Chai siro có nhãn và giọt chảy
            <path d="M20 8h8v6l4 5v21a2 2 0 0 1-2 2H18a2 2 0 0 1-2-2V19l4-5V8Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" stroke-linejoin="round" />
            <rect x="17" y="24" width="14" height="9" rx="1.5" fill="@FillSoft" stroke="@Stroke" stroke-width="1.2" />
            <path d="M19 6h10" stroke="@Stroke" stroke-width="1.6" stroke-linecap="round" />
            break;

        case "sugar":
            // Hai viên đường và vài hạt rơi
            <rect x="11" y="22" width="14" height="12" rx="1.5" fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <rect x="24" y="16" width="14" height="12" rx="1.5" fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <circle cx="16" cy="39" r="1.4" fill="@Stroke" opacity="0.55" />
            <circle cx="22" cy="41" r="1.2" fill="@Stroke" opacity="0.45" />
            <circle cx="30" cy="34" r="1.3" fill="@Stroke" opacity="0.5" />
            break;

        // ── KHÁC ────────────────────────────────────────────────────────────
        case "ice":
            // Ba viên đá xếp lớp
            <path d="M24 8l10 6v12l-10 6-10-6V14l10-6Z" fill="@Fill" stroke="@Stroke" stroke-width="1.5" stroke-linejoin="round" opacity="0.9" />
            <path d="M16 28l8 5v9l-8-5v-9Z" fill="@FillSoft" stroke="@Stroke" stroke-width="1.4" stroke-linejoin="round" />
            <path d="M32 28l-8 5v9l8-5v-9Z" fill="@Fill" stroke="@Stroke" stroke-width="1.4" stroke-linejoin="round" opacity="0.75" />
            break;

        case "egg":
            // Quả trứng
            <path d="M24 8c6 0 11 9 11 17 0 7-5 12-11 12s-11-5-11-12c0-8 5-17 11-17Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <ellipse cx="20" cy="20" rx="3" ry="4.5" fill="@FillSoft" opacity="0.55" transform="rotate(-20 20 20)" />
            break;

        case "cup":
        case "packaging":
            // Ly nhựa có nắp vòm và ống hút
            <path d="M14 18h20l-2.5 21a3 3 0 0 1-3 2.6h-9A3 3 0 0 1 16.5 39L14 18Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M12 18c0-4 5-6 12-6s12 2 12 6" fill="@FillSoft" stroke="@Stroke" stroke-width="1.5" />
            <path d="M27 12V5" stroke="@Stroke" stroke-width="2" stroke-linecap="round" />
            break;

        case "straw":
            // Ống hút gấp khúc
            <path d="M18 43V22l12-16" stroke="@Fill" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M18 43V22l12-16" stroke="@Stroke" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            <path d="M22 17l4 3M25 13l4 3" stroke="@Stroke" stroke-width="1.2" opacity="0.6" />
            break;

        // ── MẶC ĐỊNH ────────────────────────────────────────────────────────
        default:
            // Hũ đựng chung — dùng khi không xác định được loại nguyên liệu
            <path d="M15 18h18v20a3 3 0 0 1-3 3H18a3 3 0 0 1-3-3V18Z"
                  fill="@Fill" stroke="@Stroke" stroke-width="1.5" />
            <rect x="13" y="12" width="22" height="6" rx="2" fill="@FillSoft" stroke="@Stroke" stroke-width="1.5" />
            <path d="M20 26h8" stroke="@Stroke" stroke-width="1.4" stroke-linecap="round" opacity="0.6" />
            break;
    }
</svg>

@code {
    /// <summary>
    /// Mã hình minh họa, lấy từ cột <c>ingredients.icon_key</c> trong database.
    /// Không khớp mã nào thì tự dùng hình hũ đựng chung.
    /// </summary>
    [Parameter] public string? IconKey { get; set; }

    /// <summary>
    /// Màu THẬT của nguyên liệu, lấy từ cột <c>ingredients.color_hex</c>.
    /// Đây là điểm mấu chốt: hình minh họa mang đúng màu của nguyên liệu ngoài đời,
    /// nên nhìn lướt bảng kho là nhận ra ngay mà không cần đọc chữ.
    /// </summary>
    [Parameter] public string ColorHex { get; set; } = "#B8A38A";

    /// <summary>Cạnh của hình vuông chứa icon, tính bằng pixel.</summary>
    [Parameter] public int Size { get; set; } = 32;

    /// <summary>Lớp CSS bổ sung.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Nhãn cho trình đọc màn hình. Nên truyền tên nguyên liệu.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Nguyên liệu";

    // --- Ba tông màu dẫn xuất từ một màu gốc ---------------------------------
    // Fill     : màu gốc, dùng cho khối chính
    // FillSoft : màu nhạt hơn, dùng cho vùng phụ và điểm sáng
    // Stroke   : màu đậm hơn, dùng cho nét viền để hình luôn có ranh giới rõ
    //            kể cả khi màu gốc quá nhạt (VD: sữa gần như trắng)

    private string Fill => ColorHex;
    private string FillSoft => Lighten(ColorHex, 0.45);
    private string Stroke => Darken(ColorHex, 0.42);

    /// <summary>Làm sáng màu hex bằng cách trộn với trắng theo tỉ lệ cho trước.</summary>
    private static string Lighten(string hex, double amount)
    {
        var (r, g, b) = Parse(hex);
        return ToHex(
            (int)(r + (255 - r) * amount),
            (int)(g + (255 - g) * amount),
            (int)(b + (255 - b) * amount));
    }

    /// <summary>Làm tối màu hex bằng cách trộn với đen theo tỉ lệ cho trước.</summary>
    private static string Darken(string hex, double amount)
    {
        var (r, g, b) = Parse(hex);
        return ToHex(
            (int)(r * (1 - amount)),
            (int)(g * (1 - amount)),
            (int)(b * (1 - amount)));
    }

    /// <summary>Tách chuỗi hex thành ba thành phần R, G, B. Sai định dạng thì trả màu xám trung tính.</summary>
    private static (int r, int g, int b) Parse(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return (184, 163, 138);
        hex = hex.TrimStart('#');
        // Hỗ trợ cả dạng rút gọn 3 ký tự: #ABC -> #AABBCC
        if (hex.Length == 3)
            hex = $"{hex[0]}{hex[0]}{hex[1]}{hex[1]}{hex[2]}{hex[2]}";
        if (hex.Length < 6) return (184, 163, 138);
        try
        {
            return (
                Convert.ToInt32(hex.Substring(0, 2), 16),
                Convert.ToInt32(hex.Substring(2, 2), 16),
                Convert.ToInt32(hex.Substring(4, 2), 16));
        }
        catch { return (184, 163, 138); }
    }

    private static string ToHex(int r, int g, int b) =>
        $"#{Math.Clamp(r, 0, 255):X2}{Math.Clamp(g, 0, 255):X2}{Math.Clamp(b, 0, 255):X2}";

    /// <summary>
    /// Danh sách mã hình hợp lệ — dùng để đổ dropdown ở màn hình quản lý nguyên liệu,
    /// tránh gõ tay sai chính tả.
    /// </summary>
    public static readonly (string Key, string Label)[] ValidKeys =
    {
        ("coffee-beans",   "Hạt cà phê"),
        ("milk",           "Hộp sữa"),
        ("condensed-milk", "Lon sữa đặc"),
        ("cream",          "Kem đánh bông"),
        ("cheese-foam",    "Kem cheese"),
        ("tea-leaf",       "Lá trà"),
        ("matcha",         "Bột matcha"),
        ("cacao",          "Cacao"),
        ("boba",           "Trân châu"),
        ("jelly",          "Thạch"),
        ("pudding",        "Pudding"),
        ("peach",          "Đào"),
        ("mango",          "Xoài"),
        ("lemon",          "Chanh"),
        ("lemongrass",     "Sả"),
        ("syrup",          "Chai siro"),
        ("sugar",          "Đường"),
        ("ice",            "Đá viên"),
        ("egg",            "Trứng"),
        ("cup",            "Ly nhựa"),
        ("straw",          "Ống hút"),
        ("generic",        "Hũ đựng (mặc định)")
    };
}
