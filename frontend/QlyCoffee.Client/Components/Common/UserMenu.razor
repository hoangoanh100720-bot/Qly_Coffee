@*
    =============================================================================
    USER MENU — Menu tài khoản ở góc phải thanh trên
    =============================================================================
*@
@inject AuthStateProvider Auth
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <div class="user-menu">
            <button class="user-trigger" @onclick="Toggle"
                    aria-haspopup="menu" aria-expanded="@_open">
                <span class="user-avatar">@Initials(context.User.Identity?.Name)</span>
                <span class="user-name hide-sm">@context.User.Identity?.Name</span>
            </button>

            @if (_open)
            {
                @* Lớp phủ trong suốt: bấm ra ngoài để đóng menu *@
                <div class="menu-backdrop" @onclick="Close"></div>

                <div class="user-dropdown" role="menu">
                    <div class="user-dropdown-head">
                        <span class="small" style="font-weight: 600;">@context.User.Identity?.Name</span>
                        <span class="xs muted">@RoleLabel(context.User)</span>
                    </div>
                    <button class="dropdown-item" role="menuitem" @onclick="Logout">
                        Đăng xuất
                    </button>
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        <a href="/dang-nhap" class="btn btn-secondary btn-sm">Đăng nhập</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _open;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private async Task Logout()
    {
        _open = false;
        await Auth.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    /// <summary>Lấy chữ cái đầu của tên để làm ảnh đại diện chữ.</summary>
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        // Tên Việt Nam: họ đứng trước, tên đứng sau → lấy chữ cái của TÊN (phần cuối)
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : parts[^1][..1].ToUpperInvariant();
    }

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Owner")) return "Chủ quán";
        if (user.IsInRole("Manager")) return "Quản lý";
        if (user.IsInRole("Staff")) return "Nhân viên";
        return "Khách hàng";
    }
}
