<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
   web.config — APP QUẢN LÝ trên IIS
  =============================================================================
   Giống bản của trang bán hàng, khác ba điểm, và cả ba đều quan trọng:

     1. Chặn công cụ tìm kiếm ngay ở tầng HTTP header, không chỉ ở thẻ meta.
     2. service-worker.js và service-worker-assets.js bắt buộc no-cache.
     3. Có MIME cho .webmanifest — thiếu nó thì không cài được app.

   File này phải nằm CÙNG CẤP với index.html trong thư mục gốc của site.

   ⚠️ YÊU CẦU: IIS phải có module URL Rewrite (cài riêng, không đi kèm IIS).
  =============================================================================
-->
<configuration>
  <system.webServer>

    <staticContent>
      <remove fileExtension=".blat" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".webcil" />
      <remove fileExtension=".json" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".webmanifest" />
      <remove fileExtension=".svg" />

      <mimeMap fileExtension=".blat"   mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat"    mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dll"    mimeType="application/octet-stream" />
      <mimeMap fileExtension=".webcil" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json"   mimeType="application/json" />
      <mimeMap fileExtension=".wasm"   mimeType="application/wasm" />
      <mimeMap fileExtension=".woff"   mimeType="font/woff" />
      <mimeMap fileExtension=".woff2"  mimeType="font/woff2" />
      <mimeMap fileExtension=".svg"    mimeType="image/svg+xml" />

      <!-- ĐÂY LÀ DÒNG QUYẾT ĐỊNH APP CÓ CÀI ĐƯỢC HAY KHÔNG.
           IIS không biết đuôi .webmanifest nên trả 404 cho manifest.webmanifest.
           Trình duyệt không đọc được manifest thì lặng lẽ bỏ luôn tuỳ chọn
           "Cài đặt" — không báo lỗi, không cảnh báo, nút chỉ đơn giản không
           xuất hiện. Rất khó đoán ra nếu không biết trước. -->
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/octet-stream" enabled="true" />
        <add mimeType="application/wasm" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <httpProtocol>
      <customHeaders>
        <!-- Lớp chặn thứ ba, sau robots.txt và thẻ meta. Header này mạnh hơn cả
             hai: nó đi kèm MỌI phản hồi, kể cả file không phải HTML, và bot
             không cần dựng trang mới đọc được. -->
        <add name="X-Robots-Tag" value="noindex, nofollow, noarchive" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <!-- DENY chứ không SAMEORIGIN: app quản lý không có lý do gì để bị nhúng
             vào khung của bất kỳ trang nào, kể cả trang bán hàng. -->
        <add name="X-Frame-Options" value="DENY" />
        <!-- Chặt hơn trang bán hàng: không để lộ đường dẫn nội bộ ra ngoài. -->
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Định tuyến một trang. Xem giải thích đầy đủ trong web.config của trang
         bán hàng: đường dẫn không trỏ tới file có thật thì trả index.html để
         Blazor tự dựng đúng màn hình. -->
    <rewrite>
      <rules>
        <rule name="Blazor SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- ========================================================================
       BỘ NHỚ ĐỆM
       ========================================================================
       Xem giải thích dài trong web.config của trang bán hàng. Ở app này có
       thêm hai file nữa bắt buộc no-cache, và lý do thì nghiêm trọng hơn.
       ======================================================================== -->

  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="appsettings.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- ------------------------------------------------------------------------
       service-worker.js — FILE NGUY HIỂM NHẤT NẾU BỊ ĐỆM
       ------------------------------------------------------------------------
       Service worker là thứ quyết định app dùng bản nào. Trình duyệt kiểm tra
       file này để biết có bản mới hay không.

       Nếu nó bị đệm: bạn đẩy bản vá lên máy chủ, nhưng máy của nhân viên vẫn
       hỏi đúng bản service worker cũ, thấy "không có gì đổi", và tiếp tục phục
       vụ khung ứng dụng cũ từ đệm của nó. App đứng yên ở phiên bản cũ VÔ THỜI
       HẠN — gỡ app cài lại cũng không chắc khỏi, vì đệm thuộc về trình duyệt
       chứ không thuộc về app. Cách duy nhất là vào DevTools xoá thủ công trên
       từng máy.

       Đây là lỗi PWA kinh điển nhất, và hai dòng dưới là cách phòng nó.
       ------------------------------------------------------------------------ -->
  <location path="service-worker.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- Bảng kê tài nguyên kèm mã băm. Đệm bản cũ thì service worker mới đi tải
       theo danh sách cũ, mã băm không khớp, và việc cài đặt thất bại im lặng. -->
  <location path="service-worker-assets.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>
