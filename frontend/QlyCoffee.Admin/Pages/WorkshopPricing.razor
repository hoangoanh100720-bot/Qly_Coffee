@*
    =============================================================================
    TRANG GIÁ WORKSHOP
    =============================================================================
    Trang "Đặt chỗ workshop" trả lời câu "ai đã đăng ký". Trang này trả lời câu
    còn lại: "bán bao nhiêu tiền, mở mấy chỗ".

    VÌ SAO TÁCH RA HAI TRANG
    Hai việc này có hai nhịp hoàn toàn khác nhau. Danh sách đặt chỗ được mở mỗi
    ngày, có khi mỗi giờ, và người mở thường là nhân viên trực. Giá thì vài tuần
    mới đụng tới một lần, và chỉ chủ quán hoặc quản lý mới được đụng. Trộn vào
    một trang thì ô nhập giá nằm ngay cạnh nút điểm danh — sớm muộn cũng có
    người bấm nhầm.

    ĐIỀU QUAN TRỌNG NHẤT CỦA TRANG NÀY
    Đổi giá KHÔNG làm đổi số tiền của các lượt đã đặt. Lượt đặt chụp lại giá vào
    đúng lúc khách bấm xác nhận (xem WorkshopBookingLine.UnitPrice). Giao diện
    phải nói câu đó ra, vì nỗi sợ đầu tiên của người sắp bấm "Lưu" là "làm vậy
    khách đã đặt có bị tính thêm tiền không".

    SỬA HÀNG LOẠT LÀ MẶC ĐỊNH CÓ LÝ DO
    Lịch sinh tự động tám tuần một lượt, nên một khung giờ có tới bốn mươi buổi.
    "Từ nay sáng thứ Bảy 420k" là MỘT quyết định, không phải bốn mươi lần gõ.
    Nên ô "áp cho mọi buổi cùng khung giờ" bật sẵn, và trang nói rõ sẽ đụng tới
    bao nhiêu buổi trước khi lưu.
    =============================================================================
*@
@page "/gia-workshop"
@layout AdminLayout
@attribute [Authorize(Roles = "Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts

<PageTitle>Giá workshop — Một Chút Coffee</PageTitle>

<div class="stack stack-6">

    <div class="row row-between row-wrap" style="gap: var(--space-4);">
        <div class="stack stack-1">
            <h2>Giá workshop</h2>
            <span class="xs muted">
                Đổi giá và số chỗ của từng buổi. Lượt đã đặt giữ nguyên số tiền lúc đặt.
            </span>
        </div>
        <a href="/dat-lich-workshop" class="btn btn-ghost btn-sm">
            Xem danh sách đặt chỗ <ArrowIcon Size="14" />
        </a>
    </div>

    @if (_loading)
    {
        <div class="skeleton" style="height: 420px; border-radius: var(--radius-lg);"></div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-warn">
            <WarnIcon Size="18" />
            <span class="small">Không tải được lịch workshop: @_error</span>
        </div>
    }
    else if (_slots.Count == 0)
    {
        <div class="alert alert-info">
            <WarnIcon Size="18" />
            <div class="stack stack-1">
                <span class="alert-title">Chưa có buổi nào sắp tới</span>
                <span class="small">
                    Lịch được sinh tự động khi máy chủ khởi động. Khởi động lại API
                    là có lịch tám tuần tới.
                </span>
            </div>
        </div>
    }
    else
    {
        @* ── TÓM TẮT THEO KHUNG GIỜ ──────────────────────────────────────
             Gom theo thứ + giờ, vì đó là đơn vị mà chủ quán thật sự nghĩ tới khi
             định giá ("sáng thứ Bảy bán bao nhiêu"), chứ không phải từng ngày. *@
        <div class="grid grid-stats">
            @foreach (var g in SlotGroups)
            {
                <div class="stat">
                    <span class="stat-label">@g.Label</span>
                    <span class="stat-value">@Money.FormatShort(g.Price)</span>
                    <span class="stat-meta">
                        @g.Count buổi sắp tới · @g.Capacity chỗ mỗi buổi
                        @if (g.MixedPrice)
                        {
                            <strong class="text-warn"> · giá đang không đồng nhất</strong>
                        }
                    </span>
                </div>
            }
        </div>

        @* ── BẢNG TỪNG BUỔI ──────────────────────────────────────────────── *@
        <section class="card">
            <div class="card-header">
                <h3 class="card-title">@_slots.Count buổi sắp tới</h3>
                <span class="xs muted">Bấm "Sửa" để đổi giá, số chỗ và chủ đề</span>
            </div>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Buổi</th>
                            <th>Chủ đề</th>
                            <th class="num">Đã đặt</th>
                            <th class="num">Giá một chỗ</th>
                            <th><span class="sr-only">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _slots)
                        {
                            <tr @key="s.Id" class="@(_editingId == s.Id ? "row-warn" : "")">
                                <td>
                                    <div class="stack stack-1">
                                        <strong>@WeekdayLabel(s.Date)</strong>
                                        <span class="xs muted num">
                                            @FormatDate(s.Date) · @s.StartTime–@s.EndTime
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="stack stack-1">
                                        <span>@s.Topic</span>
                                        <span class="xs muted">@s.Summary</span>
                                    </div>
                                </td>
                                <td class="num">
                                    @* Tô đỏ khi kín chỗ: đó là tín hiệu giá đang ĐỂ RẺ, không
                                       phải tin vui. Kín sớm và liên tục nghĩa là còn dư chỗ để
                                       tăng giá mà vẫn đầy. *@
                                    <span class="@(s.SeatsLeft == 0 ? "text-danger" : "")" style="font-weight: 700;">
                                        @(s.Capacity - s.SeatsLeft)/@s.Capacity
                                    </span>
                                </td>
                                <td class="num">
                                    <div class="stack stack-1" style="align-items: flex-end;">
                                        <strong>@Money.Format(s.BasePrice)</strong>
                                        @if (s.BestPrice < s.BasePrice)
                                        {
                                            <span class="xs muted">ưu đãi nhất @Money.Format(s.BestPrice)</span>
                                        }
                                    </div>
                                </td>
                                <td class="num">
                                    <button class="btn btn-sm btn-secondary"
                                            @onclick="() => OpenEditor(s)">
                                        Sửa
                                    </button>
                                </td>
                            </tr>

                            @* ── FORM SỬA, MỞ NGAY DƯỚI DÒNG ─────────────────
                                 Mở tại chỗ chứ không bật hộp thoại: người sửa giá cần
                                 nhìn thấy giá của các buổi khác trong lúc gõ, mà hộp
                                 thoại thì che mất đúng bảng đó. *@
                            @if (_editingId == s.Id)
                            {
                                <tr class="row-warn">
                                    <td colspan="5">
                                        <div class="stack stack-5" style="padding: var(--space-4) 0;">

                                            <div class="grid grid-2">
                                                <div class="field">
                                                    <label class="field-label" for="price">Giá một chỗ (đ)</label>
                                                    <input id="price" class="input num" type="number"
                                                           min="0" step="10000" @bind="_price" />
                                                    <span class="field-hint">
                                                        0 = buổi miễn phí. Ưu đãi tính theo phần trăm trên số này.
                                                    </span>
                                                </div>

                                                <div class="field">
                                                    <label class="field-label" for="cap">Số chỗ</label>
                                                    <input id="cap" class="input num" type="number"
                                                           min="1" max="60" @bind="_capacity" />
                                                    <span class="field-hint">
                                                        Buổi này đã đặt @(s.Capacity - s.SeatsLeft) chỗ — không hạ thấp hơn con số đó.
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="field">
                                                <label class="field-label" for="topic">Chủ đề</label>
                                                <input id="topic" class="input" @bind="_topic" maxlength="120" />
                                            </div>

                                            <div class="field">
                                                <label class="field-label" for="sum">Mô tả cho khách</label>
                                                <input id="sum" class="input" @bind="_summary" maxlength="240" />
                                            </div>

                                            @* ── Áp hàng loạt ───────────────────────── *@
                                            <label class="row row-3" style="cursor: pointer; align-items: flex-start;">
                                                <input type="checkbox" @bind="_applyAll" />
                                                <span class="stack stack-1">
                                                    <strong>Áp cho mọi buổi @WeekdayLabel(s.Date).ToLowerInvariant() lúc @s.StartTime</strong>
                                                    <span class="xs muted">
                                                        @SameSlotCount(s) buổi sắp tới sẽ đổi theo. Buổi nào đã bán
                                                        nhiều hơn số chỗ mới sẽ được bỏ qua và báo lại.
                                                    </span>
                                                </span>
                                            </label>

                                            @* Câu này trả lời nỗi sợ lớn nhất của người sắp bấm Lưu. *@
                                            <div class="alert alert-info">
                                                <WarnIcon Size="16" />
                                                <span class="small">
                                                    Các lượt đã đặt giữ nguyên số tiền báo cho khách lúc đặt.
                                                    Giá mới chỉ áp cho người đặt từ bây giờ.
                                                </span>
                                            </div>

                                            <div class="row row-3 row-wrap">
                                                <button class="btn btn-primary" disabled="@_saving"
                                                        @onclick="() => SaveAsync(s)">
                                                    @(_saving ? "Đang lưu…" : "Lưu thay đổi")
                                                </button>
                                                <button class="btn btn-ghost" disabled="@_saving"
                                                        @onclick="CloseEditor">
                                                    Hủy
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* ── ƯU ĐÃI: XEM THÔI, CHƯA SỬA ĐƯỢC ────────────────────────────
             Nói thẳng là chưa sửa được, thay vì để chủ quán tự đi tìm nút. *@
        @if (_seatDiscounts.Count > 0 || _bookingDiscounts.Count > 0)
        {
            <section class="card">
                <div class="card-header">
                    <h3 class="card-title">Các diện ưu đãi đang áp</h3>
                    <span class="xs muted">Sửa phần trăm phải vào cơ sở dữ liệu — chưa có màn hình</span>
                </div>

                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Diện</th>
                                <th>Điều kiện</th>
                                <th class="num">Giảm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _seatDiscounts.Concat(_bookingDiscounts))
                            {
                                <tr @key="d.Id">
                                    <td><strong>@d.Name</strong></td>
                                    <td><span class="xs muted">@d.Description</span></td>
                                    <td class="num"><strong>−@d.Percent%</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    private List<WorkshopSlotDto> _slots = new();
    private List<WorkshopDiscountDto> _seatDiscounts = new();
    private List<WorkshopDiscountDto> _bookingDiscounts = new();

    private bool _loading = true;
    private bool _saving;
    private string? _error;

    // --- Trạng thái form -----------------------------------------------------
    private Guid? _editingId;
    private int _price;
    private int _capacity;
    private string _topic = "";
    private string _summary = "";
    private bool _applyAll = true;   // mặc định BẬT, xem lý do ở đầu file

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var res = await Api.GetAdminWorkshopCalendarAsync();
        _loading = false;

        if (!res.Success || res.Data is null)
        {
            _error = res.Error?.Message ?? "lỗi không xác định";
            StateHasChanged();
            return;
        }

        _error = null;
        // Lịch trả về gom theo ngày; trang này cần một danh sách phẳng theo thứ tự
        // thời gian, vì người định giá đọc theo dòng chứ không theo ô lịch.
        _slots = res.Data.Days.SelectMany(d => d.Slots).ToList();
        _seatDiscounts = res.Data.SeatDiscounts.ToList();
        _bookingDiscounts = res.Data.BookingDiscounts.ToList();

        StateHasChanged();
    }

    private void OpenEditor(WorkshopSlotDto s)
    {
        _editingId = s.Id;
        _price     = s.BasePrice;
        _capacity  = s.Capacity;
        _topic     = s.Topic;
        _summary   = s.Summary;
        _applyAll  = true;
    }

    private void CloseEditor() => _editingId = null;

    private async Task SaveAsync(WorkshopSlotDto s)
    {
        _saving = true;

        var res = await Api.UpdateWorkshopSessionAsync(s.Id, new UpdateWorkshopSessionRequest
        {
            BasePrice       = _price,
            Capacity        = _capacity,
            Topic           = _topic,
            Summary         = _summary,
            ApplyToSameSlot = _applyAll
        });

        _saving = false;

        if (res.Success && res.Data is not null)
        {
            // Báo cả phần bị bỏ qua chứ không chỉ phần thành công: chủ quán cần
            // biết ngay còn buổi nào chưa đổi, không phải tự đi rà lại bảng.
            if (res.Data.SkippedCount > 0) Alerts.Error(res.Data.Message);
            else                           Alerts.Success(res.Data.Message);

            _editingId = null;
            await LoadAsync();
        }
        else
        {
            Alerts.Error(res.Error?.Message ?? "Không lưu được thay đổi.");
        }
    }

    // --- Gom nhóm theo khung giờ ---------------------------------------------

    private record SlotGroup(string Label, int Price, int Capacity, int Count, bool MixedPrice);

    /// <summary>
    /// Gom các buổi theo thứ + giờ bắt đầu — đúng đơn vị mà chủ quán nghĩ tới
    /// khi định giá. Cờ MixedPrice bật khi trong cùng một khung giờ có nhiều mức
    /// giá khác nhau, thường là dấu vết của một lần sửa lẻ bị bỏ dở.
    /// </summary>
    private List<SlotGroup> SlotGroups => _slots
        .GroupBy(s => (Day: WeekdayLabel(s.Date), s.StartTime))
        .OrderBy(g => g.Min(s => s.Date))
        .Select(g => new SlotGroup(
            Label:      $"{g.Key.Day} {g.Key.StartTime}",
            Price:      g.First().BasePrice,
            Capacity:   g.First().Capacity,
            Count:      g.Count(),
            MixedPrice: g.Select(s => s.BasePrice).Distinct().Count() > 1))
        .ToList();

    /// <summary>Số buổi sẽ bị ảnh hưởng nếu bật "áp hàng loạt" — tính cả buổi đang sửa.</summary>
    private int SameSlotCount(WorkshopSlotDto s) =>
        _slots.Count(x => x.StartTime == s.StartTime && WeekdayLabel(x.Date) == WeekdayLabel(s.Date));

    // --- Định dạng -----------------------------------------------------------

    private static string FormatDate(string isoDate) =>
        DateTime.TryParse(isoDate, out var d) ? d.ToString("dd/MM/yyyy") : isoDate;

    private static string WeekdayLabel(string isoDate)
    {
        if (!DateTime.TryParse(isoDate, out var d)) return isoDate;

        return d.DayOfWeek switch
        {
            DayOfWeek.Monday    => "Thứ hai",
            DayOfWeek.Tuesday   => "Thứ ba",
            DayOfWeek.Wednesday => "Thứ tư",
            DayOfWeek.Thursday  => "Thứ năm",
            DayOfWeek.Friday    => "Thứ sáu",
            DayOfWeek.Saturday  => "Thứ bảy",
            _                   => "Chủ nhật"
        };
    }
}
