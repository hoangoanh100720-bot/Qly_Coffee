@*
    =============================================================================
    ĐĂNG NHẬP
    =============================================================================
    Archetype: form. Ô nhập nằm trong cột hẹp, nhãn đặt trên, lỗi hiện ngay
    cạnh trường, nút gửi không bao giờ bị vô hiệu mà không nói lý do.
    =============================================================================
*@
@page "/dang-nhap"
@layout EmptyLayout
@inject ApiClient Api
@inject AuthStateProvider Auth
@inject NavigationManager Nav

@* Trang đăng nhập dành cho nhân viên — không có lý do gì để nó lên Google *@
<SeoHead Title="Đăng nhập"
         Description="Đăng nhập trang quản lý Một Chút Coffee."
         Path="/dang-nhap"
         NoIndex="true" />

<div class="auth-page">
    <main class="auth-card">

        <div class="stack stack-3" style="align-items: center; text-align: center;">
            <LogoMark Size="44" />
            <div class="stack stack-1">
                <h1 style="font-size: var(--text-xl);">Đăng nhập</h1>
                <p class="small muted">Dành cho nhân viên và quản lý quán</p>
            </div>
        </div>

        <EditForm Model="@_model" OnValidSubmit="SubmitAsync" class="stack stack-4">

            <div class="field">
                <label class="field-label" for="email">Email</label>
                <input id="email" type="email" class="input"
                       autocomplete="username" inputmode="email"
                       placeholder="ban@motchutcoffee.vn"
                       aria-invalid="@(_touched && string.IsNullOrWhiteSpace(_model.Email))"
                       @bind="_model.Email" @bind:event="oninput" />
                @if (_touched && string.IsNullOrWhiteSpace(_model.Email))
                {
                    <span class="field-error"><WarnIcon Size="12" /> Vui lòng nhập email.</span>
                }
            </div>

            <div class="field">
                <label class="field-label" for="password">Mật khẩu</label>
                <div class="input-group">
                    <input id="password" class="input"
                           type="@(_showPassword ? "text" : "password")"
                           autocomplete="current-password"
                           aria-invalid="@(_touched && string.IsNullOrWhiteSpace(_model.Password))"
                           @bind="_model.Password" @bind:event="oninput" />
                    <button type="button" class="input-suffix pw-toggle"
                            @onclick="() => _showPassword = !_showPassword"
                            aria-label="@(_showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                        @(_showPassword ? "Ẩn" : "Hiện")
                    </button>
                </div>
                @if (_touched && string.IsNullOrWhiteSpace(_model.Password))
                {
                    <span class="field-error"><WarnIcon Size="12" /> Vui lòng nhập mật khẩu.</span>
                }
            </div>

            @* Lỗi từ máy chủ hiện ngay trên nút, không dùng thông báo nổi —
               người dùng đang nhìn vào form nên đặt lỗi ở đó là đúng chỗ. *@
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger" role="alert">
                    <WarnIcon Size="18" />
                    <span>@_error</span>
                </div>
            }

            <button type="submit" class="btn btn-primary btn-lg btn-block" disabled="@_submitting">
                @if (_submitting)
                {
                    <SpinnerIcon Size="18" />
                    <span>Đang đăng nhập…</span>
                }
                else
                {
                    <span>Đăng nhập</span>
                }
            </button>
        </EditForm>

        <div class="divider divider-center">hoặc</div>

        <a href="/" class="btn btn-ghost btn-block">Về trang bán hàng</a>
    </main>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginRequest _model = new();
    private bool _submitting;
    private bool _touched;
    private bool _showPassword;
    private string? _error;

    private async Task SubmitAsync()
    {
        _touched = true;
        _error = null;

        if (string.IsNullOrWhiteSpace(_model.Email) || string.IsNullOrWhiteSpace(_model.Password))
            return;

        _submitting = true;

        var res = await Api.LoginAsync(_model);

        _submitting = false;

        if (res.Success && res.Data is not null)
        {
            await Auth.LoginAsync(res.Data);

            // Quay lại đúng trang đang xem dở trước khi bị chặn.
            // Không có thì về "/" — bảng điều khiển, gốc của app quản lý.
            var target = string.IsNullOrEmpty(ReturnUrl) ? "/" : Uri.UnescapeDataString(ReturnUrl);
            Nav.NavigateTo(target, forceLoad: false);
        }
        else
        {
            _error = res.Error?.Message ?? "Không đăng nhập được. Vui lòng thử lại.";
            _model.Password = "";
        }
    }
}
