@*
    =============================================================================
    TRANG SOẠN CÔNG THỨC ĐỊNH LƯỢNG
    =============================================================================

    Archetype: form/CRUD. Nhãn đặt trên ô nhập, ô nhập nằm trong cột hẹp,
    validate hiện ngay cạnh trường, nút lưu không bao giờ bị vô hiệu mà
    không giải thích lý do.

    Điểm quan trọng của màn hình này: MỌI THAY ĐỔI ĐỀU TÍNH LẠI GIÁ VỐN NGAY.
    Người soạn công thức thấy được ảnh hưởng tới lợi nhuận trong lúc gõ, thay vì
    phải lưu rồi mới biết món bị lỗ.
    =============================================================================
*@
@page "/mon/{ProductId:guid}/cong-thuc"
@layout AdminLayout
@attribute [Authorize(Roles = "Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts
@inject NavigationManager Nav

<PageTitle>Công thức @(_product?.Name ?? "") — Một Chút Coffee</PageTitle>

@if (_loading)
{
    <div class="stack stack-4">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton" style="height: 320px; border-radius: var(--radius-lg);"></div>
    </div>
}
else if (_product is null)
{
    <div class="empty">
        <CupIcon Size="52" CssClass="empty-icon" />
        <span class="empty-title">Không tìm thấy món</span>
        <a href="/mon" class="btn btn-secondary">Quay lại danh sách món</a>
    </div>
}
else
{
    <div class="recipe-layout">

        @* ══ CỘT TRÁI — BẢNG CÔNG THỨC ═════════════════════════════════════ *@
        <div class="stack stack-6">

            <div class="row row-between row-wrap" style="gap: var(--space-4);">
                <div class="row row-4">
                    @*  Ảnh thật của món, viền tô bằng chính hai màu đang cấu hình bên
                        dưới — vừa thấy đúng thứ khách nhìn, vừa thấy ngay màu vừa chọn. *@
                    <img class="recipe-photo"
                         src="@DrinkPhoto.PhotoFor(_product.ImageUrl, _product.CategoryName, _product.Name)"
                         alt="@($"Ảnh món {_product.Name}")"
                         style="--drink: @_colorPrimary; --foam: @_colorAccent;"
                         width="72" height="72" />
                    <div class="stack stack-1">
                        <h2>@_product.Name</h2>
                        <span class="xs muted">Công thức cho một phần size mặc định</span>
                    </div>
                </div>

                <div class="row row-2">
                    <a href="/mon" class="btn btn-ghost btn-sm">Quay lại</a>
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsync" disabled="@(!CanSave)">
                        @if (_saving)
                        {
                            <SpinnerIcon Size="14" />
                        }
                        <span>Lưu công thức</span>
                    </button>
                </div>
            </div>

            @* Nếu không lưu được thì phải nói RÕ vì sao — không để nút xám im lặng *@
            @if (!CanSave && !_saving)
            {
                <div class="alert alert-warn">
                    <WarnIcon Size="18" />
                    <span class="small">@SaveBlockedReason</span>
                </div>
            }

            @* ── BẢNG DÒNG CÔNG THỨC ────────────────────────────────────── *@
            <section class="card">
                <div class="card-header">
                    <div class="stack stack-1">
                        <h3 class="card-title">Nguyên liệu &amp; định lượng</h3>
                        <span class="xs muted">
                            Lượng dùng cho MỘT ly. Size L sẽ tự nhân theo hệ số của biến thể.
                        </span>
                    </div>
                    <span class="badge badge-neutral">@_lines.Count nguyên liệu</span>
                </div>

                @if (_lines.Count == 0)
                {
                    <div class="empty" style="padding: var(--space-10) var(--space-4);">
                        <JarIcon Size="40" CssClass="empty-icon" />
                        <span class="empty-title">Chưa có nguyên liệu nào</span>
                        <span class="empty-text">
                            Món chưa có công thức thì hệ thống không trừ được kho và
                            không tính được giá vốn. Thêm nguyên liệu đầu tiên bên dưới.
                        </span>
                    </div>
                }
                else
                {
                    <div class="recipe-table">

                        <div class="recipe-head">
                            <span></span>
                            <span class="label">Nguyên liệu</span>
                            <span class="label" style="text-align: right;">Định lượng</span>
                            <span class="label" style="text-align: right;">Chi phí</span>
                            <span class="label" style="text-align: center;">Tùy chọn</span>
                            <span></span>
                        </div>

                        @foreach (var line in _lines)
                        {
                            <div class="recipe-row" @key="line.IngredientId">

                                @* Icon tô đúng màu thật của nguyên liệu *@
                                <div class="ingredient-icon" style="--ing-color: @line.IngredientColorHex">
                                    <IngredientIcon IconKey="@line.IngredientIconKey"
                                                    ColorHex="@line.IngredientColorHex"
                                                    Size="18"
                                                    AriaLabel="@line.IngredientName" />
                                </div>

                                <div class="ingredient-meta">
                                    <span class="ingredient-name">@line.IngredientName</span>
                                    @* Cảnh báo ngay khi soạn: tồn kho không đủ cho một ly *@
                                    @if (line.CurrentStock < line.Quantity * (1 + line.WastageRate))
                                    {
                                        <span class="xs text-danger">
                                            Tồn kho chỉ còn @Fmt(line.CurrentStock) @line.UnitLabel
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="xs muted">
                                            Tồn @Fmt(line.CurrentStock) @line.UnitLabel
                                            · làm được @((int)(line.CurrentStock / Math.Max(line.Quantity * (1 + line.WastageRate), 0.0001))) ly
                                        </span>
                                    }
                                </div>

                                <div class="input-group" style="max-width: 118px;">
                                    <input type="number" class="input input-num"
                                           min="0" step="0.1"
                                           value="@line.Quantity"
                                           @onchange="e => UpdateQuantity(line, e.Value)"
                                           aria-label="@($"Định lượng {line.IngredientName}")" />
                                    <span class="input-suffix">@line.UnitLabel</span>
                                </div>

                                <span class="num small" style="text-align: right;">
                                    @Money.Format(line.LineCost)
                                </span>

                                <label class="checkbox-cell" title="Khách có thể yêu cầu bỏ nguyên liệu này">
                                    <input type="checkbox" checked="@line.IsOptional"
                                           @onchange="e => ToggleOptional(line, e.Value)"
                                           aria-label="@($"{line.IngredientName} là tùy chọn")" />
                                </label>

                                <button class="btn btn-ghost btn-icon"
                                        @onclick="() => RemoveLine(line)"
                                        aria-label="@($"Xóa {line.IngredientName} khỏi công thức")">
                                    <TrashIcon Size="15" />
                                </button>
                            </div>
                        }

                        @* Dòng tổng *@
                        <div class="recipe-total">
                            <span class="label">Tổng giá vốn nguyên liệu</span>
                            <span class="num" style="font-weight: 700; font-size: var(--text-lg);">
                                @Money.Format(TotalCost)
                            </span>
                        </div>
                    </div>
                }

                @* ── THÊM NGUYÊN LIỆU ───────────────────────────────────── *@
                <div class="card-footer">
                    <fieldset class="add-ingredient">
                        <legend class="label">Thêm nguyên liệu</legend>

                        <div class="row row-3 row-wrap">
                            <div class="field grow" style="min-width: 220px;">
                                <label class="field-label" for="ing-select">Nguyên liệu</label>
                                <select id="ing-select" class="select" @bind="_newIngredientId">
                                    <option value="">— Chọn nguyên liệu —</option>
                                    @foreach (var g in _availableIngredients.GroupBy(i => i.CategoryLabel))
                                    {
                                        <optgroup label="@g.Key">
                                            @foreach (var ing in g)
                                            {
                                                <option value="@ing.Id">
                                                    @ing.Name (@ing.UnitLabel · @Money.Format(ing.AverageUnitCost)/@ing.UnitLabel)
                                                </option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>

                            <div class="field" style="max-width: 140px;">
                                <label class="field-label" for="ing-qty">Định lượng</label>
                                <div class="input-group">
                                    <input id="ing-qty" type="number" class="input input-num"
                                           min="0" step="0.1" @bind="_newQuantity" />
                                    <span class="input-suffix">@NewIngredientUnit</span>
                                </div>
                            </div>

                            <button class="btn btn-secondary" style="align-self: flex-end;"
                                    @onclick="AddLine"
                                    disabled="@(string.IsNullOrEmpty(_newIngredientId) || _newQuantity <= 0)">
                                <PlusIcon Size="15" /> Thêm
                            </button>
                        </div>
                    </fieldset>
                </div>
            </section>

            @* ── TOPPING GỌI THÊM ──────────────────────────────────────────
                Chỉ để XEM. Topping dùng chung cho mọi món nên định lượng của nó
                không sửa ở màn hình của một món — sửa ở đây là âm thầm đổi luôn
                topping của hai chục món khác. *@
            <section class="card">
                <div class="stack stack-1">
                    <h3 class="card-title">Topping khách gọi thêm</h3>
                    <span class="xs muted">
                        Mỗi phần topping trừ kho cố định, không nhân theo size.
                        Tiền topping cộng riêng vào ly, không nằm trong giá bán ở trên.
                    </span>
                </div>

                @if (_toppings.Count == 0)
                {
                    <span class="small muted">Món này không cho gọi thêm topping.</span>
                }
                else
                {
                    <table class="recipe-inline-table">
                        <thead>
                            <tr>
                                <th>Topping</th>
                                <th class="num">Giá thêm</th>
                                <th>Định lượng mỗi phần</th>
                                <th class="num">Giá vốn</th>
                                <th class="num">Lãi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _toppings)
                            {
                                <tr class="@(t.IsActive ? "" : "is-optional")">
                                    <td>
                                        <span class="swatch" style="--swatch-color: @t.ColorHex"></span>
                                        @t.Name
                                        @if (!t.IsActive)
                                        {
                                            <span class="badge badge-neutral">ngừng bán</span>
                                        }
                                    </td>
                                    <td class="num" style="font-weight: 700;">+@Money.Format(t.PriceDelta)</td>
                                    <td class="xs">
                                        @if (t.Lines.Count == 0)
                                        {
                                            <span class="text-danger">Chưa có định lượng — không trừ kho</span>
                                        }
                                        else
                                        {
                                            @string.Join(" + ", t.Lines.Select(l => $"{Qty.Format(l.Quantity)} {l.UnitLabel} {l.IngredientName}"))
                                        }
                                    </td>
                                    <td class="num muted">@Money.Format(t.Cost)</td>
                                    <td class="num">@Money.Format(t.PriceDelta - t.Cost)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        @* ══ CỘT PHẢI — GIÁ & LỢI NHUẬN ════════════════════════════════════ *@
        <aside class="stack stack-4 recipe-sidebar">

            <section class="card">
                <h3 class="card-title">Giá &amp; lợi nhuận</h3>

                <div class="field">
                    <label class="field-label" for="price">
                        Giá bán <span class="req" aria-hidden="true">*</span>
                    </label>
                    <div class="input-group">
                        <input id="price" type="number" class="input input-num"
                               min="0" step="1000" @bind="_basePrice" @bind:event="oninput" />
                        <span class="input-suffix">đ</span>
                    </div>
                    <span class="field-hint">Giá của size mặc định</span>
                </div>

                @* Bảng lợi nhuận cập nhật realtime khi gõ giá hoặc đổi định lượng *@
                <div class="pl-table" style="margin-top: var(--space-2);">
                    <div class="pl-row">
                        <span class="pl-label">Giá bán</span>
                        <span class="pl-value num">@Money.Format(_basePrice)</span>
                    </div>
                    <div class="pl-row">
                        <span class="pl-label">Giá vốn nguyên liệu</span>
                        <span class="pl-value pl-negative num">−@Money.Format(TotalCost)</span>
                    </div>
                    <div class="pl-row pl-total">
                        <span class="pl-label">Lãi gộp mỗi ly</span>
                        <span class="pl-value num @(GrossProfit > 0 ? "pl-positive" : "pl-negative")">
                            @Money.Format(GrossProfit)
                        </span>
                    </div>
                </div>

                @* Thanh biên lợi nhuận — mã hóa bằng cả màu VÀ độ dài VÀ chữ *@
                <div class="stack stack-2">
                    <div class="row row-between">
                        <span class="label">Biên lợi nhuận</span>
                        <span class="num" style="font-weight: 700; color: @MarginColor;">
                            @MarginPercent%
                        </span>
                    </div>
                    <div class="meter">
                        <div class="meter-fill"
                             style="width: @(Math.Clamp(MarginPercent, 0, 100))%;
                                    --meter-color: @MarginColor;"
                             role="img" aria-label="Biên lợi nhuận @MarginPercent phần trăm"></div>
                    </div>
                    <span class="xs @MarginTextClass">@MarginAdvice</span>
                </div>
            </section>

            @* ── MÀU MINH HỌA ───────────────────────────────────────────── *@
            <section class="card">
                <div class="stack stack-1">
                    <h3 class="card-title">Màu nhận diện</h3>
                    @*  Không còn dùng để VẼ ly nước nữa — mọi món giờ đều hiện ảnh chụp.
                        Hai màu này giờ đi vào nền thẻ món, viền thẻ khuyến mãi và vệt màu
                        ở dòng giỏ hàng, nên vẫn phải khớp màu thật của ly. *@
                    <span class="xs muted">
                        Tô nền thẻ món, thẻ khuyến mãi và dòng giỏ hàng.
                        Chọn đúng màu thật của ly để nền ăn khớp với ảnh.
                    </span>
                </div>

                <div class="row row-4">
                    <div class="field grow">
                        <label class="field-label" for="color-primary">Màu nước</label>
                        <div class="color-field">
                            <input id="color-primary" type="color" class="color-input"
                                   @bind="_colorPrimary" @bind:event="oninput" />
                            <input type="text" class="input mono xs"
                                   @bind="_colorPrimary" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="field grow">
                        <label class="field-label" for="color-accent">Màu kem/foam</label>
                        <div class="color-field">
                            <input id="color-accent" type="color" class="color-input"
                                   @bind="_colorAccent" @bind:event="oninput" />
                            <input type="text" class="input mono xs"
                                   @bind="_colorAccent" @bind:event="oninput" />
                        </div>
                    </div>
                </div>
            </section>

            @* ── TÌNH TRẠNG BÁN ─────────────────────────────────────────── *@
            <section class="card">
                <h3 class="card-title">Tình trạng</h3>

                @{
                    var maxServings = MaxServingsFromRecipe();
                }

                @if (_lines.Count == 0)
                {
                    <span class="status status-warn">Chưa có công thức — không trừ được kho</span>
                }
                else if (maxServings == 0)
                {
                    <div class="stack stack-2">
                        <span class="status status-danger">Tạm hết nguyên liệu</span>
                        <span class="xs muted">Thiếu: @BlockingIngredient</span>
                    </div>
                }
                else if (maxServings <= 5)
                {
                    <div class="stack stack-2">
                        <span class="status status-warn">Sắp hết — còn @maxServings ly</span>
                        <span class="xs muted">Giới hạn bởi @BlockingIngredient</span>
                    </div>
                }
                else
                {
                    <div class="stack stack-2">
                        <span class="status status-ok">Còn bán được</span>
                        <span class="xs muted">Tồn kho đủ làm @maxServings ly</span>
                    </div>
                }
            </section>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid ProductId { get; set; }

    private ProductAdminDto? _product;
    private List<RecipeLineDto> _lines = new();
    private List<IngredientStockDto> _allIngredients = new();
    private List<ProductToppingDto> _toppings = new();

    private bool _loading = true;
    private bool _saving;

    private int _basePrice;
    private string _colorPrimary = "#4A2C17";
    private string _colorAccent = "#C89968";

    // Form thêm nguyên liệu
    private string _newIngredientId = "";
    private double _newQuantity;

    // ── Số liệu dẫn xuất, tính lại mỗi lần render ───────────────────────────

    /// <summary>Tổng giá vốn = Σ (định lượng × giá vốn × (1 + hao hụt)).</summary>
    private int TotalCost => _lines.Sum(l => l.LineCost);

    private int GrossProfit => _basePrice - TotalCost;

    private int MarginPercent =>
        _basePrice > 0 ? (int)Math.Round(GrossProfit * 100.0 / _basePrice) : 0;

    // Dùng toán tử ba ngôi thay vì switch có mẫu quan hệ.
    // Bộ phân tích Razor hiểu nhầm dấu "<" đứng đầu dòng là thẻ HTML mở.
    private string MarginColor
        => MarginPercent < 0  ? "var(--danger)"
         : MarginPercent < 40 ? "var(--warn)"
         : MarginPercent < 60 ? "hsl(45 80% 42%)"
         : "var(--ok)";

    private string MarginTextClass => MarginPercent < 40 ? "text-warn" : "muted";

    private string MarginAdvice
        => MarginPercent < 0  ? "Món đang bán lỗ. Tăng giá hoặc giảm định lượng nguyên liệu đắt."
         : MarginPercent < 40 ? "Biên thấp so với mặt bằng đồ uống (thường 60–75%)."
         : MarginPercent < 60 ? "Chấp nhận được, nhưng còn dư địa cải thiện."
         : "Biên lợi nhuận tốt.";

    /// <summary>Chỉ hiện nguyên liệu chưa có trong công thức.</summary>
    private IEnumerable<IngredientStockDto> _availableIngredients =>
        _allIngredients.Where(i => _lines.All(l => l.IngredientId != i.Id));

    private string NewIngredientUnit =>
        Guid.TryParse(_newIngredientId, out var id)
            ? _allIngredients.FirstOrDefault(i => i.Id == id)?.UnitLabel ?? ""
            : "";

    private bool CanSave => !_saving && _basePrice > 0 && _lines.Count > 0;

    private string SaveBlockedReason =>
        _lines.Count == 0 ? "Cần ít nhất một nguyên liệu trong công thức trước khi lưu."
        : _basePrice <= 0 ? "Cần nhập giá bán lớn hơn 0."
        : "";

    protected override async Task OnInitializedAsync()
    {
        var (product, lines, ingredients, toppings) = await Api.GetRecipeEditorDataAsync(ProductId);
        _product = product;
        _toppings = toppings ?? new();
        _lines = lines?.ToList() ?? new();
        _allIngredients = ingredients?.ToList() ?? new();

        if (_product is not null)
        {
            _basePrice = _product.BasePrice;
            _colorPrimary = _product.ColorPrimaryHex;
            _colorAccent = _product.ColorAccentHex;
        }

        _loading = false;
    }

    private void UpdateQuantity(RecipeLineDto line, object? value)
    {
        if (double.TryParse(value?.ToString(), out var q) && q >= 0)
            line.Quantity = q;
    }

    private void ToggleOptional(RecipeLineDto line, object? value)
        => line.IsOptional = value is bool b && b;

    private void AddLine()
    {
        if (!Guid.TryParse(_newIngredientId, out var id)) return;
        var ing = _allIngredients.FirstOrDefault(i => i.Id == id);
        if (ing is null || _newQuantity <= 0) return;

        _lines.Add(new RecipeLineDto
        {
            IngredientId = ing.Id,
            IngredientName = ing.Name,
            IngredientColorHex = ing.ColorHex,
            IngredientIconKey = ing.IconKey,
            UnitLabel = ing.UnitLabel,
            Quantity = _newQuantity,
            UnitCost = ing.AverageUnitCost,
            CurrentStock = ing.TotalStock
        });

        _newIngredientId = "";
        _newQuantity = 0;
    }

    private void RemoveLine(RecipeLineDto line) => _lines.Remove(line);

    /// <summary>
    /// Số ly tối đa còn làm được = min( tồn kho / lượng cần ) trên các nguyên
    /// liệu BẮT BUỘC. Nguyên liệu tùy chọn không tính vào.
    /// </summary>
    private int MaxServingsFromRecipe()
    {
        var required = _lines.Where(l => !l.IsOptional && l.Quantity > 0).ToList();
        if (required.Count == 0) return 9999;

        return required.Min(l =>
            (int)(l.CurrentStock / (l.Quantity * (1 + l.WastageRate))));
    }

    private string BlockingIngredient
    {
        get
        {
            var required = _lines.Where(l => !l.IsOptional && l.Quantity > 0).ToList();
            if (required.Count == 0) return "";
            return required
                .OrderBy(l => l.CurrentStock / (l.Quantity * (1 + l.WastageRate)))
                .First().IngredientName;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;

        var res = await Api.SaveRecipeAsync(ProductId, new
        {
            BasePrice = _basePrice,
            ColorPrimaryHex = _colorPrimary,
            ColorAccentHex = _colorAccent,
            Lines = _lines.Select(l => new
            {
                l.IngredientId,
                l.Quantity,
                l.IsOptional,
                l.Note
            })
        });

        _saving = false;

        if (res.Success)
            Alerts.Success($"Đã lưu công thức. Giá vốn mới: {Money.Format(TotalCost)}.");
        else
            Alerts.Error(res.Error?.Message ?? "Không lưu được công thức.");
    }

    private static string Fmt(double v) => v >= 100 ? v.ToString("N0") : v.ToString("0.##");
}
