@*
    =============================================================================
    TRANG KẾ HOẠCH HẰNG NGÀY — màn hình quan trọng nhất của hệ thống
    =============================================================================

    Đây là nơi kết quả của AI Engine được trình bày cho người quản lý.

    NGUYÊN TẮC TRÌNH BÀY:

    1. SỐ TRƯỚC, CHỮ SAU
       Bốn thẻ số liệu nằm trên cùng. Người quản lý bận nên phải nắm được
       tình hình trong ba giây mà chưa cần đọc đoạn văn nào.

    2. TÁCH BẠCH "SỐ DO HỆ THỐNG TÍNH" VÀ "CHỮ DO AI VIẾT"
       Mỗi thẻ đề xuất có bảng phân tích lãi lỗ với nhãn rõ ràng. Người dùng
       phải luôn biết con số nào là tính toán và câu nào là diễn giải.

    3. MỖI ĐỀ XUẤT LÀ MỘT QUYẾT ĐỊNH
       Ba nút: Duyệt — Sửa — Bỏ qua. Không có đề xuất nào tự động áp dụng.
       Hệ thống gợi ý, con người quyết định.

    4. LỖI AI KHÔNG LÀM MẤT KẾ HOẠCH
       Nếu AiError có giá trị, phần diễn giải hiện cảnh báo nhưng toàn bộ
       số liệu và đề xuất vẫn hiển thị đầy đủ.
    =============================================================================
*@
@page "/ke-hoach"
@page "/ke-hoach/{BusinessDate}"
@layout AdminLayout
@attribute [Authorize(Roles = "Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts
@inject NavigationManager Nav

<PageTitle>Kế hoạch hằng ngày — Một Chút Coffee</PageTitle>

@if (_loading)
{
    <PlanSkeleton />
}
else if (_plan is null)
{
    @* Danh sách cần nhập không phụ thuộc bản kế hoạch AI — tồn kho và nhật ký
       thiếu hàng luôn có, nên vẫn hiện dù job 23:00 chưa chạy. *@
    <div class="stack stack-6">
    <RestockPanel BusinessDate="@RequestedDate" Mode="RestockPanel.RestockMode.Plan" />

    <div class="empty">
        <SparkIcon Size="52" CssClass="empty-icon" />
        <span class="empty-title">Chưa có kế hoạch cho ngày này</span>
        <span class="empty-text">
            Bản kế hoạch được sinh tự động lúc 23:00 mỗi ngày. Bạn cũng có thể
            tạo ngay để xem thử với dữ liệu hiện tại.
        </span>
        <button class="btn btn-primary" @onclick="GenerateNowAsync" disabled="@_generating">
            @if (_generating)
            {
                <SpinnerIcon Size="16" /> <span>Đang phân tích…</span>
            }
            else
            {
                <SparkIcon Size="16" /> <span>Tạo kế hoạch ngay</span>
            }
        </button>
    </div>
    </div>
}
else
{
    <div class="stack stack-8 fade-in">

        @* ══ HÀNG TIÊU ĐỀ ══════════════════════════════════════════════════ *@
        <div class="row row-between row-wrap" style="gap: var(--space-4);">
            <div class="stack stack-1">
                <div class="row row-3">
                    <h2>Kế hoạch ngày @FormatDate(_plan.BusinessDate)</h2>
                    @if (_plan.Status == 0)
                    {
                        <span class="badge badge-accent">Mới</span>
                    }
                </div>
                <span class="xs muted">
                    Sinh lúc @_plan.GeneratedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                    @if (!string.IsNullOrEmpty(_plan.AiModel))
                    {
                        <span> · @_plan.AiModel</span>
                    }
                </span>
            </div>

            <div class="row row-2">
                <DatePicker Value="_plan.BusinessDate" OnChanged="NavigateToDate" />
                @if (_undecidedCount == 0)
                {
                    <span class="badge badge-ok">
                        <CheckIcon Size="12" /> Đã xử lý xong
                    </span>
                }
            </div>
        </div>

        @* ══ BỐN THẺ SỐ LIỆU ═══════════════════════════════════════════════ *@
        @* Con số quan trọng nhất đứng đầu và có sọc màu theo mức nghiêm trọng *@
        <div class="grid grid-stats">

            <div class="stat @RiskStatClass()">
                <span class="stat-label">Giá trị có nguy cơ bỏ</span>
                <span class="stat-value">@Money.Format(_plan.TotalValueAtRisk)</span>
                <span class="stat-meta">
                    trên @_plan.Risks.Count lô cận hạn
                </span>
            </div>

            <div class="stat @(_plan.CriticalCount > 0 ? "stat-critical" : "")">
                <span class="stat-label">Khẩn cấp</span>
                <span class="stat-value">@_plan.CriticalCount</span>
                <span class="stat-meta">hết hạn trong 1–2 ngày</span>
            </div>

            <div class="stat @(_plan.WarningCount > 0 ? "stat-warn" : "")">
                <span class="stat-label">Cần theo dõi</span>
                <span class="stat-value">@_plan.WarningCount</span>
                <span class="stat-meta">hết hạn trong 3–7 ngày</span>
            </div>

            <div class="stat">
                <span class="stat-label">Doanh thu hôm nay</span>
                <span class="stat-value">@Money.Format(_plan.Revenue)</span>
                <span class="stat-meta">@_plan.OrderCount đơn</span>
            </div>
        </div>

        @* ══ CẦN NHẬP HÀNG ═════════════════════════════════════════════════
             Đặt ngay dưới bốn thẻ số, trên phần AI diễn giải: đây là việc
             phải làm TRƯỚC khi mở cửa sáng mai, còn đọc diễn giải thì để sau.
             Gom sẵn mọi nguyên liệu hết / sắp hết / đã chặn đơn trong ngày —
             không phải mở trang kho rà từng dòng nữa. *@
        <RestockPanel BusinessDate="@_plan.BusinessDate" Mode="RestockPanel.RestockMode.Plan" />

        @* ══ DIỄN GIẢI CỦA AI ══════════════════════════════════════════════ *@
        @if (!string.IsNullOrEmpty(_plan.AiError))
        {
            <div class="alert alert-warn" role="status">
                <WarnIcon Size="20" />
                <div class="stack stack-1">
                    <span class="alert-title">Không tạo được phần diễn giải</span>
                    <span class="small">
                        Toàn bộ số liệu và đề xuất bên dưới vẫn chính xác vì do hệ thống
                        tính, không phụ thuộc AI. Chi tiết lỗi: @_plan.AiError
                    </span>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_plan.Headline) || !string.IsNullOrEmpty(_plan.Summary))
        {
            <section class="card ai-summary">
                <div class="row row-3">
                    <div class="ai-avatar"><SparkIcon Size="18" /></div>
                    <div class="stack stack-3 grow">
                        @if (!string.IsNullOrEmpty(_plan.Headline))
                        {
                            <h3 class="ai-headline">@_plan.Headline</h3>
                        }
                        @if (!string.IsNullOrEmpty(_plan.Summary))
                        {
                            <p class="text-2" style="max-width: 70ch;">@_plan.Summary</p>
                        }
                    </div>
                </div>
            </section>
        }

        @* ══ BIỂU ĐỒ RỦI RO THEO SỐ NGÀY CÒN LẠI ═══════════════════════════ *@
        @if (_plan.Risks.Count > 0)
        {
            <section class="card">
                <div class="card-header">
                    <div class="stack stack-1">
                        <h3 class="card-title">Rủi ro theo thời gian còn lại</h3>
                        <span class="xs muted">
                            Giá trị nguyên liệu dự kiến phải bỏ, nhóm theo số ngày tới hạn
                        </span>
                    </div>
                </div>

                <div class="risk-chart">
                    @foreach (var bucket in RiskBuckets())
                    {
                        var pct = _maxBucketValue > 0 ? bucket.Value * 100.0 / _maxBucketValue : 0;
                        <div class="risk-bar-row">
                            <span class="risk-bar-label">@bucket.Label</span>
                            <div class="risk-bar-track">
                                <div class="risk-bar-fill"
                                     style="width: @pct.ToString("0.#")%; background: @bucket.Color;"
                                     role="img"
                                     aria-label="@bucket.Label: @Money.Format(bucket.Value)"></div>
                            </div>
                            <span class="risk-bar-value num">@Money.Format(bucket.Value)</span>
                            <span class="risk-bar-count xs muted num">@bucket.Count lô</span>
                        </div>
                    }
                </div>
            </section>
        }

        @* ══ DANH SÁCH ĐỀ XUẤT ═════════════════════════════════════════════ *@
        <section class="stack stack-4">
            <div class="row row-between">
                <h3>Đề xuất hành động</h3>
                @if (_undecidedCount > 0)
                {
                    <span class="badge badge-danger">@_undecidedCount chưa xử lý</span>
                }
            </div>

            @if (_plan.Suggestions.Count == 0)
            {
                <div class="alert alert-ok">
                    <CheckIcon Size="20" />
                    <div class="stack stack-1">
                        <span class="alert-title">Hôm nay không có việc gì gấp</span>
                        <span class="small">
                            Không có nguyên liệu nào sắp hết hạn mà tốc độ bán hiện tại
                            không kịp tiêu thụ. Cứ bán bình thường.
                        </span>
                    </div>
                </div>
            }
            else
            {
                @foreach (var s in _plan.Suggestions)
                {
                    <SuggestionCard Suggestion="s"
                                    OnDecided="OnSuggestionDecided"
                                    @key="s.Id" />
                }
            }
        </section>

        @* ══ BẢNG CHI TIẾT TỪNG LÔ ═════════════════════════════════════════ *@
        @if (_plan.Risks.Count > 0)
        {
            <section class="stack stack-4">
                <div class="row row-between">
                    <h3>Chi tiết lô hàng cận hạn</h3>
                    <a href="/lo-hang" class="btn btn-ghost btn-sm">
                        Xem toàn bộ kho <ArrowIcon Size="14" />
                    </a>
                </div>

                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Nguyên liệu</th>
                                <th>Mã lô</th>
                                <th class="num">Còn lại</th>
                                <th class="num">Dùng TB/ngày</th>
                                <th class="num">Dự kiến dùng</th>
                                <th class="num">Nguy cơ bỏ</th>
                                <th class="num">Giá trị</th>
                                <th class="num">Hạn dùng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _plan.Risks)
                            {
                                <tr class="@SeverityRowClass(r.Severity)">
                                    <td>
                                        <div class="ingredient-cell">
                                            <div class="ingredient-icon"
                                                 style="--ing-color: @r.IngredientColorHex">
                                                <IngredientIcon IconKey="@r.IngredientIconKey"
                                                                ColorHex="@r.IngredientColorHex"
                                                                Size="20"
                                                                AriaLabel="@r.IngredientName" />
                                            </div>
                                            <div class="ingredient-meta">
                                                <span class="ingredient-name">@r.IngredientName</span>
                                                <span class="xs muted">@r.SeverityLabel</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="mono xs">@r.LotCode</td>
                                    <td class="num">@Fmt(r.RemainingQuantity) @r.UnitLabel</td>
                                    <td class="num">@Fmt(r.AvgDailyUsage) @r.UnitLabel</td>
                                    <td class="num muted">@Fmt(r.ProjectedUsage) @r.UnitLabel</td>
                                    <td class="num" style="font-weight: 700; color: var(--danger);">
                                        @Fmt(r.QuantityAtRisk) @r.UnitLabel
                                    </td>
                                    <td class="num" style="font-weight: 700;">
                                        @Money.Format(r.ValueAtRisk)
                                    </td>
                                    <td class="num">
                                        <div class="stack stack-1" style="align-items: flex-end;">
                                            <span>@r.ExpiryDate.ToString("dd/MM")</span>
                                            <span class="xs @DaysColorClass(r.DaysUntilExpiry)">
                                                còn @r.DaysUntilExpiry ngày
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter] public string? BusinessDate { get; set; }

    private DailyPlanDto? _plan;
    private bool _loading = true;
    private bool _generating;
    private int _maxBucketValue;

    private int _undecidedCount =>
        _plan?.Suggestions.Count(s => s.DecisionAction is null) ?? 0;

    /// <summary>Ngày đang xem, "yyyy-MM-dd". Không có trên đường dẫn = hôm nay.</summary>
    private string RequestedDate => BusinessDate ?? DateTime.Now.ToString("yyyy-MM-dd");

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var res = await Api.GetDailyPlanAsync(RequestedDate);
        _plan = res.Success ? res.Data : null;

        if (_plan is not null)
            _maxBucketValue = RiskBuckets().DefaultIfEmpty().Max(b => b?.Value ?? 0);

        _loading = false;
    }

    private async Task GenerateNowAsync()
    {
        _generating = true;
        var res = await Api.GenerateDailyPlanAsync();
        _generating = false;

        if (res.Success)
        {
            Alerts.Success("Đã tạo bản kế hoạch mới.");
            await LoadAsync();
        }
        else
        {
            Alerts.Error(res.Error?.Message ?? "Không tạo được kế hoạch.");
        }
    }

    private async Task OnSuggestionDecided() => await LoadAsync();

    private void NavigateToDate(string date) => Nav.NavigateTo($"/ke-hoach/{date}");

    // ── Nhóm rủi ro theo khoảng thời gian còn lại ────────────────────────────
    private record Bucket(string Label, int Value, int Count, string Color);

    private List<Bucket> RiskBuckets()
    {
        if (_plan is null) return new();

        var g = (Func<int, int, (int sum, int count)>)((lo, hi) =>
        {
            var items = _plan.Risks.Where(r => r.DaysUntilExpiry >= lo && r.DaysUntilExpiry <= hi);
            return (items.Sum(r => r.ValueAtRisk), items.Count());
        });

        var b1 = g(-99, 1);
        var b2 = g(2, 3);
        var b3 = g(4, 7);
        var b4 = g(8, 999);

        return new()
        {
            new("≤ 1 ngày",  b1.sum, b1.count, "var(--danger)"),
            new("2–3 ngày",  b2.sum, b2.count, "var(--warn)"),
            new("4–7 ngày",  b3.sum, b3.count, "hsl(45 80% 45%)"),
            new("8+ ngày",   b4.sum, b4.count, "var(--ok)")
        };
    }

    private string RiskStatClass() => _plan!.TotalValueAtRisk switch
    {
        > 500_000 => "stat-critical",
        > 100_000 => "stat-warn",
        _ => "stat-ok"
    };

    private static string SeverityRowClass(int severity) => severity switch
    {
        3 => "row-critical",
        2 => "row-warn",
        _ => ""
    };

    // Dùng toán tử ba ngôi thay vì switch có mẫu quan hệ.
    // Bộ phân tích Razor hiểu nhầm dấu "<" đứng đầu dòng là thẻ HTML mở.
    private static string DaysColorClass(int days)
        => days <= 1 ? "text-danger"
         : days <= 3 ? "text-warn"
         : "muted";

    /// <summary>Số lượng nguyên liệu: bỏ phần thập phân thừa cho dễ đọc.</summary>
    private static string Fmt(double v) =>
        v >= 100 ? v.ToString("N0") : v.ToString("0.##");

    private static string FormatDate(string businessDate) =>
        DateTime.TryParse(businessDate, out var d) ? d.ToString("dd/MM/yyyy") : businessDate;
}
