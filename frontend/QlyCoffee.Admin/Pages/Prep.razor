@*
    =============================================================================
    TRANG SƠ CHẾ — XUẤT KHO NGUYÊN LIỆU THÔ ĐỂ LÀM BÁN THÀNH PHẨM
    =============================================================================

    Archetype: bảng công việc. Đây KHÔNG phải màn hình tra cứu — nó là danh sách
    việc phải làm, nên mỗi thẻ kết thúc bằng đúng một nút bấm.

    ĐÂY LÀ BƯỚC ĐỨNG TRƯỚC BÁN HÀNG:

        Nhập kho  ──▶  SƠ CHẾ  ──▶  Bán hàng
        (mua lá      (ủ thành      (bán ly trà,
         trà về)      cốt trà)      trừ vào cốt)

    BA QUYẾT ĐỊNH THIẾT KẾ, ĐỀU XUẤT PHÁT TỪ NGƯỜI ĐỨNG QUẦY:

    1. THẺ NÀO CẦN LÀM THÌ NỔI LÊN ĐẦU.
       Sắp theo mức khẩn cấp chứ không theo bảng chữ cái. Người mở trang này
       đang cần biết "giờ phải ủ gì", không phải "có những công thức nào".

    2. ĐƠN VỊ HIỂN THỊ LÀ SỐ LY, KHÔNG PHẢI MILILIT.
       "Còn 380ml cốt hồng trà" không nói lên điều gì. "Còn khoảng 2 ly" thì
       nhân viên biết ngay là phải ủ ngay bây giờ.

    3. HẠN DÙNG ĐẾM BẰNG GIỜ VÀ PHÚT.
       Bình cốt trà hỏng sau 6 tiếng chứ không phải sau vài ngày. Hiện "còn 40
       phút" là thứ khiến người ta đứng dậy đi ủ; hiện "hết hạn hôm nay" thì không.
    =============================================================================
*@
@page "/so-che"
@layout AdminLayout
@attribute [Authorize(Roles = "Staff,Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts

<PageTitle>Sơ chế — Một Chút Coffee</PageTitle>

<div class="stack stack-6">

    @* ── HÀNG TIÊU ĐỀ ────────────────────────────────────────────────────── *@
    <div class="row row-between row-wrap" style="gap: var(--space-4);">
        <div class="stack stack-1">
            <h2>Sơ chế</h2>
            <span class="xs muted">
                Xuất nguyên liệu thô để ủ, nấu thành nguyên liệu pha chế —
                kho trừ lá trà ngay tại đây, ly bán ra thì trừ vào cốt
            </span>
        </div>

        <button class="btn btn-secondary btn-sm" @onclick="LoadAsync" disabled="@_loading">
            <RefreshIcon Size="14" /> Làm mới
        </button>
    </div>

    @if (_loading)
    {
        <div class="grid grid-2">
            @for (var i = 0; i < 4; i++)
            {
                <div class="skeleton" style="height: 320px; border-radius: var(--radius-lg);"></div>
            }
        </div>
    }
    else if (_recipes.Count == 0)
    {
        <div class="card">
            <div class="empty" style="padding: var(--space-8) var(--space-4);">
                <JarIcon Size="40" CssClass="empty-icon" />
                <span class="empty-text">
                    Chưa có công thức sơ chế nào. Bật <span class="mono">MENU_SYNC_ENABLED=true</span>
                    trong file .env rồi khởi động lại backend để nạp bộ công thức chuẩn.
                </span>
            </div>
        </div>
    }
    else
    {
        @* ── THẺ TỔNG QUAN ───────────────────────────────────────────────── *@
        <div class="grid grid-stats">
            <div class="stat @(NeedPrepCount > 0 ? "stat-critical" : "stat-ok")">
                <span class="stat-label">Cần ủ ngay</span>
                <span class="stat-value">@NeedPrepCount</span>
                <span class="stat-meta">đã hết hoặc còn dưới một ly</span>
            </div>
            <div class="stat @(ExpiringSoonCount > 0 ? "stat-warn" : "")">
                <span class="stat-label">Mẻ sắp hết hạn</span>
                <span class="stat-value">@ExpiringSoonCount</span>
                <span class="stat-meta">còn dưới 60 phút</span>
            </div>
            <div class="stat">
                <span class="stat-label">Bình đang dùng</span>
                <span class="stat-value">@ActiveBatchCount</span>
                <span class="stat-meta">trên @_recipes.Count công thức</span>
            </div>
            <div class="stat">
                <span class="stat-label">Giá trị đang giữ</span>
                <span class="stat-value">@Money.Format(ActiveBatchValue)</span>
                <span class="stat-meta">nguyên liệu đã nằm trong các bình</span>
            </div>
        </div>

        @* ── DANH SÁCH CÔNG THỨC ─────────────────────────────────────────── *@
        <div class="grid grid-2">
            @foreach (var r in Sorted)
            {
                <section class="card stack stack-4" @key="r.Id">

                    @* ── Đầu thẻ: tên bán thành phẩm + tình trạng ────────── *@
                    <div class="row row-3">
                        <div class="ingredient-icon" style="--ing-color: @r.OutputColorHex; width: 40px; height: 40px;">
                            <IngredientIcon IconKey="@r.OutputIconKey"
                                            ColorHex="@r.OutputColorHex"
                                            Size="24"
                                            AriaLabel="@r.OutputName" />
                        </div>
                        <div class="stack stack-1 grow">
                            <span style="font-weight: 700;">@r.Name</span>
                            <span class="xs muted">
                                @r.OutputName · một mẻ @Qty.Format(r.OutputQuantity) @r.UnitLabel ·
                                dùng được @FormatHours(r.ShelfLifeHours)
                            </span>
                        </div>
                        <span class="badge @StatusBadgeClass(r)">@StatusLabel(r)</span>
                    </div>

                    @* ── Còn lại bao nhiêu ───────────────────────────────── *@
                    @*  Thanh đo lấy mốc là MỘT MẺ ĐẦY, để "còn nửa bình" nhìn
                        ra được ngay bằng độ dài chứ không phải bằng cách đọc số. *@
                    <div class="stack stack-2">
                        <div class="row row-between">
                            <span class="label">Còn lại</span>
                            <span class="num" style="font-weight: 700;">
                                @Qty.Format(r.OutputStock) @r.UnitLabel
                                <span class="xs muted">
                                    (@(r.ServingsLeft > 0 ? $"≈ {r.ServingsLeft} ly" : "không đủ một ly"))
                                </span>
                            </span>
                        </div>
                        <div class="meter" role="img"
                             aria-label="Còn @Qty.Format(r.OutputStock) @r.UnitLabel, khoảng @r.ServingsLeft ly">
                            <div class="meter-fill"
                                 style="width: @StockPercent(r)%; --meter-color: @StockColor(r);"></div>
                        </div>
                    </div>

                    @* ── Các mẻ đang dùng ────────────────────────────────── *@
                    @if (r.ActiveBatches.Count > 0)
                    {
                        <div class="stack stack-2">
                            <span class="label">Bình đang dùng</span>
                            <div class="pl-table">
                                @foreach (var b in r.ActiveBatches)
                                {
                                    <div class="pl-row">
                                        <span class="pl-label">
                                            <span class="mono xs">@b.LotCode</span>
                                            @if (!string.IsNullOrEmpty(b.Note))
                                            {
                                                <span class="xs muted"> · @b.Note</span>
                                            }
                                        </span>
                                        <span class="pl-value num">
                                            @Qty.Format(b.RemainingQuantity) @r.UnitLabel
                                            <span class="xs @ExpiryClass(b.MinutesLeft)">
                                                · @FormatMinutesLeft(b.MinutesLeft)
                                            </span>
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warn">
                            <WarnIcon Size="18" />
                            <span class="xs">
                                Chưa có bình nào. Món dùng @r.OutputName đang hiện
                                &laquo;chưa sơ chế&raquo; và không bán được.
                            </span>
                        </div>
                    }

                    @* ── Nguyên liệu tốn cho một mẻ ──────────────────────── *@
                    <div class="stack stack-2">
                        <span class="label">Một mẻ tốn</span>
                        <div class="pl-table">
                            @foreach (var input in r.Inputs)
                            {
                                var need = input.QuantityPerBatch * BatchCountFor(r.Id);
                                var enough = input.StockAvailable >= need;
                                <div class="pl-row">
                                    <span class="pl-label">
                                        <span class="swatch" style="--swatch-color: @input.ColorHex"></span>
                                        @input.Name
                                    </span>
                                    <span class="pl-value num @(enough ? "" : "text-danger")">
                                        @Qty.Format(need) @input.UnitLabel
                                        <span class="xs muted">/ còn @Qty.Format(input.StockAvailable)</span>
                                    </span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(r.Instructions))
                        {
                            <details class="stack stack-1">
                                <summary class="xs muted" style="cursor: pointer;">
                                    Cách làm
                                </summary>
                                <p class="xs" style="margin-top: var(--space-2); line-height: 1.6;">
                                    @r.Instructions
                                </p>
                            </details>
                        }
                    </div>

                    @* ── Chọn số mẻ và chạy ──────────────────────────────── *@
                    <div class="card-footer stack stack-3">
                        <div class="row row-between row-wrap" style="gap: var(--space-2);">
                            <span class="label">Số mẻ</span>
                            <div class="choice-group">
                                @foreach (var option in BatchOptions)
                                {
                                    <button type="button"
                                            class="choice @(BatchCountFor(r.Id) == option ? "is-selected" : "")"
                                            aria-pressed="@(BatchCountFor(r.Id) == option)"
                                            @onclick="() => SetBatchCount(r.Id, option)">
                                        @option.ToString("0.##")
                                    </button>
                                }
                            </div>
                        </div>

                        <span class="xs muted">
                            Sẽ tạo @Qty.Format(r.OutputQuantity * BatchCountFor(r.Id)) @r.UnitLabel,
                            hết hạn lúc @DateTime.Now.AddHours(r.ShelfLifeHours).ToString("HH:mm dd/MM") ·
                            làm mất khoảng @r.PrepMinutes phút
                        </span>

                        <button class="btn btn-primary btn-block"
                                disabled="@(!CanProduce(r))"
                                @onclick="() => ProduceAsync(r)">
                            @if (_producingId == r.Id)
                            {
                                <SpinnerIcon Size="18" />
                                <span>Đang ghi sổ…</span>
                            }
                            else
                            {
                                <PlusIcon Size="16" />
                                <span>Làm @BatchCountFor(r.Id).ToString("0.##") mẻ</span>
                            }
                        </button>

                        @if (!CanProduce(r) && _producingId is null)
                        {
                            <span class="xs text-warn" style="text-align: center;">
                                @BlockReason(r)
                            </span>
                        }
                    </div>
                </section>
            }
        </div>

        <div class="alert alert-info">
            <InfoIcon Size="18" />
            <span class="xs">
                Mỗi mẻ trừ nguyên liệu thô theo nguyên tắc FEFO — lô cận hạn được dùng trước —
                và ghi hai bút toán vào sổ kho: một xuất nguyên liệu thô, một nhập bán thành phẩm.
                Giá vốn của bình lấy từ đúng những lô đã bị trừ, không lấy giá trung bình.
            </span>
        </div>
    }
</div>

@code {
    private List<PrepRecipeDto> _recipes = new();
    private readonly Dictionary<Guid, double> _batchCounts = new();
    private bool _loading = true;
    private Guid? _producingId;

    /// <summary>
    /// Nửa mẻ có mặt ở đây vì giờ vắng nhân viên hay ủ nửa bình. Không cho chọn
    /// thì họ vẫn ủ nửa bình ngoài đời rồi bấm "1 mẻ" — và sổ kho sai từ đó.
    /// </summary>
    private static readonly double[] BatchOptions = { 0.5, 1, 2, 3 };

    private double BatchCountFor(Guid recipeId) => _batchCounts.GetValueOrDefault(recipeId, 1);

    private void SetBatchCount(Guid recipeId, double count) => _batchCounts[recipeId] = count;

    // ---- Số liệu tổng quan ---------------------------------------------------

    private int NeedPrepCount => _recipes.Count(r => r.ServingsLeft < 1);

    private int ExpiringSoonCount => _recipes
        .SelectMany(r => r.ActiveBatches)
        .Count(b => b.MinutesLeft < 60);

    private int ActiveBatchCount => _recipes.Sum(r => r.ActiveBatches.Count);

    private int ActiveBatchValue => _recipes
        .SelectMany(r => r.ActiveBatches)
        .Sum(b => (int)Math.Round(b.RemainingQuantity * b.UnitCost));

    /// <summary>
    /// Sắp theo VIỆC CẦN LÀM: hết trước, sắp hết sau, còn nhiều xuống cuối.
    /// Trang này là danh sách việc, không phải danh mục tra cứu.
    /// </summary>
    private IEnumerable<PrepRecipeDto> Sorted => _recipes
        .OrderBy(r => r.ServingsLeft)
        .ThenBy(r => r.ActiveBatches.Count == 0 ? 0 : r.ActiveBatches.Min(b => b.MinutesLeft))
        .ThenBy(r => r.Name);

    // ---- Trạng thái từng công thức -------------------------------------------

    private static bool IsOutOfStock(PrepRecipeDto r) => r.ServingsLeft < 1;

    private static bool IsRunningLow(PrepRecipeDto r) => r.ServingsLeft is >= 1 and <= 3;

    private static string StatusLabel(PrepRecipeDto r) =>
          IsOutOfStock(r)  ? "Cần ủ ngay"
        : IsRunningLow(r)  ? "Sắp hết"
        :                    "Còn đủ";

    private static string StatusBadgeClass(PrepRecipeDto r) =>
          IsOutOfStock(r)  ? "badge-danger"
        : IsRunningLow(r)  ? "badge-warn"
        :                    "badge-ok";

    /// <summary>
    /// Tỉ lệ so với MỘT MẺ ĐẦY, chặn ở 100%. Lấy mốc là một mẻ chứ không phải
    /// tổng đã từng ủ, để thanh đo trả lời đúng câu "còn được mấy phần bình".
    /// </summary>
    private static int StockPercent(PrepRecipeDto r) => r.OutputQuantity > 0
        ? (int)Math.Min(100, Math.Round(r.OutputStock * 100 / r.OutputQuantity))
        : 0;

    private static string StockColor(PrepRecipeDto r) =>
          IsOutOfStock(r)  ? "var(--danger)"
        : IsRunningLow(r)  ? "var(--warn)"
        :                    "var(--ok)";

    // ---- Điều kiện chạy mẻ ---------------------------------------------------

    private bool CanProduce(PrepRecipeDto r) =>
        _producingId is null && r.MaxBatches >= BatchCountFor(r.Id);

    private string BlockReason(PrepRecipeDto r)
    {
        var want = BatchCountFor(r.Id);

        if (r.MaxBatches <= 0)
            return string.IsNullOrEmpty(r.BlockingIngredient)
                ? "Không đủ nguyên liệu thô để ủ."
                : $"Hết {r.BlockingIngredient} — phải nhập kho trước.";

        return $"Chỉ còn nguyên liệu cho {r.MaxBatches:0.##} mẻ, không đủ {want:0.##} mẻ.";
    }

    // ---- Hiển thị thời gian --------------------------------------------------

    private static string FormatHours(int hours) =>
          hours >= 24 && hours % 24 == 0 ? $"{hours / 24} ngày"
        : hours >= 24                    ? $"{hours / 24} ngày {hours % 24} tiếng"
        :                                  $"{hours} tiếng";

    /// <summary>
    /// Đếm ngược bằng giờ và phút. Với bình cốt trà thì "còn 40 phút" là câu duy
    /// nhất có nghĩa — "hết hạn hôm nay" không khiến ai đứng dậy đi ủ mẻ mới.
    /// </summary>
    private static string FormatMinutesLeft(int minutes)
    {
        if (minutes == int.MaxValue) return "không có hạn";
        if (minutes < 0) return $"quá hạn {FormatDuration(-minutes)}";
        return $"còn {FormatDuration(minutes)}";
    }

    private static string FormatDuration(int minutes)
    {
        if (minutes < 60) return $"{minutes} phút";

        var hours = minutes / 60;
        if (hours < 24) return minutes % 60 == 0 ? $"{hours} tiếng" : $"{hours}t{minutes % 60:00}";

        return $"{hours / 24} ngày";
    }

    private static string ExpiryClass(int minutes) =>
          minutes < 0   ? "text-danger"
        : minutes < 60  ? "text-warn"
        :                 "muted";

    // ---- Nạp dữ liệu và chạy mẻ ----------------------------------------------

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        var res = await Api.GetPrepRecipesAsync();
        _recipes = res.Success && res.Data is not null ? res.Data : new();

        if (!res.Success)
            Alerts.Error(res.Error?.Message ?? "Không tải được danh sách công thức sơ chế.");

        _loading = false;
    }

    private async Task ProduceAsync(PrepRecipeDto r)
    {
        if (!CanProduce(r)) return;

        _producingId = r.Id;

        var res = await Api.ProduceBatchAsync(new ProduceBatchRequest
        {
            PrepRecipeId = r.Id,
            BatchCount   = BatchCountFor(r.Id)
        });

        _producingId = null;

        if (res.Success && res.Data is { } batch)
        {
            // Báo lại ĐÚNG những gì vừa xảy ra với kho: ra bao nhiêu, hết hạn lúc
            // nào, và tốn hết bao nhiêu tiền nguyên liệu. Nhân viên cần đối chiếu
            // ngay với cái bình vừa rót, chứ không phải mở sổ kho ra tra.
            Alerts.Success(
                $"Đã ủ {Qty.Format(batch.OutputQuantity)} {batch.UnitLabel} {batch.OutputName} "
              + $"(lô {batch.LotCode}), hết hạn lúc {batch.ExpiresAt.ToLocalTime():HH:mm dd/MM}. "
              + $"Kho đã trừ {Money.Format(batch.TotalInputCost)} nguyên liệu.");

            await LoadAsync();
        }
        else
        {
            Alerts.Error(res.Error?.Message ?? "Không chạy được mẻ sơ chế.");
        }
    }
}
