@*
    =============================================================================
    BẢNG CÔNG & LƯƠNG — /cham-cong  (Manager, Owner)
    =============================================================================
    Tổng hợp theo nhân viên để trả lương: số ca, số lần trễ, tổng phút trễ,
    về sớm, giờ công, tiền công — và két: giữ bao nhiêu ca, hụt bao nhiêu.
    Bên dưới là nhật ký từng lần chấm công để tra lại khi có thắc mắc.

    Ca quên chấm ra được tạm tính tới giờ kết thúc ca và gắn cờ đỏ: quản lý
    xác nhận với nhân viên trước khi trả lương, không để hệ thống tự quyết.
    =============================================================================
*@
@page "/cham-cong"
@attribute [Authorize(Roles = "Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts

<PageTitle>Bảng công &amp; lương — Một Chút Coffee</PageTitle>

<LiveRefresh Seconds="60" OnRefresh="() => LoadAsync(silent: true)" />

<div class="stack stack-6">

    <div class="row row-between row-wrap" style="gap: var(--space-4); align-items: flex-end;">
        <div class="stack stack-1">
            <h2>Bảng công &amp; lương</h2>
            <span class="xs muted">Đi trễ, giờ công, tiền công và hụt két của từng nhân viên — giờ Việt Nam</span>
        </div>
        <div class="row row-3 row-wrap" style="align-items: flex-end;">
            <div class="field">
                <label class="field-label" for="from">Từ ngày</label>
                <input id="from" type="date" class="input" @bind="_from" />
            </div>
            <div class="field">
                <label class="field-label" for="to">Đến ngày</label>
                <input id="to" type="date" class="input" @bind="_to" />
            </div>
            <button class="btn btn-secondary" @onclick="() => LoadAsync()">Xem</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="skeleton" style="height: 360px; border-radius: var(--radius-lg);"></div>
    }
    else if (_data is { } d)
    {
        <div class="grid grid-stats">
            <div class="stat">
                <span class="stat-label">Tổng tiền công</span>
                <span class="stat-value num">@Money.Format(d.TotalPay)</span>
                <span class="stat-meta">@d.Employees.Count nhân viên · @d.Rows.Count ca</span>
            </div>
            <div class="stat">
                <span class="stat-label">Tổng giờ công</span>
                <span class="stat-value num">@Hours(d.TotalWorkedMinutes)</span>
            </div>
            <div class="stat @(d.TotalLateMinutes > 0 ? "stat-warn" : "stat-ok")">
                <span class="stat-label">Tổng đi trễ</span>
                <span class="stat-value num">@Duration(d.TotalLateMinutes)</span>
                <span class="stat-meta">@d.Rows.Count(r => r.LateMinutes > 0) lần trễ</span>
            </div>
            <div class="stat @(d.TotalDrawerShortage < 0 ? "stat-critical" : "stat-ok")">
                <span class="stat-label">Hụt két</span>
                <span class="stat-value num">@(d.TotalDrawerShortage == 0 ? "Không" : Money.Format(-d.TotalDrawerShortage))</span>
                <span class="stat-meta">Chi tiết từng ca ở mục Đối soát ca</span>
            </div>
        </div>

        @if (d.Rows.Any(r => r.MissingCheckout))
        {
            <div class="alert alert-warn">
                <span>
                    <strong>@d.Rows.Count(r => r.MissingCheckout) ca quên chấm công ra</strong> — đang tạm tính tới giờ kết thúc ca.
                    Xác nhận với nhân viên trước khi trả lương.
                </span>
            </div>
        }

        @* ══ TỔNG HỢP THEO NHÂN VIÊN ════════════════════════════════════════ *@
        <section class="stack stack-3">
            <h3>Theo nhân viên</h3>
            @if (d.Employees.Count == 0)
            {
                <div class="empty">
                    <ClockIcon Size="40" CssClass="empty-icon" />
                    <span class="empty-title">Chưa có ai chấm công trong khoảng ngày này</span>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Nhân viên</th>
                                <th class="num">Số ca</th>
                                <th class="num">Lần trễ</th>
                                <th class="num">Tổng trễ</th>
                                <th class="num">Về sớm</th>
                                <th class="num">Giờ công</th>
                                <th class="num">Lương giờ</th>
                                <th class="num">Tiền công</th>
                                <th class="num">Giữ két</th>
                                <th class="num">Hụt / dư két</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in d.Employees)
                            {
                                <tr @key="e.EmployeeId">
                                    <td>
                                        <strong>@e.FullName</strong> <span class="xs muted num">@e.Code</span>
                                        @if (e.MissingCheckouts > 0) { <div><span class="badge badge-danger">@e.MissingCheckouts ca quên chấm ra</span></div> }
                                    </td>
                                    <td class="num">@e.Shifts</td>
                                    <td class="num"><span class="@(e.LateCount > 0 ? "diff-pos" : "")">@e.LateCount</span></td>
                                    <td class="num"><span class="@(e.LateMinutes > 0 ? "diff-pos" : "")">@(e.LateMinutes == 0 ? "—" : Duration(e.LateMinutes))</span></td>
                                    <td class="num">@(e.EarlyLeaveMinutes == 0 ? "—" : Duration(e.EarlyLeaveMinutes))</td>
                                    <td class="num">@Hours(e.WorkedMinutes)</td>
                                    <td class="num">@Money.Format(e.HourlyWage)</td>
                                    <td class="num"><strong>@Money.Format(e.Pay)</strong></td>
                                    <td class="num">@(e.DrawerShifts == 0 ? "—" : $"{e.DrawerShifts} ca")</td>
                                    <td class="num">
                                        @if (e.DrawerShortage < 0) { <span class="diff-neg">@Money.FormatSigned(e.DrawerShortage)</span> }
                                        @if (e.DrawerSurplus > 0) { <span class="diff-pos"> @Money.FormatSigned(e.DrawerSurplus)</span> }
                                        @if (e.DrawerShortage == 0 && e.DrawerSurplus == 0) { <span class="@(e.DrawerShifts > 0 ? "diff-ok" : "")">@(e.DrawerShifts > 0 ? "Khớp" : "—")</span> }
                                        @if (e.ReceiveShortage < 0) { <div class="xs diff-neg">nhận két âm @Money.Format(-e.ReceiveShortage)</div> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @* ══ NHẬT KÝ CHẤM CÔNG ═════════════════════════════════════════════ *@
        @if (d.Rows.Count > 0)
        {
            <section class="stack stack-3">
                <h3>Nhật ký chấm công</h3>
                <div class="table-wrap">
                    <table class="table table-compact">
                        <thead>
                            <tr>
                                <th>Ngày</th>
                                <th>Nhân viên</th>
                                <th>Ca</th>
                                <th>Vào</th>
                                <th>Ra</th>
                                <th class="num">Trễ</th>
                                <th class="num">Về sớm</th>
                                <th class="num">Giờ công</th>
                                <th class="num">Tiền công</th>
                                <th class="num">Két</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in d.Rows)
                            {
                                <tr @key="r.Id" class="@(r.MissingCheckout ? "shift-row-bad" : "")">
                                    <td class="num">@DateOnly.Parse(r.WorkDate).ToString("dd/MM")</td>
                                    <td>@r.EmployeeName</td>
                                    <td>@r.SlotName <span class="xs muted num">@Vn(r.SlotStartAt).ToString("HH:mm")–@Vn(r.SlotEndAt).ToString("HH:mm")</span></td>
                                    <td class="num">@Vn(r.CheckInAt).ToString("HH:mm")</td>
                                    <td class="num">
                                        @if (r.CheckOutAt is DateTime o) { @Vn(o).ToString("HH:mm") }
                                        else if (r.IsOpen) { <span class="badge badge-ok">Đang làm</span> }
                                        else { <span class="badge badge-danger">Quên chấm ra</span> }
                                    </td>
                                    <td class="num"><span class="@(r.LateMinutes > 0 ? "diff-pos" : "diff-ok")">@(r.LateMinutes == 0 ? "Đúng giờ" : Duration(r.LateMinutes))</span></td>
                                    <td class="num">@(r.EarlyLeaveMinutes == 0 ? "—" : Duration(r.EarlyLeaveMinutes))</td>
                                    <td class="num">@Hours(r.WorkedMinutes)</td>
                                    <td class="num">@Money.Format(r.Pay)</td>
                                    <td class="num">
                                        @if (!r.HeldDrawer) { <span>—</span> }
                                        else if (r.DrawerDifference is int diff) { <span class="@(diff < 0 ? "diff-neg" : diff > 0 ? "diff-pos" : "diff-ok")">@(diff == 0 ? "Giao khớp" : $"Giao {Money.FormatSigned(diff)}")</span> }
                                        else { <span class="badge badge-accent">Đang giữ</span> }
                                        @if (r.ReceiveDifference is int rd && rd != 0)
                                        {
                                            <div class="xs @(rd < 0 ? "diff-neg" : "diff-pos")">@(rd < 0 ? "Nhận âm" : "Nhận dư") @Money.Format(Math.Abs(rd))</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    private TimesheetDto? _data;
    private bool _loading = true;
    private DateOnly _from;
    private DateOnly _to;

    protected override async Task OnInitializedAsync()
    {
        _to = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
        _from = new DateOnly(_to.Year, _to.Month, 1);
        await LoadAsync();
    }

    private async Task LoadAsync(bool silent = false)
    {
        if (!silent) { _loading = true; StateHasChanged(); }
        var res = await Api.GetTimesheetAsync(_from.ToString("yyyy-MM-dd"), _to.ToString("yyyy-MM-dd"));
        if (res.Success && res.Data is not null) _data = res.Data;
        else if (!silent) Alerts.Error(res.Error?.Message ?? "Không tải được bảng công.");
        _loading = false;
    }

    private static string Duration(int minutes)
        => minutes >= 60 ? $"{minutes / 60}g {minutes % 60}p" : $"{minutes} phút";

    private static string Hours(int minutes) => $"{minutes / 60}g {minutes % 60:00}p";

    private static DateTime Vn(DateTime utc) => utc.AddHours(7);
}
