@*
    =============================================================================
    TRANG LÔ HÀNG & HẠN DÙNG
    =============================================================================

    Archetype: bảng dữ liệu dày. Mật độ cao là TÍNH NĂNG ở đây — người quản lý
    cần quét nhanh hàng chục lô để biết cái nào sắp hỏng.

    Ba cách mã hóa mức khẩn cấp CÙNG LÚC (không bao giờ chỉ dùng màu):
      1. Sọc màu bên trái hàng   → nhận ra bằng ngoại vi mắt
      2. Thanh đo số ngày còn lại → nhận ra bằng độ dài
      3. Chữ "còn N ngày"         → đọc được bởi trình đọc màn hình

    Sắp xếp mặc định là FEFO — lô hết hạn sớm nhất lên đầu, đúng thứ tự mà
    hệ thống sẽ lấy ra dùng.
    =============================================================================
*@
@page "/lo-hang"
@layout AdminLayout
@attribute [Authorize(Roles = "Staff,Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts

<PageTitle>Lô hàng &amp; hạn dùng — Một Chút Coffee</PageTitle>

<div class="stack stack-6">

    @* ── HÀNG TIÊU ĐỀ ────────────────────────────────────────────────────── *@
    <div class="row row-between row-wrap" style="gap: var(--space-4);">
        <div class="stack stack-1">
            <h2>Lô hàng &amp; hạn dùng</h2>
            <span class="xs muted">
                Sắp theo nguyên tắc FEFO — lô hết hạn sớm nhất được dùng trước
            </span>
        </div>

        <div class="row row-2">
            <a href="/nhap-kho" class="btn btn-primary btn-sm">
                <PlusIcon Size="14" /> Nhập kho
            </a>
            <button class="btn btn-secondary btn-sm" @onclick="LoadAsync">
                <RefreshIcon Size="14" /> Làm mới
            </button>
        </div>
    </div>

    @* ── THẺ TỔNG QUAN ───────────────────────────────────────────────────── *@
    <div class="grid grid-stats">
        <div class="stat @(_criticalCount > 0 ? "stat-critical" : "stat-ok")">
            <span class="stat-label">Hết hạn ≤ 2 ngày</span>
            <span class="stat-value">@_criticalCount</span>
            <span class="stat-meta">@Money.Format(_criticalValue) đang gặp rủi ro</span>
        </div>
        <div class="stat @(_warningCount > 0 ? "stat-warn" : "")">
            <span class="stat-label">Hết hạn 3–7 ngày</span>
            <span class="stat-value">@_warningCount</span>
            <span class="stat-meta">@Money.Format(_warningValue)</span>
        </div>
        <div class="stat">
            <span class="stat-label">Tổng giá trị tồn</span>
            <span class="stat-value">@Money.Format(_totalValue)</span>
            <span class="stat-meta">@_allLots.Count lô đang hoạt động</span>
        </div>
        <div class="stat @(_expiredCount > 0 ? "stat-critical" : "")">
            <span class="stat-label">Đã quá hạn</span>
            <span class="stat-value">@_expiredCount</span>
            <span class="stat-meta">cần tiêu hủy và ghi hao hụt</span>
        </div>
    </div>

    @* ── THANH LỌC ───────────────────────────────────────────────────────── *@
    <div class="filter-bar" role="group" aria-label="Lọc lô hàng">
        @foreach (var f in Filters)
        {
            <button class="chip @(_activeFilter == f.Key ? "is-active" : "")"
                    @onclick="() => SetFilter(f.Key)"
                    aria-pressed="@(_activeFilter == f.Key)">
                @if (f.Color is not null)
                {
                    <span class="swatch" style="--swatch-color: @f.Color"></span>
                }
                @f.Label
                <span class="xs muted num">@CountFor(f.Key)</span>
            </button>
        }

        <div class="grow"></div>

        <div class="search-box">
            <SearchIcon Size="15" />
            <input type="search" class="input search-input"
                   placeholder="Tìm nguyên liệu hoặc mã lô…"
                   @bind="_search" @bind:event="oninput"
                   aria-label="Tìm kiếm lô hàng" />
        </div>
    </div>

    @* ── BẢNG ────────────────────────────────────────────────────────────── *@
    @if (_loading)
    {
        <div class="table-wrap">
            <div class="stack stack-3" style="padding: var(--space-4);">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="skeleton skeleton-text" style="height: 40px;"></div>
                }
            </div>
        </div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="empty">
            <ClockIcon Size="52" CssClass="empty-icon" />
            <span class="empty-title">
                @(_allLots.Count == 0 ? "Kho đang trống" : "Không có lô nào khớp bộ lọc")
            </span>
            <span class="empty-text">
                @(_allLots.Count == 0
                    ? "Nhập lô hàng đầu tiên để hệ thống bắt đầu theo dõi hạn dùng và tự trừ kho theo công thức."
                    : "Thử đổi bộ lọc hoặc xóa từ khóa tìm kiếm.")
            </span>
            @if (_allLots.Count == 0)
            {
                <a href="/nhap-kho" class="btn btn-primary">
                    <PlusIcon Size="16" /> Nhập kho
                </a>
            }
        </div>
    }
    else
    {
        <p class="sr-only" aria-live="polite">Hiển thị @_filtered.Count lô hàng.</p>

        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nguyên liệu</th>
                        <th>Mã lô</th>
                        <th class="num">Còn lại</th>
                        <th style="width: 160px;">Thời gian còn lại</th>
                        <th class="num">Hạn dùng</th>
                        <th class="num">Giá vốn</th>
                        <th class="num">Giá trị còn</th>
                        <th style="width: 1%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lot in _filtered)
                    {
                        <tr class="@SeverityRowClass(lot)" @key="lot.Id">

                            @* Cột nguyên liệu: icon SVG tô đúng màu thật + tên + mã SKU *@
                            <td>
                                <div class="ingredient-cell">
                                    <div class="ingredient-icon" style="--ing-color: @lot.IngredientColorHex">
                                        <IngredientIcon IconKey="@lot.IngredientIconKey"
                                                        ColorHex="@lot.IngredientColorHex"
                                                        Size="20"
                                                        AriaLabel="@lot.IngredientName" />
                                    </div>
                                    <div class="ingredient-meta">
                                        <span class="ingredient-name">@lot.IngredientName</span>
                                        @if (!string.IsNullOrEmpty(lot.SupplierName))
                                        {
                                            <span class="xs muted">@lot.SupplierName</span>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td class="mono xs">@lot.LotCode</td>

                            @* Còn lại kèm tỉ lệ đã dùng — thấy ngay lô nào sắp cạn *@
                            <td class="num">
                                <div class="stack stack-1" style="align-items: flex-end;">
                                    <span style="font-weight: 600;">
                                        @Fmt(lot.RemainingQuantity) @lot.UnitLabel
                                    </span>
                                    <span class="xs muted">
                                        / @Fmt(lot.ReceivedQuantity)
                                    </span>
                                </div>
                            </td>

                            @* Thanh đo thời gian — mã hóa mức khẩn cấp bằng ĐỘ DÀI, không chỉ màu *@
                            <td>
                                @if (lot.DaysUntilExpiry is int days)
                                {
                                    <div class="stack stack-1">
                                        <div class="meter" role="img"
                                             aria-label="Còn @days ngày tới hạn">
                                            <div class="meter-fill"
                                                 style="width: @(DaysPercent(days))%;
                                                        --meter-color: @SeverityColor(lot.Severity);"></div>
                                        </div>
                                        <span class="xs @DaysTextClass(days)">
                                            @(days < 0 ? $"quá hạn {Math.Abs(days)} ngày" : $"còn {days} ngày")
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span class="xs muted">Không có hạn</span>
                                }
                            </td>

                            <td class="num">
                                @(lot.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")
                            </td>

                            <td class="num muted">@Money.Format(lot.UnitCost)</td>

                            <td class="num" style="font-weight: 600;">
                                @Money.Format(lot.RemainingValue)
                            </td>

                            <td>
                                <div class="row row-1">
                                    @* Lô quá hạn: nút tiêu hủy. Lô cận hạn: nút xem món dùng nó *@
                                    @if (lot.DaysUntilExpiry is int d2 && d2 < 0)
                                    {
                                        <button class="btn btn-ghost btn-sm"
                                                @onclick="() => DisposeAsync(lot)"
                                                title="Tiêu hủy và ghi hao hụt">
                                            <TrashIcon Size="14" />
                                        </button>
                                    }
                                    @* Trỏ về DANH SÁCH nguyên liệu, không kèm mã.
                                       Bản trước là "/admin/nguyen-lieu/@lot.IngredientId",
                                       nhưng trang Nguyên liệu chỉ khai báo đúng một route
                                       không tham số, nên đường dẫn đó luôn rơi vào trang
                                       "không tìm thấy" — lỗi có sẵn từ trước khi tách dự án.
                                       Muốn giữ đúng ý định ban đầu thì phải làm thêm màn
                                       hình chi tiết một nguyên liệu, hoặc cho trang danh
                                       sách nhận tham số rồi tự cuộn tới đúng dòng. *@
                                    <a href="/nguyen-lieu"
                                       class="btn btn-ghost btn-sm"
                                       title="Xem danh sách nguyên liệu">
                                        <ArrowIcon Size="14" />
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<InventoryLotDto> _allLots = new();
    private List<InventoryLotDto> _filtered = new();
    private bool _loading = true;
    private string _activeFilter = "all";
    private string _search = "";

    // Số liệu tổng hợp
    private int _criticalCount, _warningCount, _expiredCount;
    private int _criticalValue, _warningValue, _totalValue;

    private record FilterDef(string Key, string Label, string? Color);

    private static readonly FilterDef[] Filters =
    {
        new("all",      "Tất cả",            null),
        new("critical", "Khẩn cấp ≤2 ngày",  "var(--danger)"),
        new("warning",  "Cảnh báo 3–7 ngày", "var(--warn)"),
        new("expired",  "Đã quá hạn",        "var(--danger)"),
        new("ok",       "Còn hạn dài",       "var(--ok)")
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var res = await Api.GetInventoryLotsAsync();
        _allLots = res.Success && res.Data is not null
            ? res.Data.OrderBy(l => l.ExpiryDate ?? DateTime.MaxValue).ToList()
            : new();

        ComputeSummary();
        ApplyFilter();
        _loading = false;
    }

    private void ComputeSummary()
    {
        _totalValue = _allLots.Sum(l => l.RemainingValue);

        var critical = _allLots.Where(l => l.DaysUntilExpiry >= 0 && l.DaysUntilExpiry <= 2).ToList();
        _criticalCount = critical.Count;
        _criticalValue = critical.Sum(l => l.RemainingValue);

        var warning = _allLots.Where(l => l.DaysUntilExpiry >= 3 && l.DaysUntilExpiry <= 7).ToList();
        _warningCount = warning.Count;
        _warningValue = warning.Sum(l => l.RemainingValue);

        _expiredCount = _allLots.Count(l => l.DaysUntilExpiry < 0);
    }

    private void SetFilter(string key)
    {
        _activeFilter = key;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<InventoryLotDto> q = _allLots;

        q = _activeFilter switch
        {
            "critical" => q.Where(l => l.DaysUntilExpiry >= 0 && l.DaysUntilExpiry <= 2),
            "warning"  => q.Where(l => l.DaysUntilExpiry >= 3 && l.DaysUntilExpiry <= 7),
            "expired"  => q.Where(l => l.DaysUntilExpiry < 0),
            "ok"       => q.Where(l => (l.DaysUntilExpiry == null || l.DaysUntilExpiry > 7)),
            _          => q
        };

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            q = q.Where(l =>
                l.IngredientName.ToLowerInvariant().Contains(s) ||
                l.LotCode.ToLowerInvariant().Contains(s));
        }

        _filtered = q.ToList();
    }

    // Blazor gọi lại mỗi lần gõ vào ô tìm kiếm
    protected override void OnAfterRender(bool firstRender) { }

    private int CountFor(string key) => key switch
    {
        "critical" => _criticalCount,
        "warning"  => _warningCount,
        "expired"  => _expiredCount,
        "ok"       => _allLots.Count(l => (l.DaysUntilExpiry == null || l.DaysUntilExpiry > 7)),
        _          => _allLots.Count
    };

    private async Task DisposeAsync(InventoryLotDto lot)
    {
        var res = await Api.DisposeLotAsync(lot.Id);
        if (res.Success)
        {
            Alerts.Success($"Đã tiêu hủy lô {lot.LotCode} và ghi bút toán hao hụt.");
            await LoadAsync();
        }
        else
        {
            Alerts.Error(res.Error?.Message ?? "Không tiêu hủy được lô hàng.");
        }
    }

    // ── Trình bày ───────────────────────────────────────────────────────────

    private static string SeverityRowClass(InventoryLotDto lot) => lot.Severity switch
    {
        3 => "row-critical",
        2 => "row-warn",
        _ => ""
    };

    private static string SeverityColor(int severity) => severity switch
    {
        3 => "var(--danger)",
        2 => "var(--warn)",
        1 => "hsl(45 80% 45%)",
        _ => "var(--ok)"
    };

    /// <summary>
    /// Độ dài thanh đo. Quy ước ngược: còn ÍT ngày thì thanh NGẮN, để mắt
    /// hiểu ngay "thanh gần cạn = sắp hết thời gian".
    /// Mốc chuẩn hóa là 14 ngày.
    /// </summary>
    private static int DaysPercent(int days) =>
        days <= 0 ? 3 : Math.Min(100, (int)(days / 14.0 * 100));

    // Dùng toán tử ba ngôi thay vì switch có mẫu quan hệ.
    // Bộ phân tích Razor hiểu nhầm dấu "<" đứng đầu dòng là thẻ HTML mở.
    private static string DaysTextClass(int days)
        => days <= 2 ? "text-danger"
         : days <= 7 ? "text-warn"
         : "muted";

    private static string Fmt(double v) => v >= 100 ? v.ToString("N0") : v.ToString("0.##");
}
