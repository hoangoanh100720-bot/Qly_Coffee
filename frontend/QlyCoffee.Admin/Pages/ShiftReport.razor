@*
    =============================================================================
    ĐỐI SOÁT CA — Doanh thu theo ca, tiền nộp, hụt/dư két
    =============================================================================
    Chỉ quản lý và chủ quán. Trả lời ba câu hỏi cuối ngày/cuối tuần:

      1. Mỗi ca bán được bao nhiêu (tiền mặt + chuyển khoản)?
      2. Tiền mặt có về đủ không — ai nộp bao nhiêu, ca nào hụt két?
      3. Có khoản thu nào rơi ra NGOÀI CA không — tức bán hàng khi chưa ai nhận
         két, số tiền không người chịu trách nhiệm.

    Doanh thu ở đây là TIỀN THỰC THU theo thời điểm thu tiền, khác với trang
    Báo cáo (doanh thu theo đơn, giá vốn, lãi gộp). Hai trang bổ sung nhau:
    Báo cáo nói quán làm ăn ra sao, trang này nói tiền có về đủ két không.
    =============================================================================
*@
@page "/doi-soat-ca"
@attribute [Authorize(Roles = "Manager,Owner")]
@inject ApiClient Api
@inject AlertService Alerts

<PageTitle>Đối soát ca — Một Chút Coffee</PageTitle>

<LiveRefresh Seconds="60" OnRefresh="() => LoadAsync(silent: true)" />

<div class="stack stack-6">

    <div class="row row-between row-wrap" style="gap: var(--space-4); align-items: flex-end;">
        <div class="stack stack-1">
            <h2>Đối soát két theo ca</h2>
            <span class="xs muted">Tiền thực thu mỗi ca, tiền nộp về và chênh lệch két — giờ Việt Nam</span>
        </div>

        <div class="row row-3 row-wrap" style="align-items: flex-end;">
            <div class="field">
                <label class="field-label" for="from">Từ ngày</label>
                <input id="from" type="date" class="input" @bind="_from" />
            </div>
            <div class="field">
                <label class="field-label" for="to">Đến ngày</label>
                <input id="to" type="date" class="input" @bind="_to" />
            </div>
            <button class="btn btn-secondary" @onclick="() => LoadAsync()">Xem</button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="skeleton" style="height: 360px; border-radius: var(--radius-lg);"></div>
    }
    else if (_report is null)
    {
        <div class="empty">
            <WarnIcon Size="40" CssClass="empty-icon" />
            <span class="empty-title">Chưa tải được báo cáo</span>
        </div>
    }
    else
    {
        var r = _report;

        <div class="grid grid-stats">
            <div class="stat">
                <span class="stat-label">Doanh thu trong ca</span>
                <span class="stat-value num">@Money.Format(r.TotalCashSales + r.TotalTransferSales)</span>
                <span class="stat-meta">Tiền mặt @Money.Format(r.TotalCashSales) · CK @Money.Format(r.TotalTransferSales)</span>
            </div>
            <div class="stat">
                <span class="stat-label">Tiền mặt đã nộp</span>
                <span class="stat-value num">@Money.Format(r.TotalDeposited)</span>
                <span class="stat-meta">@r.Shifts.Count ca</span>
            </div>
            <div class="stat @(r.TotalDifference < 0 ? "stat-critical" : r.TotalDifference > 0 ? "stat-warn" : "stat-ok")">
                <span class="stat-label">Chênh lệch két</span>
                <span class="stat-value num">@(r.TotalDifference == 0 ? "Khớp" : Money.FormatSigned(r.TotalDifference))</span>
                <span class="stat-meta">@(r.ShiftsWithDifference == 0 ? "Không ca nào lệch" : $"{r.ShiftsWithDifference} ca lệch")</span>
            </div>
            <div class="stat @(r.OutsideShiftOrders > 0 ? "stat-warn" : "stat-ok")">
                <span class="stat-label">Thu ngoài ca</span>
                <span class="stat-value num">@Money.Format(r.OutsideShiftCash + r.OutsideShiftTransfer)</span>
                <span class="stat-meta">@(r.OutsideShiftOrders == 0 ? "Không có" : $"{r.OutsideShiftOrders} đơn — bán khi chưa ai nhận ca")</span>
            </div>
        </div>

        @* ══ ĐÓNG KÉT HỘ ═══════════════════════════════════════════════════
             Nhân viên về mà quên chấm công ra thì két "kẹt" ở tên người đó —
             không ai khác giao két được. Quản lý đếm két và đóng hộ ở đây; ca
             được ghi là quản lý đóng, nên đối soát vẫn biết ai chịu trách nhiệm. *@
        @if (r.Shifts.FirstOrDefault(s => s.Status == 0) is { } openShift)
        {
            <section class="card">
                <div class="row row-between row-wrap" style="gap: var(--space-3);">
                    <span>
                        Két đang do <strong>@openShift.OpenedByName</strong> giữ từ @Vn(openShift.OpenedAt).ToString("HH:mm dd/MM") —
                        lẽ ra có <strong class="num">@Money.Format(openShift.ExpectedCash)</strong>.
                    </span>
                    <button class="btn btn-secondary btn-sm" @onclick="() => _closing = !_closing">
                        @(_closing ? "Huỷ" : "Đóng két hộ")
                    </button>
                </div>
                @if (_closing)
                {
                    <div class="row row-3 row-wrap" style="margin-top: var(--space-4); align-items: flex-end;">
                        <div class="field">
                            <label class="field-label" for="mc">Thực đếm</label>
                            <input id="mc" type="number" class="input input-num" step="1000" @bind="_mCounted" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="mh">Để lại két</label>
                            <input id="mh" type="number" class="input input-num" step="1000" @bind="_mHandover" />
                        </div>
                        <div class="field" style="flex: 1; min-width: 220px;">
                            <label class="field-label" for="mn">Ghi chú</label>
                            <input id="mn" class="input" @bind="_mNote" placeholder="VD: nhân viên về quên giao két" />
                        </div>
                        <button class="btn btn-primary" @onclick="ForceCloseAsync" disabled="@(_mCounted is null)">Xác nhận đóng két</button>
                    </div>
                }
            </section>
        }

        @if (r.OutsideShiftCash > 0)
        {
            <div class="alert alert-warn">
                <span>
                    <strong>@Money.Format(r.OutsideShiftCash)</strong> tiền mặt được thu lúc không có ai đứng ca —
                    số tiền này không nằm trong đối soát của ca nào. Nhắc nhân viên nhận ca trước khi bán.
                </span>
            </div>
        }

        @if (r.Shifts.Count == 0)
        {
            <div class="empty">
                <ClockIcon Size="40" CssClass="empty-icon" />
                <span class="empty-title">Chưa có ca nào trong khoảng ngày này</span>
                <span class="empty-text">Nhân viên nhận ca ở mục "Ca làm việc" trước khi bán hàng.</span>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-compact">
                    <thead>
                        <tr>
                            <th>Ca</th>
                            <th>Người đứng ca</th>
                            <th>Giao cho</th>
                            <th class="num">Két đầu ca</th>
                            <th class="num">Tiền mặt thu</th>
                            <th class="num">Chuyển khoản</th>
                            <th class="num">Lẽ ra có</th>
                            <th class="num">Thực đếm</th>
                            <th class="num">Chênh lệch</th>
                            <th class="num">Nộp</th>
                            <th class="num">Để lại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in r.Shifts)
                        {
                            var bad = (s.CashDifference ?? 0) != 0
                                      || (s.ExpectedOpeningCash is int e && e != s.OpeningCash);
                            <tr class="@(bad ? "shift-row-bad" : "")" @key="s.Id">
                                <td>
                                    <div class="stack" style="gap: 0;">
                                        <span>@Vn(s.OpenedAt).ToString("dd/MM HH:mm") – @(s.ClosedAt is DateTime c ? Vn(c).ToString("HH:mm") : "…")</span>
                                        @if (s.Status == 0)
                                        {
                                            <span class="badge badge-ok" style="align-self: flex-start;">Đang mở</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @s.OpenedByName
                                    @if (!string.IsNullOrEmpty(s.ReceivedFromName))
                                    {
                                        <div class="xs muted">nhận từ @s.ReceivedFromName</div>
                                    }
                                </td>
                                <td>@(s.HandedOverToName ?? (s.Status == 1 ? "Đóng cửa" : "—"))</td>
                                <td class="num">
                                    @Money.Format(s.OpeningCash)
                                    @if (s.ExpectedOpeningCash is int exp && exp != s.OpeningCash)
                                    {
                                        <div class="xs diff-neg" title="Ca trước giao @Money.Format(exp)">lệch @Money.FormatSigned(s.OpeningCash - exp)</div>
                                    }
                                </td>
                                <td class="num">@Money.Format(s.CashSales)</td>
                                <td class="num">@Money.Format(s.TransferSales)</td>
                                <td class="num">@Money.Format(s.ExpectedCash)</td>
                                <td class="num">@(s.CountedCash is int cc ? Money.Format(cc) : "—")</td>
                                <td class="num">
                                    @if (s.CashDifference is int d)
                                    {
                                        <span class="@(d < 0 ? "diff-neg" : d > 0 ? "diff-pos" : "diff-ok")">@(d == 0 ? "Khớp" : Money.FormatSigned(d))</span>
                                    }
                                    else { <span>—</span> }
                                </td>
                                <td class="num">@(s.DepositedCash is int dep ? Money.Format(dep) : "—")</td>
                                <td class="num">@(s.HandoverCash is int ho ? Money.Format(ho) : "—")</td>
                            </tr>
                            @if (!string.IsNullOrEmpty(s.OpeningNote) || !string.IsNullOrEmpty(s.ClosingNote))
                            {
                                <tr class="@(bad ? "shift-row-bad" : "")">
                                    <td colspan="11" class="xs muted">
                                        @if (!string.IsNullOrEmpty(s.OpeningNote)) { <span>Nhận ca: “@s.OpeningNote”</span> }
                                        @if (!string.IsNullOrEmpty(s.OpeningNote) && !string.IsNullOrEmpty(s.ClosingNote)) { <span> · </span> }
                                        @if (!string.IsNullOrEmpty(s.ClosingNote)) { <span>Giao ca: “@s.ClosingNote”</span> }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private ShiftReportDto? _report;
    private bool _loading = true;
    private DateOnly _from;
    private DateOnly _to;

    protected override async Task OnInitializedAsync()
    {
        _to = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
        _from = _to.AddDays(-6);
        await LoadAsync();
    }

    private async Task LoadAsync(bool silent = false)
    {
        if (!silent) { _loading = true; StateHasChanged(); }

        var res = await Api.GetShiftReportAsync(_from.ToString("yyyy-MM-dd"), _to.ToString("yyyy-MM-dd"));
        if (res.Success && res.Data is not null) _report = res.Data;
        else if (!silent) Alerts.Error(res.Error?.Message ?? "Không tải được báo cáo đối soát.");

        _loading = false;
    }

    private bool _closing;
    private int? _mCounted;
    private int? _mHandover;
    private string? _mNote;

    private async Task ForceCloseAsync()
    {
        if (_mCounted is not int counted) return;
        var res = await Api.CloseShiftAsync(new CloseShiftRequest
        {
            CountedCash = counted, HandoverCash = _mHandover ?? 0, Note = _mNote,
        });
        if (!res.Success) { Alerts.Error(res.Error?.Message ?? "Không đóng két được."); return; }
        Alerts.Success("Đã đóng két.");
        _closing = false; _mCounted = null; _mHandover = null; _mNote = null;
        await LoadAsync();
    }

    private static DateTime Vn(DateTime utc) => utc.AddHours(7);
}
