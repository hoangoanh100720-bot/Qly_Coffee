# .NET
bin/
obj/
*.user
*.suo
.vs/

# Biến môi trường — KHÔNG BAO GIỜ commit khóa API và mật khẩu
.env.local
.env.production
.env.*.local

# Ghi chú: file .env gốc ĐƯỢC commit vì chỉ chứa giá trị mẫu cho môi trường dev.
# Trước khi lên production phải thay JWT_SECRET, ANTHROPIC_API_KEY, DB_PASSWORD.

# Cấu hình frontend sinh tự động từ .env (cả hai ứng dụng)
frontend/QlyCoffee.Client/wwwroot/appsettings.json
frontend/QlyCoffee.Admin/wwwroot/appsettings.json

# Gói deploy do scripts/build-deploy.ps1 dựng ra.
# Ngoài chuyện nặng và tái tạo được bất cứ lúc nào, deploy/api/.env còn chứa
# mật khẩu database, JWT_SECRET và khóa API thật — commit nhầm một lần là phải
# đổi toàn bộ khóa, vì lịch sử git thì không xóa sạch được.
deploy/

# Ảnh người dùng tải lên
backend/QlyCoffee.Api/wwwroot/uploads/

# Nhật ký
logs/
*.log

# Chua mat khau that - khong bao gio commit
.env

# Ảnh món tải lên. Chạy lại scripts/ là có, không cần đưa vào lịch sử git.
backend/QlyCoffee.Api/wwwroot/uploads/

# File sao lưu do scripts/chay-lan.ps1 sinh ra khi sửa launchSettings
*.bak
